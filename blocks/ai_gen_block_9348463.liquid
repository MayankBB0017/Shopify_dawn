{% doc %}
  @prompt
    On the product page, display bundle products from the metafield `custom.product_custom_bundle` in a grid layout that matches the existing theme's grid design. Fetch the product references stored in this metafield and render them in a grid (using the theme's existing grid/product card styles). Do NOT show individual "Add to Cart" buttons for any of the bundle products — only show product image, title, and price for each bundle item. The grid should only appear if the metafield has products assigned to it.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}
{% assign bundle_products = product.metafields.custom.product_custom_bundle.value %}

{% if bundle_products != blank and bundle_products.size > 0 %}
  {% style %}
    .ai-bundle-grid-{{ ai_gen_id }} {
      display: block;
      width: 100%;
      padding: {{ block.settings.section_padding }}px 0;
    }

    .ai-bundle-grid__heading-{{ ai_gen_id }} {
      margin: 0 0 {{ block.settings.heading_spacing }}px;
      font-size: {{ block.settings.heading_size }}px;
      color: {{ block.settings.heading_color }};
      text-align: {{ block.settings.heading_alignment }};
    }

    .ai-bundle-grid__container-{{ ai_gen_id }} {
      display: grid;
      grid-template-columns: repeat({{ block.settings.columns_desktop }}, 1fr);
      gap: {{ settings.spacing_grid_vertical }}px {{ settings.spacing_grid_horizontal }}px;
      width: 100%;
    }

    .ai-bundle-grid__item-{{ ai_gen_id }} {
      position: relative;
      display: flex;
      flex-direction: column;
      {% if settings.card_style == 'card' %}
        background-color: rgba(var(--color-foreground), 0.04);
        border-radius: {{ settings.card_corner_radius }}px;
        {% if settings.card_border_thickness > 0 %}
          border: {{ settings.card_border_thickness }}px solid rgba(var(--color-foreground), {{ settings.card_border_opacity | divided_by: 100.0 }});
        {% endif %}
        {% if settings.card_shadow_opacity > 0 %}
          box-shadow: {{ settings.card_shadow_horizontal_offset }}px {{ settings.card_shadow_vertical_offset }}px {{ settings.card_shadow_blur }}px rgba(var(--color-foreground), {{ settings.card_shadow_opacity | divided_by: 100.0 }});
        {% endif %}
      {% endif %}
    }

    .ai-bundle-grid__image-wrapper-{{ ai_gen_id }} {
      position: relative;
      width: 100%;
      overflow: hidden;
      {% if settings.card_style == 'card' %}
        padding: {{ settings.card_image_padding }}px;
      {% endif %}
    }

    .ai-bundle-grid__image-{{ ai_gen_id }} {
      display: block;
      width: 100%;
      height: auto;
      object-fit: cover;
      border-radius: {{ settings.media_radius }}px;
      {% if settings.media_border_thickness > 0 %}
        border: {{ settings.media_border_thickness }}px solid rgba(var(--color-foreground), {{ settings.media_border_opacity | divided_by: 100.0 }});
      {% endif %}
      {% if settings.media_shadow_opacity > 0 %}
        box-shadow: {{ settings.media_shadow_horizontal_offset }}px {{ settings.media_shadow_vertical_offset }}px {{ settings.media_shadow_blur }}px rgba(var(--color-foreground), {{ settings.media_shadow_opacity | divided_by: 100.0 }});
      {% endif %}
    }

    .ai-bundle-grid__info-{{ ai_gen_id }} {
      padding: 12px;
      text-align: {{ settings.card_text_alignment }};
      flex-grow: 1;
      display: flex;
      flex-direction: column;
      gap: 8px;
    }

    .ai-bundle-grid__title-{{ ai_gen_id }} {
      margin: 0;
      font-size: 14px;
      font-weight: 500;
      color: rgb(var(--color-foreground));
      line-height: 1.3;
    }

    .ai-bundle-grid__price-{{ ai_gen_id }} {
      font-size: 14px;
      color: rgb(var(--color-foreground));
    }

    .ai-bundle-grid__price-regular-{{ ai_gen_id }} {
      {% if block.settings.show_compare_price %}
        text-decoration: line-through;
        opacity: 0.7;
        margin-right: 8px;
      {% endif %}
    }

    .ai-bundle-grid__price-sale-{{ ai_gen_id }} {
      color: {{ block.settings.sale_price_color }};
      font-weight: 600;
    }

    @media screen and (max-width: 749px) {
      .ai-bundle-grid__container-{{ ai_gen_id }} {
        grid-template-columns: repeat({{ block.settings.columns_mobile }}, 1fr);
      }

      .ai-bundle-grid__heading-{{ ai_gen_id }} {
        font-size: calc({{ block.settings.heading_size }}px * 0.85);
      }
    }
  {% endstyle %}

  <product-bundle-{{ ai_gen_id }} class="ai-bundle-grid-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
    {% if block.settings.heading != blank %}
      <h2 class="ai-bundle-grid__heading-{{ ai_gen_id }}">{{ block.settings.heading }}</h2>
    {% endif %}

    <div class="ai-bundle-grid__container-{{ ai_gen_id }}">
      {% for bundle_product in bundle_products %}
        <div class="ai-bundle-grid__item-{{ ai_gen_id }}">
          <div class="ai-bundle-grid__image-wrapper-{{ ai_gen_id }}">
            {% if bundle_product.featured_image %}
              <img
                src="{{ bundle_product.featured_image | image_url: width: 600 }}"
                alt="{{ bundle_product.featured_image.alt | escape }}"
                loading="lazy"
                width="{{ bundle_product.featured_image.width }}"
                height="{{ bundle_product.featured_image.height }}"
                class="ai-bundle-grid__image-{{ ai_gen_id }}"
              >
            {% else %}
              <div class="ai-bundle-grid__image-placeholder-{{ ai_gen_id }}">
                {{ 'product-1' | placeholder_svg_tag }}
              </div>
            {% endif %}
          </div>

          <div class="ai-bundle-grid__info-{{ ai_gen_id }}">
            <h3 class="ai-bundle-grid__title-{{ ai_gen_id }}">
              {{ bundle_product.title }}
            </h3>

            <div class="ai-bundle-grid__price-{{ ai_gen_id }}">
              {% if bundle_product.compare_at_price > bundle_product.price and block.settings.show_compare_price %}
                <span class="ai-bundle-grid__price-regular-{{ ai_gen_id }}">
                  {{ bundle_product.compare_at_price | money }}
                </span>
                <span class="ai-bundle-grid__price-sale-{{ ai_gen_id }}">
                  {{ bundle_product.price | money }}
                </span>
              {% else %}
                <span>{{ bundle_product.price | money }}</span>
              {% endif %}
            </div>
          </div>
        </div>
      {% endfor %}
    </div>
  </product-bundle-{{ ai_gen_id }}>

  <script>
    (function() {
      class ProductBundle{{ ai_gen_id }} extends HTMLElement {
        constructor() {
          super();
        }

        connectedCallback() {
          this.init();
        }

        init() {
          const items = this.querySelectorAll('.ai-bundle-grid__item-{{ ai_gen_id }}');
          
          items.forEach((item) => {
            item.addEventListener('mouseenter', function() {
              this.style.transform = 'translateY(-2px)';
              this.style.transition = 'transform 0.2s ease';
            });

            item.addEventListener('mouseleave', function() {
              this.style.transform = 'translateY(0)';
            });
          });
        }
      }

      customElements.define('product-bundle-{{ ai_gen_id }}', ProductBundle{{ ai_gen_id }});
    })();
  </script>
{% endif %}

{% schema %}
{
  "name": "Product bundle grid",
  "tag": null,
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "default": "Bundle includes"
    },
    {
      "type": "range",
      "id": "heading_size",
      "min": 16,
      "max": 48,
      "step": 2,
      "unit": "px",
      "label": "Heading size",
      "default": 24
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color",
      "default": "#121212"
    },
    {
      "type": "select",
      "id": "heading_alignment",
      "label": "Heading alignment",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "left"
    },
    {
      "type": "range",
      "id": "heading_spacing",
      "min": 8,
      "max": 48,
      "step": 4,
      "unit": "px",
      "label": "Heading spacing",
      "default": 24
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 2,
      "max": 5,
      "step": 1,
      "label": "Columns on desktop",
      "default": 4
    },
    {
      "type": "select",
      "id": "columns_mobile",
      "label": "Columns on mobile",
      "options": [
        {
          "value": "1",
          "label": "1"
        },
        {
          "value": "2",
          "label": "2"
        }
      ],
      "default": "2"
    },
    {
      "type": "range",
      "id": "section_padding",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "label": "Section padding",
      "default": 36
    },
    {
      "type": "header",
      "content": "Product display"
    },
    {
      "type": "checkbox",
      "id": "show_compare_price",
      "label": "Show compare at price",
      "default": true
    },
    {
      "type": "color",
      "id": "sale_price_color",
      "label": "Sale price color",
      "default": "#d82c0d"
    }
  ],
  "presets": [
    {
      "name": "Product bundle grid"
    }
  ]
}
{% endschema %}