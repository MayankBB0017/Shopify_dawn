{% doc %}
  @prompt
    content section start with left align with title description and 2 button link
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-content-section-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    padding: {{ block.settings.padding_top }}px {{ block.settings.padding_horizontal }}px {{ block.settings.padding_bottom }}px;
    background-color: {{ block.settings.background_color }};
  }

  .ai-content-section__container-{{ ai_gen_id }} {
    max-width: {{ block.settings.content_width }}px;
    margin: 0;
    width: 100%;
  }

  .ai-content-section__title-{{ ai_gen_id }} {
    margin: 0 0 {{ block.settings.title_spacing }}px;
    color: {{ block.settings.title_color }};
    font-size: {{ block.settings.title_size }}px;
    font-weight: 600;
    line-height: 1.2;
    text-align: left;
  }

  .ai-content-section__description-{{ ai_gen_id }} {
    margin: 0 0 {{ block.settings.description_spacing }}px;
    color: {{ block.settings.description_color }};
    font-size: {{ block.settings.description_size }}px;
    line-height: 1.6;
    text-align: left;
  }

  .ai-content-section__buttons-{{ ai_gen_id }} {
    display: flex;
    flex-wrap: wrap;
    gap: {{ block.settings.button_gap }}px;
    align-items: center;
  }

  .ai-content-section__button-{{ ai_gen_id }} {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: {{ block.settings.button_padding_vertical }}px {{ block.settings.button_padding_horizontal }}px;
    font-size: {{ block.settings.button_font_size }}px;
    text-decoration: none;
    border-radius: {{ block.settings.button_border_radius }}px;
    transition: all 0.3s ease;
    border: {{ block.settings.button_border_width }}px solid;
  }

  .ai-content-section__button--primary-{{ ai_gen_id }} {
    background-color: {{ block.settings.button_primary_bg }};
    color: {{ block.settings.button_primary_color }};
    border-color: {{ block.settings.button_primary_border }};
  }

  .ai-content-section__button--primary-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.button_primary_hover_bg }};
    color: {{ block.settings.button_primary_hover_color }};
    border-color: {{ block.settings.button_primary_hover_border }};
  }

  .ai-content-section__button--secondary-{{ ai_gen_id }} {
    background-color: {{ block.settings.button_secondary_bg }};
    color: {{ block.settings.button_secondary_color }};
    border-color: {{ block.settings.button_secondary_border }};
  }

  .ai-content-section__button--secondary-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.button_secondary_hover_bg }};
    color: {{ block.settings.button_secondary_hover_color }};
    border-color: {{ block.settings.button_secondary_hover_border }};
  }

  @media screen and (max-width: 749px) {
    .ai-content-section-{{ ai_gen_id }} {
      padding: {{ block.settings.padding_top | times: 0.7 }}px {{ block.settings.padding_horizontal | times: 0.7 }}px {{ block.settings.padding_bottom | times: 0.7 }}px;
    }

    .ai-content-section__title-{{ ai_gen_id }} {
      font-size: {{ block.settings.title_size | times: 0.8 }}px;
    }

    .ai-content-section__description-{{ ai_gen_id }} {
      font-size: {{ block.settings.description_size | times: 0.9 }}px;
    }

    .ai-content-section__buttons-{{ ai_gen_id }} {
      {% if block.settings.stack_buttons_mobile %}
        flex-direction: column;
        align-items: flex-start;
      {% endif %}
    }

    .ai-content-section__button-{{ ai_gen_id }} {
      {% if block.settings.stack_buttons_mobile %}
        width: 100%;
      {% endif %}
    }
  }
{% endstyle %}

<div class="ai-content-section-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-content-section__container-{{ ai_gen_id }}">
    {% if block.settings.title != blank %}
      <h2 class="ai-content-section__title-{{ ai_gen_id }}">
        {{ block.settings.title }}
      </h2>
    {% endif %}

    {% if block.settings.description != blank %}
      <div class="ai-content-section__description-{{ ai_gen_id }}">
        {{ block.settings.description }}
      </div>
    {% endif %}

    <div class="ai-content-section__buttons-{{ ai_gen_id }}">
      {% if block.settings.button_primary_label != blank %}
        <a
          href="{{ block.settings.button_primary_link }}"
          class="ai-content-section__button-{{ ai_gen_id }} ai-content-section__button--primary-{{ ai_gen_id }}"
        >
          {{ block.settings.button_primary_label }}
        </a>
      {% endif %}

      {% if block.settings.button_secondary_label != blank %}
        <a
          href="{{ block.settings.button_secondary_link }}"
          class="ai-content-section__button-{{ ai_gen_id }} ai-content-section__button--secondary-{{ ai_gen_id }}"
        >
          {{ block.settings.button_secondary_label }}
        </a>
      {% endif %}
    </div>
  </div>
</div>

