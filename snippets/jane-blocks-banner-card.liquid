{%- liquid
  assign layout_variant = layout_variant | default: 'strip'
  assign card_size = card_size | default: 'large'
  assign block_index = block_index | default: 1

  assign title = block.settings.title
  assign description = block.settings.description
  assign link = block.settings.link
  assign enable_overlay = block.settings.enable_overlay
  assign enable_gradient = block.settings.enable_gradient
  assign overlay_opacity = block.settings.overlay_opacity | default: 10
  assign overlay_opacity_decimal = overlay_opacity | divided_by: 100.0

  assign enable_hover = true
  if section.settings.enable_hover_effect == false
    assign enable_hover = false
  endif

  assign button_label = block.settings.button_label
  if button_label == blank
    assign button_label = 'sections.jane_blocks_banner.default_button_label' | t
  endif

  assign image_desktop = block.settings.image
  assign image_mobile = block.settings.image_mobile
  if image_mobile == blank
    assign image_mobile = image_desktop
  endif

  if layout_variant == 'strip'
    assign image_width_desktop = 960
    assign image_width_mobile = 574
  elsif card_size == 'small'
    assign image_width_desktop = 700
    assign image_width_mobile = 340
  else
    assign image_width_desktop = 1400
    assign image_width_mobile = 340
  endif

  assign loading_attr = 'lazy'
  if block_index <= 2
    assign loading_attr = 'eager'
  endif

  assign title_position_desktop = block.settings.title_position_desktop
  if title_position_desktop == 'auto'
    if layout_variant == 'strip'
      assign title_position_desktop = 'top-left'
    else
      assign title_position_desktop = 'bottom-left'
    endif
  endif

  assign title_position_mobile = block.settings.title_position_mobile
  if title_position_mobile == 'auto'
    if layout_variant == 'strip'
      assign title_position_mobile = 'top-left'
    else
      assign title_position_mobile = 'bottom-center'
    endif
  endif

  assign content_position_desktop = block.settings.content_position_desktop
  if content_position_desktop == 'auto'
    assign content_position_desktop = title_position_desktop
  endif

  assign title_style = block.settings.title_style | default: 'h3'
  assign text_alignment_desktop = block.settings.text_alignment_desktop | default: 'left'
  assign text_alignment_mobile = block.settings.text_alignment_mobile | default: 'left'

  assign button_type = block.settings.button_type | default: 'link_white'
  assign link_size = block.settings.link_size | default: '14'
  assign button_class = ''
  assign button_custom_style = ''

  case button_type
    when 'filled_white'
      assign button_class = 'button button--filled-white'
    when 'filled_black'
      assign button_class = 'button button--filled-black'
    when 'stroke_white'
      assign button_class = 'button button--stroke-white'
    when 'stroke_black'
      assign button_class = 'button button--stroke-black'
    when 'link_white'
      assign button_class = 'link-button--' | append: link_size | append: ' jane-hero__link jane-hero__link--white'
    when 'link_black'
      assign button_class = 'link-button--' | append: link_size | append: ' jane-hero__link jane-hero__link--black'
    when 'customize'
      assign button_class = 'button jane-hero__button--custom'
      assign button_custom_style = '--hero-btn-bg:' | append: block.settings.button_bg_color | append: ';--hero-btn-border:' | append: block.settings.button_border_color | append: ';--hero-btn-text:' | append: block.settings.button_text_color | append: ';'
  endcase

  assign show_button = false
  if enable_hover and title != blank and link != blank and button_label != blank and button_type != 'none'
    assign show_button = true
  endif

  assign aria_action = 'sections.jane_blocks_banner.view_category' | t

  if title != blank
    assign aria_label = title | append: ' — ' | append: aria_action
  else
    assign aria_label = aria_action
  endif

  assign stagger_index = block_index | minus: 1

  assign title_position_classes = 'jane-blocks-banner__content--desktop-' | append: title_position_desktop | append: ' jane-blocks-banner__content--mobile-' | append: title_position_mobile | append: ' jane-blocks-banner__text--align-desktop-' | append: text_alignment_desktop | append: ' jane-blocks-banner__text--align-mobile-' | append: text_alignment_mobile

  assign content_position_classes = 'jane-blocks-banner__content--desktop-' | append: content_position_desktop | append: ' jane-blocks-banner__text--align-desktop-' | append: text_alignment_desktop

  assign title_class = 'jane-blocks-banner__title jane-blocks-banner__title--inverse'
  if title_style == 'typology'
    assign title_class = title_class | append: ' jane-blocks-banner__title--typology'
  else
    assign title_class = title_class | append: ' ' | append: title_style
  endif

  assign item_classes = 'jane-blocks-banner__item'
  if show_mobile_slider
    assign item_classes = item_classes | append: ' grid__item slider__slide'
  endif
  if layout_variant == 'grid'
    assign item_classes = item_classes | append: ' jane-blocks-banner__item--' | append: card_size
  endif

  assign animate_content = false
  if section.settings.enable_fade_in_desktop or section.settings.enable_fade_in_mobile
    assign animate_content = true
  endif
-%}

<li
  id="JaneBlocksBanner-{{ section.id }}-{{ block_index }}"
  class="{{ item_classes }}"
  style="--jbb-stagger-index: {{ stagger_index }};"
  {{ block.shopify_attributes }}
>
  <a
    {% if link == blank %}
      role="link" aria-disabled="true"
    {% else %}
      href="{{ link }}"
    {% endif %}
    class="jane-blocks-banner__card"
    aria-label="{{ aria_label | escape }}"
  >
    <div class="jane-blocks-banner__media">
      {%- if image_desktop != blank or image_mobile != blank -%}
        {%- if image_mobile != blank -%}
          {{
            image_mobile
            | image_url: width: image_width_mobile
            | image_tag:
              class: 'jane-blocks-banner__image jane-blocks-banner__image--mobile',
              loading: loading_attr,
              widths: '170, 287, 340, 574',
              sizes: '(max-width: 749px) 287px, 50vw',
              alt: title
          }}
        {%- endif -%}
        {%- if image_desktop != blank -%}
          {{
            image_desktop
            | image_url: width: image_width_desktop
            | image_tag:
              class: 'jane-blocks-banner__image jane-blocks-banner__image--desktop',
              loading: loading_attr,
              widths: '480, 700, 960, 1400',
              sizes: '(min-width: 750px) 50vw, 100vw',
              alt: title
          }}
        {%- elsif image_mobile != blank -%}
          {{
            image_mobile
            | image_url: width: image_width_desktop
            | image_tag:
              class: 'jane-blocks-banner__image jane-blocks-banner__image--desktop',
              loading: loading_attr,
              widths: '480, 700, 960, 1400',
              sizes: '(min-width: 750px) 50vw, 100vw',
              alt: title
          }}
        {%- endif -%}
      {%- else -%}
        <div class="jane-blocks-banner__placeholder">
          {{ 'hero-apparel-1' | placeholder_svg_tag: 'placeholder-svg' }}
        </div>
      {%- endif -%}
    </div>

    {%- if enable_overlay and overlay_opacity > 0 -%}
      <span
        class="jane-blocks-banner__overlay"
        style="--jbb-overlay-opacity: {{ overlay_opacity_decimal }};"
        aria-hidden="true"
      ></span>
    {%- endif -%}

    {%- if enable_gradient -%}
      {%- if layout_variant == 'strip' -%}
        <span class="jane-blocks-banner__gradient jane-blocks-banner__gradient--strip-desktop" aria-hidden="true"></span>
        <span class="jane-blocks-banner__gradient jane-blocks-banner__gradient--strip-mobile" aria-hidden="true"></span>
      {%- else -%}
        <span class="jane-blocks-banner__gradient jane-blocks-banner__gradient--typology" aria-hidden="true"></span>
      {%- endif -%}
    {%- endif -%}

    {%- if enable_hover -%}
      <span class="jane-blocks-banner__hover-blur" aria-hidden="true"></span>
    {%- endif -%}

    {%- if title != blank -%}
      <div
        class="jane-blocks-banner__content jane-blocks-banner__content--static {{ title_position_classes }}{% if animate_content %} jane-blocks-banner__content--animate{% endif %}"
        aria-hidden="true"
      >
        <span class="jane-blocks-banner__title-static {{ title_class }}">
          {{ title | escape }}
        </span>
      </div>
    {%- endif -%}

    {%- if enable_hover -%}
      <div
        class="jane-blocks-banner__content jane-blocks-banner__content--interactive {{ content_position_classes }}{% if animate_content %} jane-blocks-banner__content--animate{% endif %}"
      >
        <div class="jane-blocks-banner__content-inner">
          {%- if title != blank or description != blank -%}
            <div class="jane-blocks-banner__text-group">
              {%- if title != blank -%}
                <span class="{{ title_class }}">
                  {{ title | escape }}
                </span>
              {%- endif -%}
              {%- if description != blank -%}
                <div class="jane-blocks-banner__description rte">
                  {{ description }}
                </div>
              {%- endif -%}
            </div>
          {%- endif -%}

          {%- if show_button -%}
            <span
              class="jane-blocks-banner__cta {{ button_class }}"
              {% if button_custom_style != blank %}
                style="{{ button_custom_style }}"
              {% endif %}
              aria-hidden="true"
            >
              {%- if button_type == 'link_white' or button_type == 'link_black' -%}
                {{ button_label | escape }}
              {%- else -%}
                <span class="button-label">{{ button_label | escape }}</span>
              {%- endif -%}
            </span>
          {%- endif -%}
        </div>
      </div>
    {%- endif -%}
  </a>
</li>
