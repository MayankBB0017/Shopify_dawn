
{%- liquid
  assign direction = direction | default: 'down'
  assign size = size | default: 16
  assign stroke_width = stroke_width | default: 2
-%}

<svg
  xmlns="http://www.w3.org/2000/svg"
  width="{{ size }}"
  height="{{ size }}"
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="{{ stroke_width }}"
  stroke-linecap="round"
  stroke-linejoin="round"
  class="icon icon-caret icon-caret--{{ direction }}"
  aria-hidden="true"
>
  {%- case direction -%}
    {%- when 'up' -%}
      <path d="m18 15-6-6-6 6"/>
    {%- when 'down' -%}
      <path d="m6 9 6 6 6-6"/>
    {%- when 'left' -%}
      <path d="m15 18-6-6 6-6"/>
    {%- when 'right' -%}
      <path d="m9 18 6-6-6-6"/>
  {%- endcase -%}
</svg>
