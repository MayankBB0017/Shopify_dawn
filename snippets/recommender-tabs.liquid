{%- comment -%}
  Tab buttons for gift recommender section.
  Accepts:
  - section: {Object} section object
  - tab_blocks: {Array} recommendation blocks in order
{%- endcomment -%}

{%- liquid
  assign tablist_label = 'sections.recommender.tablist_label' | t
  if section.settings.accessibility_label != blank
    assign tablist_label = section.settings.accessibility_label | escape
  endif
-%}

<div
  class="gift-recommender__tabs"
  role="tablist"
  aria-label="{{ tablist_label }}"
>
  {%- for block in tab_blocks -%}
    {%- liquid
      assign tab_index = forloop.index
      assign is_active = false
      if forloop.first
        assign is_active = true
      endif

      assign tab_classes = 'gift-recommender__tab button caption-large'
      if is_active
        assign tab_classes = tab_classes | append: ' button--filled-black gift-recommender__tab--active'
      else
        assign tab_classes = tab_classes | append: ' button--stroke-black'
      endif
    -%}
    <button
      type="button"
      role="tab"
      id="GiftRecommenderTab-{{ section.id }}-{{ tab_index }}"
      class="{{ tab_classes }}{% if enable_fade %} gift-recommender__animate{% endif %}"
      {% if enable_fade %}
        style="--gr-stagger-index: {{ tab_index }};"
      {% endif %}
      aria-selected="{% if is_active %}true{% else %}false{% endif %}"
      aria-controls="GiftRecommenderPanel-{{ section.id }}-{{ tab_index }}"
      tabindex="{% if is_active %}0{% else %}-1{% endif %}"
      data-tab-index="{{ tab_index | minus: 1 }}"
    >
      <span class="button-label">{{ block.settings.tab_label | escape }}</span>
    </button>
  {%- endfor -%}
</div>
