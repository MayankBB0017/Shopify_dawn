{%- comment -%}
  Renders masonry columns for one layout variant.
  Accepts:
  - section: {Object}
  - layout_variant: {String} five_columns | mobile
  - post_blocks: filtered blocks (caller assigns via section.blocks | where)
{%- endcomment -%}

{%- liquid
  assign column_count = 5
  if layout_variant == 'mobile'
    assign column_count = 2
  endif

  if layout_variant == 'mobile'
    assign columns_class = 'instagram-grid__columns instagram-grid__columns--mobile'
  else
    assign columns_class = 'instagram-grid__columns instagram-grid__columns--desktop'
  endif
-%}

<div class="{{ columns_class }}" role="list">
  {%- for col_idx in (1..column_count) -%}
    <div class="instagram-grid__column" role="listitem">
      {%- for block in post_blocks -%}
        {%- liquid
          assign block_num = forloop.index
          assign slot_col = 0
          assign slot_size = 'square'

          if layout_variant == 'five_columns'
            case block_num
              when 1
                assign slot_col = 1
                assign slot_size = 'square'
              when 2
                assign slot_col = 1
                assign slot_size = 'square'
              when 3
                assign slot_col = 2
                assign slot_size = 'tall'
              when 4
                assign slot_col = 3
                assign slot_size = 'square'
              when 5
                assign slot_col = 3
                assign slot_size = 'square'
              when 6
                assign slot_col = 4
                assign slot_size = 'tall'
              when 7
                assign slot_col = 5
                assign slot_size = 'square'
              when 8
                assign slot_col = 5
                assign slot_size = 'square'
            endcase
          elsif layout_variant == 'mobile'
            case block_num
              when 1
                assign slot_col = 1
                assign slot_size = 'square'
              when 2
                assign slot_col = 2
                assign slot_size = 'square'
              when 3
                assign slot_col = 1
                assign slot_size = 'tall'
              when 4
                assign slot_col = 1
                assign slot_size = 'square'
              when 5
                assign slot_col = 2
                assign slot_size = 'square'
              when 6
                assign slot_col = 2
                assign slot_size = 'tall'
              when 7
                assign slot_col = 1
                assign slot_size = 'square'
              when 8
                assign slot_col = 2
                assign slot_size = 'square'
            endcase
          endif

          if block.settings.tile_size == 'square' or block.settings.tile_size == 'tall'
            assign slot_size = block.settings.tile_size
          elsif block.settings.media_type == 'video'
            assign slot_size = 'tall'
          endif

          assign tile_loading = 'lazy'
          if block_num <= 2
            assign tile_loading = 'eager'
          endif
        -%}

        {%- if slot_col == col_idx -%}
          {% render 'instagram-grid-tile',
            block: block,
            tile_size: slot_size,
            section: section,
            tile_index: block_num,
            loading: tile_loading
          %}
        {%- endif -%}
      {%- endfor -%}
    </div>
  {%- endfor -%}
</div>
