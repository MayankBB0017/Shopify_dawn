{% assign bundle_products = product.metafields.custom.product_custom_bundle %}

{% if bundle_products != blank %}
  <div class="page-width">
    <h2 class="title">Bundle Products</h2>

    <div class="grid grid--1-col grid--1-col-desktop">
      {% for bundle_product in bundle_products.value %}
        
        <div class="grid__item">
          <div class="card-wrapper">
              
              <div class="card card--standard">
                
                <!-- Product Image -->
                <div class="card__media_cutom">
                  <img 
                    src="{{ bundle_product.featured_image | image_url: width: 150 }}" 
                    alt="{{ bundle_product.title }}"
                    loading="lazy"
                  >
                </div>

                <!-- Product Info -->
                <div class="card__content">
                  <h3 class="card__heading">
                    {{ bundle_product.title }}
                  </h3>

                  <div class="card__price">
                    {{ bundle_product.price | money }}
                  </div>
                </div>

              </div>
            
          </div>
        </div>

      {% endfor %}
    </div>
  </div>
{% endif %}
<script>
document.addEventListener("DOMContentLoaded", () => {

  const form = document.querySelector('form[action="/cart/add"]');
  if (!form) return;

  const submitBtn = form.querySelector('.product-form__submit');

  form.addEventListener("submit", async (e) => {
    e.preventDefault();

    // 👉 Show loader (Dawn style)
    submitBtn.classList.add('loading');
    submitBtn.setAttribute('disabled', true);

    const mainVariantId = form.querySelector('[name="id"]').value;

    // 👉 Bundle products from metafield
    const bundleProducts = [
      {% for bundle_product in product.metafields.custom.product_custom_bundle.value %}
        {
          id: {{ bundle_product.variants.first.id }},
          title: "{{ bundle_product.title | escape }}"
        },
      {% endfor %}
    ];

    const subNames = bundleProducts.map(p => p.title).join(', ');

    let items = [];

    // ✅ MAIN PRODUCT (VISIBLE)
    items.push({
      id: mainVariantId,
      quantity: 1,
      properties: {
        Subproducts: subNames
      }
    });

    // ✅ SUB PRODUCTS (HIDDEN BUT PRICE INCLUDED)
    bundleProducts.forEach(p => {
      items.push({
        id: p.id,
        quantity: 1,
        properties: {
          _isSubproduct: true,
          parent_variant: mainVariantId
        }
      });
    });

    try {
      // 👉 Add all items
      await fetch('/cart/add.js', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ items })
      });

      // 👉 Refresh cart drawer (Dawn)
      const response = await fetch('/cart?section_id=cart-drawer');
      const html = await response.text();

      const drawer = document.querySelector('cart-drawer');
      drawer.renderContents(html);
      drawer.classList.add('active');

    } catch (err) {
      console.error(err);
    }

    // 👉 Reset button
    submitBtn.classList.remove('loading');
    submitBtn.removeAttribute('disabled');
  });

});
</script>