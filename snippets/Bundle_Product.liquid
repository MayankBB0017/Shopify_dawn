{% assign bundle_products = product.metafields.custom.product_custom_bundle %}

{% if bundle_products %}
  <div class="bundle-block grid grid--1-col grid--1-col-desktop" id="bundle-block">

    {% for bundle_product in bundle_products.value %}
      <div class="bundle-product-card grid__item">

        {% if bundle_product.featured_image %}
          <img
            src="{{ bundle_product.featured_image | img_url: '200x200' }}"
            alt="{{ bundle_product.title }}"
            class="bundle-product-image"
          />
        {% endif %}

        <div class="bundle-product-info">
          <p class="bundle-product-title">{{ bundle_product.title }}</p>
          <p class="bundle-product-price">
            {{ bundle_product.price | money }}
          </p>
        </div>

        {% assign bundle_variant = bundle_product.variants.first %}
        <input
          type="hidden"
          class="bundle-variant-id"
          value="{{ bundle_variant.id }}"
        />

      </div>
    {% endfor %}

  </div>

  <style>
    .bundle-product-card {
      display: flex;
      align-items: center;
      gap: 20px;
    }
    img.bundle-product-image {
      max-width: 120px;
    }
    div#bundle-block {
      display: flex;
      flex-direction: column;
      gap: 20px;
    }
    .cart-item[data-bundle-child="true"] {
      display: none !important;
    }
  </style>

  <script>
  (function() {
    console.log("🟡 [Bundle] Script loaded");

    // ─── HIDE CHILD ITEMS (MutationObserver — AJAX safe) ──────────────────

    function hideChildBundleItems() {
      document.querySelectorAll('.cart-item').forEach(function(item) {
        if (item.dataset.bundleChild === 'true') return;

        item.querySelectorAll('dt').forEach(function(dt) {
          if (dt.textContent.trim() === '_bundle_role') {
            const dd = dt.nextElementSibling;
            if (dd && dd.textContent.trim() === 'child') {
              item.setAttribute('data-bundle-child', 'true');
              item.style.setProperty('display', 'none', 'important');
              console.log("🟡 [Bundle] Hid child cart item");
            }
          }
        });
      });
    }

    hideChildBundleItems();

    const observer = new MutationObserver(function() {
      hideChildBundleItems();
    });

    ['cart-drawer', 'cart-items', 'main'].forEach(function(sel) {
      const el = document.querySelector(sel);
      if (el) observer.observe(el, { childList: true, subtree: true });
    });

    // ─── FETCH OVERRIDE ────────────────────────────────────────────────────

    const originalFetch = window.fetch;

    window.fetch = async function(url, options = {}) {

      if (typeof url === 'string' && url.includes('/cart/add')) {
        console.log("🟡 [Bundle] Intercepted /cart/add call");

        const bundleVariantEls = document.querySelectorAll('.bundle-variant-id');
        console.log("🟡 [Bundle] Child variants found:", bundleVariantEls.length);

        if (bundleVariantEls.length === 0) {
          console.warn("🟠 [Bundle] No child variants — passing through");
          return originalFetch(url, options);
        }

        const bundleId = 'bundle_' + Date.now();
        let existingItems = [];

        // ✅ Handle FormData (Dawn's default form submit)
        if (options.body instanceof FormData) {
          console.log("🟡 [Bundle] FormData detected");
          const formData  = options.body;
          const variantId = formData.get('id');
          const quantity  = parseInt(formData.get('quantity') || 1);

          if (!variantId) {
            console.error("🔴 [Bundle] No variant ID in FormData — passing through");
            return originalFetch(url, options);
          }

          existingItems = [{
            id: parseInt(variantId),
            quantity: quantity,
            properties: {
              _bundle_id:   bundleId,
              _bundle_role: 'parent'
            }
          }];

        } else if (typeof options.body === 'string') {
          console.log("🟡 [Bundle] JSON body detected");
          try {
            const parsed = JSON.parse(options.body);
            existingItems = (parsed.items || [{ id: parsed.id, quantity: parsed.quantity || 1 }])
              .map(item => ({
                ...item,
                properties: {
                  ...(item.properties || {}),
                  _bundle_id:   bundleId,
                  _bundle_role: 'parent'
                }
              }));
          } catch(e) {
            console.error("🔴 [Bundle] JSON parse failed — passing through:", e);
            return originalFetch(url, options);
          }

        } else {
          console.warn("🟠 [Bundle] Unknown body type — passing through");
          return originalFetch(url, options);
        }

        const childItems = [...bundleVariantEls].map(el => ({
          id: parseInt(el.value),
          quantity: 1,
          properties: {
            _bundle_id:   bundleId,
            _bundle_role: 'child'
          }
        }));

        const newPayload = { items: [...existingItems, ...childItems] };
        console.log("🟡 [Bundle] Sending payload:", JSON.stringify(newPayload, null, 2));

        let response;
        try {
          // ✅ KEY FIX: use original `url` not hardcoded '/cart/add.js'
          // Dawn appends ?sections=cart-drawer,cart-icon-bubble to the URL
          // which tells Shopify to return pre-rendered section HTML alongside
          // the cart JSON — stripping it causes parsedState['cart-drawer'] = undefined
          response = await originalFetch(url, {
            method:  'POST',
            headers: { 'Content-Type': 'application/json' },
            body:    JSON.stringify(newPayload)
          });
        } catch(networkErr) {
          console.error("🔴 [Bundle] Network error:", networkErr);
          throw networkErr;
        }

        console.log("🟢 [Bundle] Response status:", response.status);

        // ✅ Clone so Dawn can read the body stream and open the drawer
        return response.clone();
      }

      return originalFetch(url, options);
    };

    console.log("🟢 [Bundle] fetch override active — waiting for add to cart");
  })();
  </script>

{% endif %}