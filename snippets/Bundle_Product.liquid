{% assign bundle_products = product.metafields.custom.product_custom_bundle %}

{% if bundle_products %}
  <div class="bundle-block grid grid--1-col grid--1-col-desktop" id="bundle-block">

    {% for bundle_product in bundle_products.value %}
      <div class="bundle-product-card grid__item">

        {% if bundle_product.featured_image %}
          <img
            src="{{ bundle_product.featured_image | img_url: '200x200' }}"
            alt="{{ bundle_product.title }}"
            class="bundle-product-image"
          />
        {% endif %}

        <div class="bundle-product-info">
          <p class="bundle-product-title">{{ bundle_product.title }}</p>
          <p class="bundle-product-price">
            {{ bundle_product.price | money }}
          </p>
        </div>

        {% assign bundle_variant = bundle_product.variants.first %}
        <input
          type="hidden"
          class="bundle-variant-id"
          value="{{ bundle_variant.id }}"
        />

      </div>
    {% endfor %}

  </div>

  <style>
    .bundle-product-card {
      display: flex;
      align-items: center;
      gap: 20px;
    }
    img.bundle-product-image {
      max-width: 120px;
    }
    div#bundle-block {
      display: flex;
      flex-direction: column;
      gap: 20px;
    }
    .cart-item[data-bundle-child="true"] {
      display: none !important;
    }
  </style>

  <script>
  (function() {
    console.log("🟡 [Bundle] Script loaded");

    // ─── HIDE CHILD ITEMS (MutationObserver — AJAX safe) ──────────────────

    function hideChildBundleItems() {
      document.querySelectorAll('.cart-item').forEach(function(item) {
        if (item.dataset.bundleChild === 'true') return;

        item.querySelectorAll('dt').forEach(function(dt) {
          if (dt.textContent.trim() === '_bundle_role') {
            const dd = dt.nextElementSibling;
            if (dd && dd.textContent.trim() === 'child') {
              item.setAttribute('data-bundle-child', 'true');
              item.style.setProperty('display', 'none', 'important');
              console.log("🟡 [Bundle] Hid child cart item");
            }
          }
        });
      });
    }

    hideChildBundleItems();

    const observer = new MutationObserver(function() {
      hideChildBundleItems();
    });

    ['cart-drawer', 'cart-items', 'main'].forEach(function(sel) {
      const el = document.querySelector(sel);
      if (el) observer.observe(el, { childList: true, subtree: true });
    });

    // ─── FETCH OVERRIDE ────────────────────────────────────────────────────

    const originalFetch = window.fetch;

  window.fetch = async function(url, options = {}) {

    console.log("🟢 [Bundle] fetch override active — waiting for add to cart");
  })();
  </script>

{% endif %}