{% assign bundle_products = product.metafields.custom.product_custom_bundle %}

{% if bundle_products %}
  <div class="bundle-block grid grid--1-col grid--1-col-desktop" id="bundle-block">

    {% for bundle_product in bundle_products.value %}
      <div class="bundle-product-card grid__item">

        {% if bundle_product.featured_image %}
          <img
            src="{{ bundle_product.featured_image | img_url: '200x200' }}"
            alt="{{ bundle_product.title }}"
            class="bundle-product-image"
          />
        {% endif %}

        <div class="bundle-product-info">
          <p class="bundle-product-title">{{ bundle_product.title }}</p>
          <p class="bundle-product-price">{{ bundle_product.price | money }}</p>
        </div>

        {% assign bundle_variant = bundle_product.variants.first %}
        <input
          type="hidden"
          class="bundle-variant-id"
          value="{{ bundle_variant.id }}"
        />

      </div>
    {% endfor %}

  </div>

  <style>
    .bundle-product-card {
      display: flex;
      align-items: center;
      gap: 20px;
    }
    img.bundle-product-image {
      max-width: 120px;
    }
    div#bundle-block {
      display: flex;
      flex-direction: column;
      gap: 20px;
    }
  </style>

  <script>
  (function() {
    console.log("🟡 [Bundle] Script loaded");

    // ─── HIDE CHILD ITEMS IN CART (AJAX safe) ─────────────────────────────

    function hideChildBundleItems() {
      // Covers both cart drawer and cart page
      document.querySelectorAll('.cart-item').forEach(function(item) {
        const allText = item.innerText || '';
        const dlTags  = item.querySelectorAll('dl .product-option, dl dt, dl dd');

        let isChild = false;

        // Method 1: scan <dt>/<dd> pairs
        dlTags.forEach(function(el) {
          if (el.textContent.trim() === '_bundle_role') isChild = true;
        });

        // Method 2: fallback plain text scan (some Dawn versions render differently)
        if (!isChild && allText.includes('_bundle_role')) isChild = true;

        if (isChild) {
          item.style.setProperty('display', 'none', 'important');
          console.log("🟡 [Bundle] Hid child cart item");
        }
      });
    }

    // Run immediately
    hideChildBundleItems();

    // Re-run whenever cart drawer or cart page DOM updates
    const observer = new MutationObserver(function() {
      hideChildBundleItems();
    });

    ['cart-drawer', 'cart-items', 'main'].forEach(function(sel) {
      const el = document.querySelector(sel);
      if (el) observer.observe(el, { childList: true, subtree: true });
    });

    // ─── FETCH OVERRIDE — ADD BUNDLE ITEMS TO CART ────────────────────────

    const originalFetch = window.fetch;

    window.fetch = async function(url, options = {}) {

      if (typeof url === 'string' && url.includes('/cart/add')) {
        console.log("🟡 [Bundle] Intercepted /cart/add call");

        const bundleVariantEls = document.querySelectorAll('.bundle-variant-id');
        console.log("🟡 [Bundle] Child variants found:", bundleVariantEls.length);

        if (bundleVariantEls.length === 0) {
          console.warn("🟠 [Bundle] No child variants found — passing through");
          return originalFetch(url, options);
        }

        const bundleId = 'bundle_' + Date.now();
        let existingItems = [];

        if (options.body instanceof FormData) {
          const formData = options.body;
          const variantId = formData.get('id');
          const quantity  = formData.get('quantity') || 1;

          existingItems = [{
            id: parseInt(variantId),
            quantity: parseInt(quantity),
            properties: { _bundle_id: bundleId, _bundle_role: 'parent' }
          }];

        } else if (typeof options.body === 'string') {
          try {
            const parsed = JSON.parse(options.body);
            existingItems = (parsed.items || [{ id: parsed.id, quantity: parsed.quantity || 1 }])
              .map(item => ({
                ...item,
                properties: {
                  ...(item.properties || {}),
                  _bundle_id: bundleId,
                  _bundle_role: 'parent'
                }
              }));
          } catch(e) {
            console.error("🔴 [Bundle] Failed to parse JSON body:", e);
            return originalFetch(url, options);
          }

        } else {
          console.warn("🟠 [Bundle] Unknown body type — passing through");
          return originalFetch(url, options);
        }

        const childItems = [...bundleVariantEls].map(el => ({
          id: parseInt(el.value),
          quantity: 1,
          properties: { _bundle_id: bundleId, _bundle_role: 'child' }
        }));

        const newPayload = { items: [...existingItems, ...childItems] };
        console.log("🟡 [Bundle] Final payload:", JSON.stringify(newPayload, null, 2));

        return originalFetch(url, {
          ...options,
          headers: { ...(options.headers || {}), 'Content-Type': 'application/json' },
          body: JSON.stringify(newPayload)
        });
      }

      return originalFetch(url, options);
    };

    console.log("🟢 [Bundle] Bundle script ready");
  })();
  </script>

{% endif %}