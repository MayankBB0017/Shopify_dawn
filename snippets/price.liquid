{%- comment -%}
  Price component with discount percentage display
{%- endcomment -%}

{%- assign target = product -%}
{%- if use_variant -%}
  {%- assign target = product.selected_or_first_available_variant -%}
{%- elsif placeholder -%}
  {%- assign target = null -%}
{%- endif -%}

{%- unless target == null and placeholder == null -%}
  {%- assign price = target.price | default: 1999 -%}
  {%- assign compare_at_price = target.compare_at_price -%}
  {%- assign available = target.available | default: false -%}

  {%- assign money_price = price | money -%}
  {%- assign money_compare_at = compare_at_price | money -%}

  {%- if settings.currency_code_enabled -%}
    {%- assign money_price = price | money_with_currency -%}
    {%- assign money_compare_at = compare_at_price | money_with_currency -%}
  {%- endif -%}

  {%- comment -%} Calculate discount percentage safely {% endcomment -%}
  {%- assign discount_percentage = 0 -%}
  {%- if compare_at_price > price and compare_at_price > 0 -%}
    {%- assign diff = compare_at_price | minus: price -%}
    {%- assign discount_percentage = diff | times: 100 | divided_by: compare_at_price | round -%}
  {%- endif -%}

  <div class="price
    {%- if available == false %} price--sold-out{% endif -%}
    {%- if compare_at_price > price %} price--on-sale{% endif -%}
  ">
    <div class="price__container">
      <div class="price__regular">
        <span class="visually-hidden">{{ 'products.product.price.regular_price' | t }}</span>
        <span class="price-item price-item--regular">
          {{ money_price }}
          {%- if discount_percentage > 0 -%}
            <span class="discount-percentage">({{ discount_percentage }}% OFF)</span>
          {%- endif -%}
        </span>
      </div>

      {%- if compare_at_price > price -%}
        <div class="price__sale">
          <span class="visually-hidden">{{ 'products.product.price.regular_price' | t }}</span>
          <span>
            <s class="price-item price-item--regular">{{ money_compare_at }}</s>
          </span>
          <span class="price-item price-item--sale price-item--last">
            {{ money_price }}
            <span class="discount-percentage">({{ discount_percentage }}% OFF)</span>
          </span>
        </div>
      {%- endif -%}
    </div>
  </div>
{% endunless %}