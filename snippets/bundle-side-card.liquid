<bundle-side-card class="bundle-side-card--wrapper is-empty animate--slide-in">
  <div class="card-header--wrapper">
    <h1>Card</h1>
    <div class="header-right--wrapper">
      <span class="cart-qty">1</span>
      <span class="cart-subtotal">$0.00</span>
      <button class="bundle button button--full-width">Add To Cart</button>
      <button class="button-sidecart-toggle">
        {{- 'icon-caret.svg' | inline_asset_content -}}
      </button>
    </div>
  </div>
  <div class="cart-empty--wrapper">
    <h3 class="center">
      Your cart is empty
    </h3>
  </div>
  <div class="card-items--wrapper js-items">
    {% comment %}
    {% for i in (1..5) %}
      <side-card-item class="card-item">
        <div class="image--wrapper">
          <img class="image" width="100%" height="100%" src="https://cdn.shopify.com/s/files/1/0717/0814/7958/files/Main_b13ad453-477c-4ed1-9b43-81f3345adfd6.jpg?v=1724323039" alt="">
        </div>
        <div class="item-info">
          <span>Product Title</span>
          <span>$0.00</span>
        </div>
        <div class="item-action">
          {% render 'quantity-input' %}
          <button
            class="button button--tertiary btn-item--remove"
            aria-label="{{ 'sections.cart.remove_title' | t: title: item.title | escape }}">
            <span class="svg-wrapper">
              {{- 'icon-remove.svg' | inline_asset_content -}}
            </span>
          </button>
        </div>
      </side-card-item>
    {% endfor %}
    {% endcomment %}
  </div>
  <div class="card-footer--wrapper">
    <div class="subtotal--wrapper">
      <span>Total</span>
      <span>$0.00</span>
    </div>
    <button class="bundle button button--full-width">Add To Cart</button>
  </div>
</bundle-side-card>