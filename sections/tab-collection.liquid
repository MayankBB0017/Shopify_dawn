{% comment %}
  Tab Collection Slider Section
  - Tabs with priority: CMS title > Collection title
  - Clicking a tab shows the respective collection products below
  - Uses Dawn theme slider
{% endcomment %}

{% schema %}
{
  "name": "Tab Collection Slider",
  "settings": [
    { "type": "collection", "id": "collection_1", "label": "Collection 1" },
    { "type": "collection", "id": "collection_2", "label": "Collection 2" },
    { "type": "collection", "id": "collection_3", "label": "Collection 3" },
    { "type": "collection", "id": "collection_4", "label": "Collection 4" },
    { "type": "collection", "id": "collection_5", "label": "Collection 5" }
  ],
  "blocks": [
    {
      "type": "tab_title",
      "name": "Tab Title",
      "settings": [
        { "type": "text", "id": "tab_title", "label": "Custom Tab Title" }
      ]
    }
  ],
  "max_blocks": 5,
  "presets": [{ "name": "Tab Collection Slider", "category": "Collection" }]
}
{% endschema %}

