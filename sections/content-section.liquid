{% comment %}
  Section: Text Banner
  A clean, responsive text section with heading, rich text, and optional CTA links.
  Compatible with Shopify Dawn theme.
{% endcomment %}

<style>
  .text-banner-{{ section.id }} {
    background-color: {{ section.settings.background_color }};
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }

  .text-banner-{{ section.id }} .text-banner__inner {
    max-width: {{ section.settings.content_max_width }}px;
    margin: 0 auto;
    padding: 0 {{ section.settings.horizontal_padding }}px;
    text-align: {{ section.settings.text_alignment }};
  }

  .text-banner-{{ section.id }} .text-banner__heading {
    font-size: {{ section.settings.heading_size }}px;
    color: {{ section.settings.heading_color }};
    font-weight: {{ section.settings.heading_weight }};
    margin: 0 0 {{ section.settings.heading_bottom_spacing }}px 0;
    line-height: 1.3;
    letter-spacing: {{ section.settings.heading_letter_spacing | times: 0.01 }}em;
    font-style: {{ section.settings.heading_italic | ternary: 'italic', 'normal' }};
  }

  .text-banner-{{ section.id }} .text-banner__body {
    font-size: {{ section.settings.body_size }}px;
    color: {{ section.settings.body_color }};
    line-height: {{ section.settings.body_line_height | times: 0.1 }};
    margin: 0 0 {{ section.settings.body_bottom_spacing }}px 0;
    font-weight: {{ section.settings.body_weight }};
  }

  .text-banner-{{ section.id }} .text-banner__links {
    display: flex;
    flex-wrap: wrap;
    gap: {{ section.settings.link_gap }}px;
    justify-content: {% if section.settings.text_alignment == 'left' %}flex-start{% elsif section.settings.text_alignment == 'right' %}flex-end{% else %}center{% endif %};
    margin-top: {{ section.settings.links_top_spacing }}px;
  }

  .text-banner-{{ section.id }} .text-banner__link {
    display: inline-block;
    font-size: {{ section.settings.link_font_size }}px;
    font-weight: {{ section.settings.link_weight }};
    text-decoration: {{ section.settings.link_text_decoration }};
    letter-spacing: {{ section.settings.link_letter_spacing | times: 0.01 }}em;
    text-transform: {{ section.settings.link_text_transform }};
    transition: opacity 0.2s ease, color 0.2s ease, background-color 0.2s ease;
  }

  {% if section.settings.link_style == 'text' %}
    .text-banner-{{ section.id }} .text-banner__link {
      color: {{ section.settings.link_color }};
      padding: 0;
      background: transparent;
      border: none;
    }
    .text-banner-{{ section.id }} .text-banner__link:hover {
      color: {{ section.settings.link_hover_color }};
      opacity: 0.8;
    }
  {% elsif section.settings.link_style == 'button_filled' %}
    .text-banner-{{ section.id }} .text-banner__link {
      color: {{ section.settings.link_btn_text_color }};
      background-color: {{ section.settings.link_color }};
      padding: {{ section.settings.link_btn_padding_v }}px {{ section.settings.link_btn_padding_h }}px;
      border: 2px solid {{ section.settings.link_color }};
      border-radius: {{ section.settings.link_btn_border_radius }}px;
    }
    .text-banner-{{ section.id }} .text-banner__link:hover {
      background-color: {{ section.settings.link_hover_color }};
      border-color: {{ section.settings.link_hover_color }};
    }
  {% elsif section.settings.link_style == 'button_outline' %}
    .text-banner-{{ section.id }} .text-banner__link {
      color: {{ section.settings.link_color }};
      background-color: transparent;
      padding: {{ section.settings.link_btn_padding_v }}px {{ section.settings.link_btn_padding_h }}px;
      border: 2px solid {{ section.settings.link_color }};
      border-radius: {{ section.settings.link_btn_border_radius }}px;
    }
    .text-banner-{{ section.id }} .text-banner__link:hover {
      color: {{ section.settings.link_btn_text_color }};
      background-color: {{ section.settings.link_hover_color }};
      border-color: {{ section.settings.link_hover_color }};
    }
  {% endif %}

  /* ─── Responsive ─── */
  @media screen and (max-width: 990px) {
    .text-banner-{{ section.id }} .text-banner__heading {
      font-size: {{ section.settings.heading_size | times: 0.85 | round }}px;
    }
    .text-banner-{{ section.id }} .text-banner__body {
      font-size: {{ section.settings.body_size | times: 0.95 | round }}px;
    }
    .text-banner-{{ section.id }} {
      padding-top: {{ section.settings.padding_top | times: 0.75 | round }}px;
      padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round }}px;
    }
  }

  @media screen and (max-width: 749px) {
    .text-banner-{{ section.id }} .text-banner__inner {
      padding: 0 {{ section.settings.horizontal_padding | times: 0.6 | round }}px;
      text-align: {% if section.settings.mobile_text_alignment == 'inherit' %}{{ section.settings.text_alignment }}{% else %}{{ section.settings.mobile_text_alignment }}{% endif %};
    }
    .text-banner-{{ section.id }} .text-banner__heading {
      font-size: {{ section.settings.heading_size | times: 0.72 | round }}px;
    }
    .text-banner-{{ section.id }} .text-banner__body {
      font-size: {{ section.settings.body_size | times: 0.9 | round }}px;
    }
    .text-banner-{{ section.id }} .text-banner__links {
      justify-content: {% if section.settings.mobile_text_alignment == 'left' %}flex-start{% elsif section.settings.mobile_text_alignment == 'right' %}flex-end{% elsif section.settings.mobile_text_alignment == 'center' %}center{% else %}{% if section.settings.text_alignment == 'left' %}flex-start{% elsif section.settings.text_alignment == 'right' %}flex-end{% else %}center{% endif %}{% endif %};
      flex-direction: {% if section.settings.mobile_links_stack %}column{% else %}row{% endif %};
      align-items: {% if section.settings.mobile_links_stack %}{% if section.settings.text_alignment == 'center' or section.settings.mobile_text_alignment == 'center' %}center{% elsif section.settings.text_alignment == 'right' or section.settings.mobile_text_alignment == 'right' %}flex-end{% else %}flex-start{% endif %}{% else %}center{% endif %};
    }
    .text-banner-{{ section.id }} {
      padding-top: {{ section.settings.padding_top | times: 0.6 | round }}px;
      padding-bottom: {{ section.settings.padding_bottom | times: 0.6 | round }}px;
    }
  }
</style>

<section class="text-banner-{{ section.id }} text-banner color-{{ section.settings.color_scheme }}">
  <div class="text-banner__inner">

    {% if section.settings.heading != blank %}
      <{{ section.settings.heading_tag }} class="text-banner__heading">
        {{ section.settings.heading | escape }}
      </{{ section.settings.heading_tag }}>
    {% endif %}

    {% if section.settings.body_text != blank %}
      <div class="text-banner__body rte">
        {{ section.settings.body_text }}
      </div>
    {% endif %}

    {% assign has_link_1 = false %}
    {% assign has_link_2 = false %}
    {% if section.settings.link_1_label != blank and section.settings.link_1_url != blank %}
      {% assign has_link_1 = true %}
    {% endif %}
    {% if section.settings.link_2_label != blank and section.settings.link_2_url != blank %}
      {% assign has_link_2 = true %}
    {% endif %}

    {% if has_link_1 or has_link_2 %}
      <div class="text-banner__links">
        {% if has_link_1 %}
          <a href="{{ section.settings.link_1_url }}" class="text-banner__link"
            {% if section.settings.link_1_new_tab %}target="_blank" rel="noopener noreferrer"{% endif %}>
            {{ section.settings.link_1_label | escape }}
          </a>
        {% endif %}
        {% if has_link_2 %}
          <a href="{{ section.settings.link_2_url }}" class="text-banner__link text-banner__link--secondary"
            {% if section.settings.link_2_new_tab %}target="_blank" rel="noopener noreferrer"{% endif %}>
            {{ section.settings.link_2_label | escape }}
          </a>
        {% endif %}
      </div>
    {% endif %}

  </div>
</section>

{% schema %}
{
  "name": "Text Banner",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "El verano nunca acaba con Robin."
    },
    {
      "type": "select",
      "id": "heading_tag",
      "label": "Heading HTML tag",
      "options": [
        { "value": "h1", "label": "H1" },
        { "value": "h2", "label": "H2" },
        { "value": "h3", "label": "H3" },
        { "value": "h4", "label": "H4" },
        { "value": "p", "label": "Paragraph" }
      ],
      "default": "h2"
    },
    {
      "type": "richtext",
      "id": "body_text",
      "label": "Body text",
      "default": "<p>Encuentra en nuestra tienda online oficial tus bikinis y bañadores para tus escapadas a la playa, tus momentos en la piscina, y cualquier plan que imagines.</p>"
    },
    {
      "type": "header",
      "content": "Link 1"
    },
    {
      "type": "text",
      "id": "link_1_label",
      "label": "Link 1 label",
      "default": "Shop now"
    },
    {
      "type": "url",
      "id": "link_1_url",
      "label": "Link 1 URL"
    },
    {
      "type": "checkbox",
      "id": "link_1_new_tab",
      "label": "Open in new tab",
      "default": false
    },
    {
      "type": "header",
      "content": "Link 2"
    },
    {
      "type": "text",
      "id": "link_2_label",
      "label": "Link 2 label",
      "default": "Learn more"
    },
    {
      "type": "url",
      "id": "link_2_url",
      "label": "Link 2 URL"
    },
    {
      "type": "checkbox",
      "id": "link_2_new_tab",
      "label": "Open in new tab",
      "default": false
    },
    {
      "type": "header",
      "content": "Layout & Alignment"
    },
    {
      "type": "select",
      "id": "text_alignment",
      "label": "Text alignment (desktop)",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "left"
    },
    {
      "type": "select",
      "id": "mobile_text_alignment",
      "label": "Text alignment (mobile)",
      "options": [
        { "value": "inherit", "label": "Same as desktop" },
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "inherit"
    },
    {
      "type": "checkbox",
      "id": "mobile_links_stack",
      "label": "Stack links vertically on mobile",
      "default": false
    },
    {
      "type": "range",
      "id": "content_max_width",
      "min": 400,
      "max": 1400,
      "step": 20,
      "unit": "px",
      "label": "Content max width",
      "default": 860
    },
    {
      "type": "range",
      "id": "horizontal_padding",
      "min": 10,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "Horizontal padding",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding top",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom",
      "default": 60
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Color scheme (Dawn scheme class)",
      "options": [
        { "value": "scheme-1", "label": "Scheme 1" },
        { "value": "scheme-2", "label": "Scheme 2" },
        { "value": "scheme-3", "label": "Scheme 3" },
        { "value": "background-1", "label": "Background 1" },
        { "value": "background-2", "label": "Background 2" },
        { "value": "inverse", "label": "Inverse" }
      ],
      "default": "background-1"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Custom background color",
      "default": "#ffffff"
    },
    {
      "type": "header",
      "content": "Heading Styles"
    },
    {
      "type": "range",
      "id": "heading_size",
      "min": 14,
      "max": 80,
      "step": 1,
      "unit": "px",
      "label": "Heading font size",
      "default": 28
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color",
      "default": "#121212"
    },
    {
      "type": "select",
      "id": "heading_weight",
      "label": "Heading font weight",
      "options": [
        { "value": "300", "label": "Light" },
        { "value": "400", "label": "Regular" },
        { "value": "500", "label": "Medium" },
        { "value": "600", "label": "Semi Bold" },
        { "value": "700", "label": "Bold" }
      ],
      "default": "600"
    },
    {
      "type": "checkbox",
      "id": "heading_italic",
      "label": "Italic heading",
      "default": false
    },
    {
      "type": "range",
      "id": "heading_letter_spacing",
      "min": -5,
      "max": 20,
      "step": 1,
      "unit": "em",
      "label": "Heading letter spacing (×0.01em)",
      "default": 0
    },
    {
      "type": "range",
      "id": "heading_bottom_spacing",
      "min": 0,
      "max": 60,
      "step": 2,
      "unit": "px",
      "label": "Space below heading",
      "default": 16
    },
    {
      "type": "header",
      "content": "Body Text Styles"
    },
    {
      "type": "range",
      "id": "body_size",
      "min": 12,
      "max": 32,
      "step": 1,
      "unit": "px",
      "label": "Body font size",
      "default": 16
    },
    {
      "type": "color",
      "id": "body_color",
      "label": "Body text color",
      "default": "#444444"
    },
    {
      "type": "select",
      "id": "body_weight",
      "label": "Body font weight",
      "options": [
        { "value": "300", "label": "Light" },
        { "value": "400", "label": "Regular" },
        { "value": "500", "label": "Medium" }
      ],
      "default": "400"
    },
    {
      "type": "range",
      "id": "body_line_height",
      "min": 10,
      "max": 30,
      "step": 1,
      "unit": "x",
      "label": "Body line height (×0.1)",
      "default": 17
    },
    {
      "type": "range",
      "id": "body_bottom_spacing",
      "min": 0,
      "max": 60,
      "step": 2,
      "unit": "px",
      "label": "Space below body text",
      "default": 0
    },
    {
      "type": "header",
      "content": "Link / Button Styles"
    },
    {
      "type": "select",
      "id": "link_style",
      "label": "Link style",
      "options": [
        { "value": "text", "label": "Text link" },
        { "value": "button_filled", "label": "Filled button" },
        { "value": "button_outline", "label": "Outline button" }
      ],
      "default": "text"
    },
    {
      "type": "color",
      "id": "link_color",
      "label": "Link / button color",
      "default": "#121212"
    },
    {
      "type": "color",
      "id": "link_hover_color",
      "label": "Link / button hover color",
      "default": "#555555"
    },
    {
      "type": "color",
      "id": "link_btn_text_color",
      "label": "Button text color (filled/outline hover)",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "link_font_size",
      "min": 10,
      "max": 24,
      "step": 1,
      "unit": "px",
      "label": "Link font size",
      "default": 14
    },
    {
      "type": "select",
      "id": "link_weight",
      "label": "Link font weight",
      "options": [
        { "value": "400", "label": "Regular" },
        { "value": "500", "label": "Medium" },
        { "value": "600", "label": "Semi Bold" },
        { "value": "700", "label": "Bold" }
      ],
      "default": "500"
    },
    {
      "type": "select",
      "id": "link_text_decoration",
      "label": "Link text decoration",
      "options": [
        { "value": "none", "label": "None" },
        { "value": "underline", "label": "Underline" }
      ],
      "default": "underline"
    },
    {
      "type": "select",
      "id": "link_text_transform",
      "label": "Link text transform",
      "options": [
        { "value": "none", "label": "None" },
        { "value": "uppercase", "label": "Uppercase" },
        { "value": "capitalize", "label": "Capitalize" }
      ],
      "default": "uppercase"
    },
    {
      "type": "range",
      "id": "link_letter_spacing",
      "min": 0,
      "max": 20,
      "step": 1,
      "unit": "em",
      "label": "Link letter spacing (×0.01em)",
      "default": 5
    },
    {
      "type": "range",
      "id": "link_btn_padding_v",
      "min": 4,
      "max": 30,
      "step": 2,
      "unit": "px",
      "label": "Button padding (vertical)",
      "default": 12
    },
    {
      "type": "range",
      "id": "link_btn_padding_h",
      "min": 8,
      "max": 60,
      "step": 2,
      "unit": "px",
      "label": "Button padding (horizontal)",
      "default": 24
    },
    {
      "type": "range",
      "id": "link_btn_border_radius",
      "min": 0,
      "max": 50,
      "step": 2,
      "unit": "px",
      "label": "Button border radius",
      "default": 0
    },
    {
      "type": "range",
      "id": "link_gap",
      "min": 4,
      "max": 60,
      "step": 4,
      "unit": "px",
      "label": "Gap between links",
      "default": 24
    },
    {
      "type": "range",
      "id": "links_top_spacing",
      "min": 0,
      "max": 60,
      "step": 4,
      "unit": "px",
      "label": "Space above links",
      "default": 20
    }
  ],
  "presets": [
    {
      "name": "Text Banner",
      "category": "Text"
    }
  ]
}
{% endschema %}
