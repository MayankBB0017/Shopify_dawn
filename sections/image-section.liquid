{% schema %}
{
  "name": "4 Images with Bottom Text",
  "settings": [
    {
      "type": "text",
      "id": "section_heading",
      "label": "Section Heading",
      "default": "Featured Collection"
    }
  ],
  "blocks": [
    {
      "type": "image_text",
      "name": "Image Block",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Overlay Text",
          "default": "Sample Text"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link",
        }
      ]
    }
  ],
  "max_blocks": 4,
  "presets": [
    {
      "name": "4 Images with Text",
      "category": "Custom"
    }
  ]
}
{% endschema %}

<div class="four-images-section">
  {% if section.settings.section_heading != blank %}
    <h2 class="section-title">{{ section.settings.section_heading }}</h2>
  {% endif %}
  <div class="four-images-grid">
    {% for block in section.blocks %}
      <a href="{{ block.settings.link }}" class="image-block">
        {% if block.settings.image %}
          <img src="{{ block.settings.image | img_url: '800x' }}" alt="{{ block.settings.text }}">
        {% endif %}
        {% if block.settings.text != blank %}
          <div class="overlay-text">{{ block.settings.text }}</div>
        {% endif %}
      </a>
    {% endfor %}
  </div>
</div>
