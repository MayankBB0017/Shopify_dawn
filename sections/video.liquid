{{ 'video-section.css' | asset_url | stylesheet_tag }}
{{ 'component-deferred-media.css' | asset_url | stylesheet_tag }}
<script src="{{ 'video-section.js' | asset_url }}" defer="defer"></script>

{%- liquid
  assign container_class = ''
  assign container_modifier = 'full'
  assign container_width = section.settings.container_width

  if container_width == blank
    if section.settings.full_width == false
      assign container_width = 'standard'
    else
      assign container_width = 'full_width'
    endif
  endif

  if container_width == 'standard'
    assign container_class = 'page-width'
    assign container_modifier = 'standard'
  endif

  assign container_full = false
  if container_modifier == 'full'
    assign container_full = true
  endif

  assign container_radius = 0
  if container_modifier == 'standard'
    assign container_radius = section.settings.container_border_radius | default: 8
  endif

  assign height_desktop = section.settings.height_desktop
  if height_desktop == blank
    assign height_desktop = 'adapt'
  endif

  assign height_mobile = section.settings.height_mobile
  if height_mobile == blank
    assign height_mobile = 'adapt'
  endif

  assign heading_align_desktop = section.settings.heading_alignment_desktop
  if heading_align_desktop != 'left' and heading_align_desktop != 'right'
    assign heading_align_desktop = 'center'
  endif

  assign heading_align_mobile = section.settings.heading_alignment_mobile
  if heading_align_mobile != 'left' and heading_align_mobile != 'right'
    assign heading_align_mobile = 'center'
  endif

  assign desktop_video = section.settings.video
  assign desktop_video_url = section.settings.video_url
  assign desktop_poster = section.settings.cover_image
  if desktop_poster == blank and desktop_video != blank
    assign desktop_poster = desktop_video.preview_image
  endif

  assign mobile_video = section.settings.video_mobile
  if mobile_video == blank
    assign mobile_video = section.settings.video
  endif

  assign mobile_video_url = section.settings.video_url_mobile
  if mobile_video_url == blank
    assign mobile_video_url = section.settings.video_url
  endif

  assign mobile_poster = section.settings.cover_image_mobile
  if mobile_poster == blank and section.settings.video_mobile != blank
    assign mobile_poster = section.settings.video_mobile.preview_image
  endif
  if mobile_poster == blank and section.settings.video != blank
    assign mobile_poster = section.settings.video.preview_image
  endif
  if mobile_poster == blank
    assign mobile_poster = section.settings.cover_image
  endif

  assign desktop_video_id = desktop_video.id | default: desktop_video_url.id
  assign mobile_video_id = mobile_video.id | default: mobile_video_url.id

  if desktop_video_id == blank and mobile_video_id != blank
    assign desktop_video = mobile_video
    assign desktop_video_url = mobile_video_url
    assign desktop_poster = mobile_poster
    assign desktop_video_id = mobile_video_id
  endif

  assign video_alt = desktop_video.alt | default: section.settings.description
  assign alt = 'sections.video.load_video' | t: description: video_alt | escape

  assign has_media = false
  if desktop_video_id != blank or mobile_video_id != blank
    assign has_media = true
  endif

  assign show_placeholder = false
  unless has_media
    if request.design_mode or request.visual_preview_mode
      assign show_placeholder = true
    endif
  endunless

  assign preview_visible_class = ''
  if request.design_mode or request.visual_preview_mode
    assign preview_visible_class = ' video-section-wrapper--fade-visible'
  endif

  assign padding_top_desktop = section.settings.padding_top_desktop
  if padding_top_desktop == blank
    assign padding_top_desktop = section.settings.padding_top | default: 0
  endif

  assign padding_bottom_desktop = section.settings.padding_bottom_desktop
  if padding_bottom_desktop == blank
    assign padding_bottom_desktop = section.settings.padding_bottom | default: 32
  endif

  assign padding_top_mobile = section.settings.padding_top_mobile
  if padding_top_mobile == blank
    if section.settings.padding_top != blank
      assign padding_top_mobile = section.settings.padding_top | times: 0.75 | round: 0
    else
      assign padding_top_mobile = 0
    endif
  endif

  assign padding_bottom_mobile = section.settings.padding_bottom_mobile
  if padding_bottom_mobile == blank
    if section.settings.padding_bottom != blank
      assign padding_bottom_mobile = section.settings.padding_bottom | times: 0.75 | round: 0
    else
      assign padding_bottom_mobile = 24
    endif
  endif
-%}

{%- style -%}
  #VideoSection-{{ section.id }} .video-section {
    --vs-padding-top-mobile: {{ padding_top_mobile }}px;
    --vs-padding-bottom-mobile: {{ padding_bottom_mobile }}px;
    --vs-padding-top-desktop: {{ padding_top_desktop }}px;
    --vs-padding-bottom-desktop: {{ padding_bottom_desktop }}px;
    --vs-container-radius: {{ container_radius }}px;
  }
{%- endstyle -%}

{%- capture sizes -%}
  {% if container_full -%}
    100vw
  {%- else -%}
    (min-width: {{ settings.page_width }}px) {{ settings.page_width | minus: 100 }}px, (min-width: 750px)
    calc(100vw - 10rem), 100vw
  {%- endif %}
{%- endcapture -%}

<video-section
  id="VideoSection-{{ section.id }}"
  class="video-section-wrapper video-section-wrapper--container-{{ container_modifier }} video-section-wrapper--height-desktop-{{ height_desktop }} video-section-wrapper--height-mobile-{{ height_mobile }}{% if section.settings.enable_fade_in_desktop != false %} video-section-wrapper--fade-in-desktop{% endif %}{% if section.settings.enable_fade_in_mobile != false %} video-section-wrapper--fade-in-mobile{% endif %}{{ preview_visible_class }}"
>
  <div class="color-{{ section.settings.color_scheme }} gradient">
    <div class="video-section video-section--container-{{ container_modifier }} isolate">
      {%- if container_modifier == 'standard' -%}
        <div class="video-section__shell {{ container_class }}">
          {%- unless section.settings.heading == blank -%}
            <header class="video-section__header video-section__header--desktop-{{ heading_align_desktop }} video-section__header--mobile-{{ heading_align_mobile }}">
              <div class="title-wrapper title-wrapper--no-top-margin{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}">
                <h2 class="title inline-richtext {{ section.settings.heading_size }}">{{ section.settings.heading }}</h2>
              </div>
            </header>
          {%- endunless -%}

          <div class="video-section-wrapper__stage">
            {%- if has_media -%}
              {% render 'video-section-media',
                breakpoint: 'mobile',
                video: mobile_video,
                video_url: mobile_video_url,
                poster: mobile_poster,
                section: section,
                sizes: sizes,
                alt: alt,
                container_full: false
              %}

              {% render 'video-section-media',
                breakpoint: 'desktop',
                video: desktop_video,
                video_url: desktop_video_url,
                poster: desktop_poster,
                section: section,
                sizes: sizes,
                alt: alt,
                container_full: false
              %}
            {%- elsif show_placeholder -%}
              {% render 'video-section-media',
                breakpoint: 'mobile',
                video: blank,
                video_url: blank,
                poster: blank,
                section: section,
                sizes: sizes,
                alt: alt,
                show_placeholder: true,
                container_full: false
              %}

              {% render 'video-section-media',
                breakpoint: 'desktop',
                video: blank,
                video_url: blank,
                poster: blank,
                section: section,
                sizes: sizes,
                alt: alt,
                show_placeholder: true,
                container_full: false
              %}
            {%- endif -%}
          </div>
        </div>
      {%- else -%}
        {%- unless section.settings.heading == blank -%}
          <div class="video-section__header-shell page-width">
            <header class="video-section__header video-section__header--desktop-{{ heading_align_desktop }} video-section__header--mobile-{{ heading_align_mobile }}">
              <div class="title-wrapper title-wrapper--no-top-margin{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}">
                <h2 class="title inline-richtext {{ section.settings.heading_size }}">{{ section.settings.heading }}</h2>
              </div>
            </header>
          </div>
        {%- endunless -%}

        <div class="video-section-wrapper__stage">
          {%- if has_media -%}
            {% render 'video-section-media',
              breakpoint: 'mobile',
              video: mobile_video,
              video_url: mobile_video_url,
              poster: mobile_poster,
              section: section,
              sizes: sizes,
              alt: alt,
              container_full: true
            %}

            {% render 'video-section-media',
              breakpoint: 'desktop',
              video: desktop_video,
              video_url: desktop_video_url,
              poster: desktop_poster,
              section: section,
              sizes: sizes,
              alt: alt,
              container_full: true
            %}
          {%- elsif show_placeholder -%}
            {% render 'video-section-media',
              breakpoint: 'mobile',
              video: blank,
              video_url: blank,
              poster: blank,
              section: section,
              sizes: sizes,
              alt: alt,
              show_placeholder: true,
              container_full: true
            %}

            {% render 'video-section-media',
              breakpoint: 'desktop',
              video: blank,
              video_url: blank,
              poster: blank,
              section: section,
              sizes: sizes,
              alt: alt,
              show_placeholder: true,
              container_full: true
            %}
          {%- endif -%}
        </div>
      {%- endif -%}
    </div>
  </div>
</video-section>

{% schema %}
{
  "name": "t:sections.video.name",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "header",
      "content": "t:sections.video.settings.header_content.content"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "t:sections.video.settings.heading.label"
    },
    {
      "type": "select",
      "id": "heading_size",
      "options": [
        {
          "value": "h2",
          "label": "t:sections.all.heading_size.options__1.label"
        },
        {
          "value": "h1",
          "label": "t:sections.all.heading_size.options__2.label"
        },
        {
          "value": "h0",
          "label": "t:sections.all.heading_size.options__3.label"
        },
        {
          "value": "hxl",
          "label": "t:sections.all.heading_size.options__4.label"
        },
        {
          "value": "hxxl",
          "label": "t:sections.all.heading_size.options__5.label"
        }
      ],
      "default": "h1",
      "label": "t:sections.all.heading_size.label"
    },
    {
      "type": "select",
      "id": "heading_alignment_desktop",
      "label": "t:sections.video.settings.heading_alignment_desktop.label",
      "options": [
        {
          "value": "left",
          "label": "t:sections.video.settings.heading_alignment.options__left.label"
        },
        {
          "value": "center",
          "label": "t:sections.video.settings.heading_alignment.options__center.label"
        },
        {
          "value": "right",
          "label": "t:sections.video.settings.heading_alignment.options__right.label"
        }
      ],
      "default": "center"
    },
    {
      "type": "select",
      "id": "heading_alignment_mobile",
      "label": "t:sections.video.settings.heading_alignment_mobile.label",
      "options": [
        {
          "value": "left",
          "label": "t:sections.video.settings.heading_alignment.options__left.label"
        },
        {
          "value": "center",
          "label": "t:sections.video.settings.heading_alignment.options__center.label"
        },
        {
          "value": "right",
          "label": "t:sections.video.settings.heading_alignment.options__right.label"
        }
      ],
      "default": "center"
    },
    {
      "type": "checkbox",
      "id": "enable_video_looping",
      "label": "t:sections.video.settings.enable_video_looping.label",
      "default": false
    },
    {
      "type": "text",
      "id": "description",
      "label": "t:sections.video.settings.description.label",
      "info": "t:sections.video.settings.description.info"
    },
    {
      "type": "header",
      "content": "t:sections.video.settings.header_desktop.content"
    },
    {
      "type": "video",
      "id": "video",
      "label": "t:sections.video.settings.video.label",
      "info": "t:sections.video.settings.video.info"
    },
    {
      "type": "header",
      "content": "t:sections.video.settings.header__2.content"
    },
    {
      "type": "paragraph",
      "content": "t:sections.video.settings.paragraph.content"
    },
    {
      "type": "video_url",
      "id": "video_url",
      "accept": ["youtube", "vimeo"],
      "label": "t:sections.video.settings.video_url.label",
      "info": "t:sections.video.settings.video_url.info"
    },
    {
      "type": "image_picker",
      "id": "cover_image",
      "label": "t:sections.video.settings.cover_image.label",
      "info": "t:sections.video.settings.cover_image.info"
    },
    {
      "type": "select",
      "id": "height_desktop",
      "label": "t:sections.video.settings.height_desktop.label",
      "options": [
        {
          "value": "adapt",
          "label": "t:sections.video.settings.height.options__adapt.label"
        },
        {
          "value": "fit_screen",
          "label": "t:sections.video.settings.height.options__fit_screen.label"
        },
        {
          "value": "large",
          "label": "t:sections.video.settings.height.options__large.label"
        },
        {
          "value": "medium",
          "label": "t:sections.video.settings.height.options__medium.label"
        },
        {
          "value": "small",
          "label": "t:sections.video.settings.height.options__small.label"
        }
      ],
      "default": "adapt"
    },
    {
      "type": "header",
      "content": "t:sections.video.settings.header_mobile.content"
    },
    {
      "type": "paragraph",
      "content": "t:sections.video.settings.mobile_fallback_paragraph.content"
    },
    {
      "type": "video",
      "id": "video_mobile",
      "label": "t:sections.video.settings.video_mobile.label",
      "info": "t:sections.video.settings.video_mobile.info"
    },
    {
      "type": "video_url",
      "id": "video_url_mobile",
      "accept": ["youtube", "vimeo"],
      "label": "t:sections.video.settings.video_url_mobile.label",
      "info": "t:sections.video.settings.video_url_mobile.info"
    },
    {
      "type": "image_picker",
      "id": "cover_image_mobile",
      "label": "t:sections.video.settings.cover_image_mobile.label",
      "info": "t:sections.video.settings.cover_image_mobile.info"
    },
    {
      "type": "select",
      "id": "height_mobile",
      "label": "t:sections.video.settings.height_mobile.label",
      "options": [
        {
          "value": "adapt",
          "label": "t:sections.video.settings.height.options__adapt.label"
        },
        {
          "value": "fit_screen",
          "label": "t:sections.video.settings.height.options__fit_screen.label"
        },
        {
          "value": "large",
          "label": "t:sections.video.settings.height.options__large.label"
        },
        {
          "value": "medium",
          "label": "t:sections.video.settings.height.options__medium.label"
        },
        {
          "value": "small",
          "label": "t:sections.video.settings.height.options__small.label"
        }
      ],
      "default": "adapt"
    },
    {
      "type": "header",
      "content": "t:sections.video.settings.header__3.content"
    },
    {
      "type": "select",
      "id": "container_width",
      "label": "t:sections.video.settings.container_width.label",
      "info": "t:sections.video.settings.container_width.info",
      "options": [
        {
          "value": "standard",
          "label": "t:sections.video.settings.container_width.options__standard.label"
        },
        {
          "value": "full_width",
          "label": "t:sections.video.settings.container_width.options__full_width.label"
        }
      ],
      "default": "full_width"
    },
    {
      "type": "range",
      "id": "container_border_radius",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "label": "t:sections.video.settings.container_border_radius.label",
      "info": "t:sections.video.settings.container_border_radius.info",
      "default": 8,
      "visible_if": "{{ section.settings.container_width == 'standard' }}"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "t:sections.video.settings.header_animation.content"
    },
    {
      "type": "checkbox",
      "id": "enable_fade_in_desktop",
      "label": "t:sections.video.settings.enable_fade_in_desktop.label",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "enable_fade_in_mobile",
      "label": "t:sections.video.settings.enable_fade_in_mobile.label",
      "default": true
    },
    {
      "type": "header",
      "content": "t:sections.video.settings.header_padding.content"
    },
    {
      "type": "range",
      "id": "padding_top_desktop",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.video.settings.padding_top_desktop.label",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom_desktop",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.video.settings.padding_bottom_desktop.label",
      "default": 32
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.video.settings.padding_top_mobile.label",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.video.settings.padding_bottom_mobile.label",
      "default": 24
    }
  ],
  "presets": [
    {
      "name": "t:sections.video.presets.name",
      "category": "t:sections.all.jane_custom_sections.category",
      "settings": {
        "container_width": "full_width",
        "heading": "Product video",
        "heading_alignment_desktop": "center",
        "heading_alignment_mobile": "center",
        "height_desktop": "adapt",
        "height_mobile": "adapt",
        "padding_top_desktop": 0,
        "padding_bottom_desktop": 32,
        "padding_top_mobile": 0,
        "padding_bottom_mobile": 24
      }
    }
  ]
}
{% endschema %}
