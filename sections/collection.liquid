<section class="collection-grid">
    <div class="page-width">
        <div class="collection-grid__wrapper">

            {% for block in section.blocks %}

                {% assign collection = block.settings.collection %}
                {% assign image = blank %}

                {% if collection.metafields.custom.collection_image != blank %}
                    {% assign image = collection.metafields.custom.collection_image %}
                {% elsif collection.image != blank %}
                    {% assign image = collection.image %}
                {% elsif block.settings.fallback_image != blank %}
                    {% assign image = block.settings.fallback_image %}
                {% endif %}

                {% if collection != blank %}
                    <a
                        href="{{ collection.url }}"
                        class="collection-card"
                        {{ block.shopify_attributes }}
                    >

                        {% if image %}
                            {{
                                image
                                | image_url: width: 900
                                | image_tag:
                                    loading: 'lazy',
                                    class: 'collection-card__image'
                            }}
                        {% endif %}

                        <div class="collection-card__content">
                            <h3>{{ collection.title }}</h3>
                        </div>

                    </a>
                {% endif %}

            {% endfor %}

        </div>
    </div>
</section>

<style>
    .collection-grid{
    padding:60px 0;
}

.collection-grid__wrapper{
    display:grid;
    grid-template-columns:repeat(4,1fr);
    gap:20px;
}

.collection-card{
    position:relative;
    display:block;
    overflow:hidden;
    text-decoration:none;
    aspect-ratio:0.73;
}

.collection-card img{
    width:100%;
    height:100%;
    object-fit:cover;
    transition:.4s;
}

.collection-card:hover img{
    transform:scale(1.05);
}

.collection-card__content{
    position:absolute;
    left:0;
    right:0;
    bottom:0;
    padding:24px;
    text-align:center;
    color:#fff;
}

.collection-card__content h3{
    margin:0;
    font-size:22px;
    font-weight:400;
    letter-spacing:.08em;
    text-transform:uppercase;
}

/* Tablet */

@media(max-width:990px){

.collection-grid__wrapper{
    grid-template-columns:repeat(2,1fr);
    gap:16px;
}

.collection-grid{
    padding:40px 0;
}

}

/* Mobile */

@media(max-width:749px){

.collection-grid__wrapper{
    grid-template-columns:1fr;
    gap:14px;
}

.collection-card{
    aspect-ratio:0.72;
}

.collection-card__content{
    padding:18px;
}

.collection-card__content h3{
    font-size:16px;
}

}
</style>

{
  "name": "Collection Grid",
  "blocks": [
    {
      "type": "collection",
      "name": "Collection",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection"
        },
        {
          "type": "image_picker",
          "id": "fallback_image",
          "label": "Fallback Image"
        }
      ]
    }
  ],
  "max_blocks": 12,
  "presets": [
    {
      "name": "Collection Grid"
    }
  ]
}