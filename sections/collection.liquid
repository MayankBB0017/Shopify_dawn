<section class="collection-grid">
  <div class="collection-grid__wrapper">
    {% for block in section.blocks %}
      <a
        href="{{ block.settings.link | default: '#' }}"
        class="collection-card"
        {{ block.shopify_attributes }}
      >
        {% if block.settings.image != blank %}
          {{
            block.settings.image
            | image_url: width: 900
            | image_tag:
              loading: 'lazy',
              class: 'collection-card__image'
          }}
        {% endif %}

        <div class="collection-card__content">
          <h3>{{ block.settings.title }}</h3>
        </div>
      </a>
    {% endfor %}
  </div>
</section>
<style>
    .collection-grid{
    padding:60px 0;
}

.collection-grid__wrapper{
    display:grid;
    grid-template-columns:repeat(4,1fr);
    gap:20px;
}

.collection-card{
    position:relative;
    display:block;
    overflow:hidden;
    text-decoration:none;
    aspect-ratio:0.73;
}

.collection-card img{
    width:100%;
    height:100%;
    object-fit:cover;
    transition:.4s;
}

.collection-card:hover img{
    transform:scale(1.05);
}

.collection-card__content{
    position:absolute;
    left:0;
    right:0;
    bottom:0;
    padding:24px;
    text-align:center;
    color:#fff;
}

.collection-card__content h3{
    margin:0;
    font-size:22px;
    font-weight:400;
    letter-spacing:.08em;
    text-transform:uppercase;
}

/* Tablet */

@media(max-width:990px){

.collection-grid__wrapper{
    grid-template-columns:repeat(2,1fr);
    gap:16px;
}

.collection-grid{
    padding:40px 0;
}

}

/* Mobile */

@media(max-width:749px){

.collection-grid__wrapper{
    grid-template-columns:1fr;
    gap:14px;
}

.collection-card{
    aspect-ratio:0.72;
}

.collection-card__content{
    padding:18px;
}

.collection-card__content h3{
    font-size:16px;
}

}
</style>
{%  schema %}
{
  "name": "Collection Showcase",
  "blocks": [
    {
      "type": "item",
      "name": "Card",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "BIKINIS TOP TRIÁNGULO"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "max_blocks": 12,
  "presets": [
    {
      "name": "Collection Showcase"
    }
  ]
}
{% endschema %}