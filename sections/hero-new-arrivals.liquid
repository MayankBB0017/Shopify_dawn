<section class="hero-new-arrivals">
  <div class="hero-wrapper">
    <div class="hero-image">
      {% if section.settings.hero_image != blank %}
        <img
          src="{{ section.settings.hero_image | image_url: width: 2000 }}"
          alt="{{ section.settings.hero_image.alt | escape }}"
          loading="lazy"
        >
      {% else %}
        <div class="hero-placeholder">Upload an image</div>
      {% endif %}
    </div>

    <div class="hero-content">
      <h2>{{ section.settings.heading }}</h2>

      <div class="hero-links">
        {% if section.settings.link_1_text != blank %}
          <a href="{{ section.settings.link_1_url }}" class="hero-link">
            {{ section.settings.link_1_text }}
          </a>
        {% endif %}

        {% if section.settings.link_2_text != blank %}
          <a href="{{ section.settings.link_2_url }}" class="hero-link">
            {{ section.settings.link_2_text }}
          </a>
        {% endif %}
      </div>
    </div>
  </div>
</section>

<style>

/* Responsive */
@media (max-width: 768px) {
  .hero-wrapper {
    min-height: 70vh;
  }

  .hero-content h2 {
    font-size: 2rem;
  }

  .hero-links {
    gap: 1.2rem;
  }
}

@media (max-width: 480px) {
  .hero-wrapper {
    min-height: 60vh;
  }

  .hero-content h2 {
    font-size: 1.6rem;
  }
}
</style>

{% schema %}
{
  "name": "Hero – New Arrivals",
  "settings": [
    {
      "type": "image_picker",
      "id": "hero_image",
      "label": "Hero image"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "New arrivals"
    },
    {
      "type": "text",
      "id": "link_1_text",
      "label": "First link text",
      "default": "Optional link"
    },
    {
      "type": "url",
      "id": "link_1_url",
      "label": "First link URL"
    },
    {
      "type": "text",
      "id": "link_2_text",
      "label": "Second link text",
      "default": "Optional link"
    },
    {
      "type": "url",
      "id": "link_2_url",
      "label": "Second link URL"
    }
  ],
  "presets": [
    {
      "name": "Hero – New Arrivals"
    }
  ]
}
{% endschema %}
