<section class="hero-new-arrivals">
  <div class="hero-wrapper">
    <div class="hero-image">
      {% if section.settings.hero_image != blank %}
        <img
          src="{{ section.settings.hero_image | image_url: width: 2000 }}"
          alt="{{ section.settings.hero_image.alt | escape }}"
          loading="lazy"
        >
      {% else %}
        <div class="hero-placeholder">Upload an image</div>
      {% endif %}
    </div>

    <div class="hero-content">
      <h2>{{ section.settings.heading }}</h2>

      <div class="hero-links">
        {% if section.settings.link_1_text != blank %}
          <a href="{{ section.settings.link_1_url }}" class="hero-link">
            {{ section.settings.link_1_text }}
          </a>
        {% endif %}

        {% if section.settings.link_2_text != blank %}
          <a href="{{ section.settings.link_2_url }}" class="hero-link">
            {{ section.settings.link_2_text }}
          </a>
        {% endif %}
      </div>
    </div>
  </div>
</section>

<style>
.hero-new-arrivals {
  width: 100%;
  position: relative;
}

.hero-wrapper {
  position: relative;
  width: 100%;
  min-height: 80vh;
  overflow: hidden;
}

.hero-image img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  position: absolute;
  inset: 0;
}

.hero-placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  background: #eee;
  height: 80vh;
  color: #666;
}

.hero-content {
  position: absolute;
  bottom: 8%;
  left: 50%;
  transform: translateX(-50%);
  text-align: center;
  color: #fff;
  z-index: 2;
}

.hero-content h2 {
  font-size: 3rem;
  font-weight: 500;
  margin-bottom: 1rem;
}

.hero-links {
  display: flex;
  gap: 2rem;
  justify-content: center;
}

.hero-link {
  font-size: 0.85rem;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  color: #fff;
  text-decoration: none;
  border-bottom: 1px solid rgba(255,255,255,0.6);
  padding-bottom: 4px;
  transition: opacity 0.3s ease;
}

.hero-link:hover {
  opacity: 0.7;
}

/* Responsive */
@media (max-width: 768px) {
  .hero-wrapper {
    min-height: 70vh;
  }

  .hero-content h2 {
    font-size: 2rem;
  }

  .hero-links {
    gap: 1.2rem;
  }
}

@media (max-width: 480px) {
  .hero-wrapper {
    min-height: 60vh;
  }

  .hero-content h2 {
    font-size: 1.6rem;
  }
}
</style>

{% schema %}
{
  "name": "Hero – New Arrivals",
  "settings": [
    {
      "type": "image_picker",
      "id": "hero_image",
      "label": "Hero image"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "New arrivals"
    },
    {
      "type": "text",
      "id": "link_1_text",
      "label": "First link text",
      "default": "Optional link"
    },
    {
      "type": "url",
      "id": "link_1_url",
      "label": "First link URL"
    },
    {
      "type": "text",
      "id": "link_2_text",
      "label": "Second link text",
      "default": "Optional link"
    },
    {
      "type": "url",
      "id": "link_2_url",
      "label": "Second link URL"
    }
  ],
  "presets": [
    {
      "name": "Hero – New Arrivals"
    }
  ]
}
{% endschema %}
