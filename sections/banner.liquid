<section id="editorial-{{ section.id }}" class="editorial-banner">
  <div class="editorial-wrapper">

    <!-- Left -->
    <div class="editorial-item">
      {% if section.settings.left_image != blank %}
        {{
          section.settings.left_image
          | image_url: width: 2000
          | image_tag:
          loading: 'lazy',
          class: 'editorial-image'
        }}
      {% else %}
        {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg' }}
      {% endif %}

      {% if section.settings.left_text != blank %}
        <div class="editorial-label">
          {{ section.settings.left_text }}
        </div>
      {% endif %}
    </div>

    <!-- Right -->
    <div class="editorial-item">
      {% if section.settings.right_image != blank %}
        {{
          section.settings.right_image
          | image_url: width: 2000
          | image_tag:
          loading: 'lazy',
          class: 'editorial-image'
        }}
      {% else %}
        {{ 'lifestyle-2' | placeholder_svg_tag: 'placeholder-svg' }}
      {% endif %}

      {% if section.settings.right_text != blank %}
        <div class="editorial-label">
          {{ section.settings.right_text }}
        </div>
      {% endif %}
    </div>

  </div>
</section>

<style>
/* Full Width */
#shopify-section-{{ section.id }}{
    width:100vw;
    max-width:100vw;
    margin-left:calc(50% - 50vw);
    margin-right:calc(50% - 50vw);
    padding:0;
}

#editorial-{{ section.id }}{
    width:100%;
    background:#fff;
}

#editorial-{{ section.id }} .editorial-wrapper{
    display:grid;
    grid-template-columns:repeat(2,1fr);
    width:100%;
    gap:0;
}

#editorial-{{ section.id }} .editorial-item{
    position:relative;
    overflow:hidden;
    aspect-ratio:1 / 1.25;
    background:#f5f5f5;
}

#editorial-{{ section.id }} .editorial-image{
    width:100%;
    height:100%;
    object-fit:cover;
    display:block;
}

#editorial-{{ section.id }} .editorial-label{
    position:absolute;
    top:18px;
    left:18px;
    color:#fff;
    font-size:11px;
    font-weight:500;
    letter-spacing:2px;
    text-transform:uppercase;
    z-index:2;
}

.placeholder-svg{
    width:100%;
    height:100%;
}

/* Tablet */
@media screen and (max-width:990px){

#editorial-{{ section.id }} .editorial-item{
    aspect-ratio:4 / 5;
}

}

/* Mobile */
@media screen and (max-width:749px){

#editorial-{{ section.id }} .editorial-wrapper{
    display:flex;
    flex-direction:column;
}

#editorial-{{ section.id }} .editorial-item{
    width:100%;
    aspect-ratio:9 / 16;
}

#editorial-{{ section.id }} .editorial-label{
    top:14px;
    left:14px;
    font-size:10px;
}

}
</style>

{% schema %}
{
  "name": "Editorial Split Banner",
  "settings": [
    {
      "type": "image_picker",
      "id": "left_image",
      "label": "Left Image"
    },
    {
      "type": "text",
      "id": "left_text",
      "label": "Left Label",
      "default": "INTIMATES"
    },
    {
      "type": "image_picker",
      "id": "right_image",
      "label": "Right Image"
    },
    {
      "type": "text",
      "id": "right_text",
      "label": "Right Label",
      "default": "ROBIN MAN"
    }
  ],
  "presets": [
    {
      "name": "Editorial Split Banner"
    }
  ]
}
{% endschema %}