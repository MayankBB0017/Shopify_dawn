<section class="editorial-banner">
  <div class="editorial-wrapper">

    <!-- Left -->
    <div class="editorial-item">
      {% if section.settings.left_image != blank %}
        {{
          section.settings.left_image
          | image_url: width: 1800
          | image_tag:
          loading: 'lazy',
          class: 'editorial-image'
        }}
      {% else %}
        {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg' }}
      {% endif %}

      {% if section.settings.left_text != blank %}
        <div class="editorial-label">
          {{ section.settings.left_text }}
        </div>
      {% endif %}
    </div>

    <!-- Right -->
    <div class="editorial-item">
      {% if section.settings.right_image != blank %}
        {{
          section.settings.right_image
          | image_url: width: 1800
          | image_tag:
          loading: 'lazy',
          class: 'editorial-image'
        }}
      {% else %}
        {{ 'lifestyle-2' | placeholder_svg_tag: 'placeholder-svg' }}
      {% endif %}

      {% if section.settings.right_text != blank %}
        <div class="editorial-label">
          {{ section.settings.right_text }}
        </div>
      {% endif %}
    </div>

  </div>
</section>

<style>
.editorial-banner{
    padding:40px 20px;
    background:#f5f5f5;
}

.editorial-wrapper{
    max-width:1200px;
    margin:auto;
    display:grid;
    grid-template-columns:repeat(2,1fr);
    gap:0;
    background:#fff;
}

.editorial-item{
    position:relative;
    overflow:hidden;
    display:flex;
    align-items:center;
    justify-content:center;
    min-height:650px;
}

.editorial-image{
    width:100%;
    height:100%;
    object-fit:contain; /* Full image visible */
    display:block;
}

.editorial-label{
    position:absolute;
    top:18px;
    left:18px;
    color:#fff;
    font-size:11px;
    letter-spacing:2px;
    text-transform:uppercase;
    z-index:2;
}

.placeholder-svg{
    width:100%;
    height:100%;
}

@media(max-width:768px){

.editorial-wrapper{
    grid-template-columns:1fr;
}

.editorial-item{
    min-height:450px;
}

}
</style>

{% schema %}
{
  "name": "Editorial Split Banner",
  "settings": [
    {
      "type": "image_picker",
      "id": "left_image",
      "label": "Left Image"
    },
    {
      "type": "text",
      "id": "left_text",
      "label": "Left Label",
      "default": "INTIMATES"
    },
    {
      "type": "image_picker",
      "id": "right_image",
      "label": "Right Image"
    },
    {
      "type": "text",
      "id": "right_text",
      "label": "Right Label",
      "default": "ROBIN MAN"
    }
  ],
  "presets": [
    {
      "name": "Editorial Split Banner"
    }
  ]
}
{% endschema %}