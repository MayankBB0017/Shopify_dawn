<section class="bs-slider">

  <div class="bs-slider__header">

    <div class="bs-slider__left">
      <h2>{{ section.settings.heading }}</h2>

      <div class="bs-slider__tabs">
        <span class="active">{{ section.settings.tab1 }}</span>
        <span>{{ section.settings.tab2 }}</span>
        <span>{{ section.settings.tab3 }}</span>
      </div>
    </div>

    <div class="bs-slider__nav">
      <button class="bs-prev">
        {% if section.settings.arrow_left != blank %}
          {{
            section.settings.arrow_left
            | image_url: width: 40
            | image_tag
          }}
        {% else %}
          &#10094;
        {% endif %}
      </button>

      <button class="bs-next">
        {% if section.settings.arrow_right != blank %}
          {{
            section.settings.arrow_right
            | image_url: width: 40
            | image_tag
          }}
        {% else %}
          &#10095;
        {% endif %}
      </button>
    </div>

  </div>

  <div class="swiper bs-swiper">

    <div class="swiper-wrapper">

      {% for block in section.blocks %}

      <div class="swiper-slide">

        <div class="bs-card">

          {% if block.settings.badge != blank %}
            <span class="bs-badge">{{ block.settings.badge }}</span>
          {% endif %}

          <div class="bs-image">

            {% if block.settings.image != blank %}
              {{
                block.settings.image
                | image_url: width: 900
                | image_tag:
                loading: 'lazy',
                class: 'bs-img'
              }}
            {% endif %}

          </div>

          <div class="bs-info">

            <div class="bs-title-row">

              <div class="bs-title">
                {{ block.settings.title }}
              </div>

              {% if section.settings.bookmark != blank %}
                {{
                  section.settings.bookmark
                  | image_url: width: 22
                  | image_tag:
                  class: 'bs-bookmark'
                }}
              {% endif %}

            </div>

            <div class="bs-price-row">

              <span class="price">
                {{ block.settings.price }}
              </span>

              {% if block.settings.compare_price != blank %}
                <span class="compare">
                  {{ block.settings.compare_price }}
                </span>
              {% endif %}

              {% if block.settings.discount != blank %}
                <span class="discount">
                  {{ block.settings.discount }}
                </span>
              {% endif %}

            </div>

          </div>

        </div>

      </div>

      {% endfor %}

    </div>

  </div>

</section>

<style>

.bs-slider{
    width:100%;
    padding:50px 0;
    background:#fff;
}

.bs-slider__header{
    display:flex;
    justify-content:space-between;
    align-items:center;
    margin-bottom:28px;
}

.bs-slider__left{
    display:flex;
    align-items:center;
    gap:30px;
    display : none;
}

.bs-slider__header h2{
    font-size:32px;
    font-weight:400;
    color:#111;
}

.bs-slider__tabs{
    display:flex;
    gap:22px;
}

.bs-slider__tabs span{
    font-size:11px;
    letter-spacing:1.5px;
    color:#777;
    cursor:pointer;
    text-transform:uppercase;
}

.bs-slider__tabs .active{
    color:#111;
    border-bottom:1px solid #111;
    padding-bottom:2px;
}

.bs-slider__nav{
    display:flex;
    gap:12px;
    display : none;
}

.bs-prev,
.bs-next{
    width:42px;
    height:42px;
    border:none;
    background:#fff;
    cursor:pointer;
    display:flex;
    justify-content:center;
    align-items:center;
    transition:.3s;
}

.bs-prev:hover,
.bs-next:hover{
    background:#f5f5f5;
}

.bs-prev img,
.bs-next img{
    width:18px;
}

.bs-swiper{
    overflow:hidden;
}

.bs-card{
    position:relative;
    background:#fff;
}

.bs-badge{
    position:absolute;
    top:12px;
    left:12px;
    font-size:10px;
    color:#555;
    text-transform:uppercase;
    z-index:5;
}

.bs-image{
    width:100%;
    aspect-ratio:3/4;
    {% comment %} background:#fafafa; {% endcomment %}
    overflow:hidden;
}

.bs-img{
    width:100%;
    height:100%;
    object-fit:contain;
    transition:.45s;
}

.bs-card:hover .bs-img{
    transform:scale(1.04);
}

.bs-info{
    padding:10px 21px 0;
}

.bs-title-row{
    display:flex;
    justify-content:space-between;
    align-items:flex-start;
    gap:10px;
}

.bs-title{
    flex:1;
    font-size:12px;
    font-weight:400;
    line-height:1.4;
    color:#222;
}

.bs-bookmark{
    width:12px;
    height:12px;
    object-fit:contain;
    margin-top:2px;
    cursor:pointer;
}

.bs-price-row{
    display:flex;
    gap:6px;
    align-items:center;
    margin-top:6px;
}

.price{
    font-size:12px;
    color:#111;
}

.compare{
    font-size:11px;
    color:#9c9c9c;
    text-decoration:line-through;
}

.discount{
    font-size:11px;
    color:#c59b48;
}

/* Swiper Slides */

.bs-swiper .swiper-slide{
    width:20%;
}

/* Tablet */

@media(max-width:990px){

.bs-slider__header{
    flex-direction:column;
    align-items:flex-start;
    gap:20px;
}

.bs-slider__left{
    flex-direction:column;
    align-items:flex-start;
    display : none;
    gap:12px;
}

.bs-swiper .swiper-slide{
    width:33.333%;
}

}

/* Mobile */

@media(max-width:767px){

.bs-slider{
    padding:35px 15px;
}

.bs-slider__header h2{
    font-size:26px;
}

.bs-slider__tabs{
    gap:14px;
}

.bs-slider__tabs span{
    font-size:10px;
}

.bs-swiper .swiper-slide{
    width:50%;
}

.bs-title{
    font-size:11px;
}

.price,
.compare,
.discount{
    font-size:10px;
}

.bs-bookmark{
    width:10px;
    height:10px;
}

}

</style>

<script>
document.addEventListener('DOMContentLoaded', function () {
  new Swiper('.bs-swiper', {
    slidesPerView: 5,
    spaceBetween: 18,
    speed: 600,

    navigation: {
      nextEl: '.bs-next',
      prevEl: '.bs-prev'
    },

    breakpoints: {
      320: {
        slidesPerView: 2,
        spaceBetween: 12
      },
      768: {
        slidesPerView: 3,
        spaceBetween: 16
      },
      1200: {
        slidesPerView: 5,
        spaceBetween: 18
      }
    }
  });
});
</script>

{% schema %}
{
  "name": "Best Sellers Slider",
  "tag": "section",
  "class": "best-sellers-slider",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Best sellers:"
    },
    {
      "type": "text",
      "id": "tab1",
      "label": "Tab 1",
      "default": "SWIMWEAR"
    },
    {
      "type": "text",
      "id": "tab2",
      "label": "Tab 2",
      "default": "INTIMATES"
    },
    {
      "type": "text",
      "id": "tab3",
      "label": "Tab 3",
      "default": "ACCESSORIES"
    },
    {
      "type": "image_picker",
      "id": "bookmark",
      "label": "Bookmark Icon"
    },
    {
      "type": "image_picker",
      "id": "arrow_left",
      "label": "Left Arrow Icon"
    },
    {
      "type": "image_picker",
      "id": "arrow_right",
      "label": "Right Arrow Icon"
    }
  ],
  "blocks": [
    {
      "type": "product",
      "name": "Product Card",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Product Image"
        },
        {
          "type": "text",
          "id": "badge",
          "label": "Badge",
          "default": "NEW"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Bikini Balconette Butterfly braga clásica lazo"
        },
        {
          "type": "text",
          "id": "price",
          "label": "Price",
          "default": "17.99€"
        },
        {
          "type": "text",
          "id": "compare_price",
          "label": "Compare Price",
          "default": "21.99€"
        },
        {
          "type": "text",
          "id": "discount",
          "label": "Discount",
          "default": "15%"
        }
      ]
    }
  ],
  "max_blocks": 12,
  "presets": [
    {
      "name": "Best Sellers Slider",
      "blocks": [
        { "type": "product" },
        { "type": "product" },
        { "type": "product" },
        { "type": "product" },
        { "type": "product" }
      ]
    }
  ]
}
{% endschema %}