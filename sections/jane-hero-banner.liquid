{{ 'section-jane-hero-banner.css' | asset_url | stylesheet_tag }}
<script src="{{ 'jane-hero-banner.js' | asset_url }}" defer="defer"></script>

{%- liquid
  assign slide_total = 0
  for block in section.blocks
    if block.type == 'slide'
      assign slide_total = slide_total | plus: 1
    endif
  endfor

  assign content_source = section.settings.content_source | default: 'manual'
  assign show_metafield_notice = false
  assign show_metaobject_notice = false

  if content_source == 'product_metafield'
    if request.page_type == 'product' and product != blank
      assign metafield_ref = section.settings.product_metafield | strip
      if metafield_ref != blank
        assign mf_parts = metafield_ref | split: '.'
        if mf_parts.size == 2
          assign mf_namespace = mf_parts[0]
          assign mf_key = mf_parts[1]
          assign hero_metafield = product.metafields[mf_namespace][mf_key]
          if hero_metafield == blank or hero_metafield.value == blank
            assign show_metafield_notice = true
          endif
        else
          assign show_metafield_notice = true
        endif
      else
        assign show_metafield_notice = true
      endif
    endif
  elsif content_source == 'metaobject'
    if section.settings.metaobject == blank
      assign show_metaobject_notice = true
    endif
  endif

  assign autoplay_active = false
  if section.settings.autoplay and slide_total >= 2
    assign autoplay_active = true
  endif
-%}

{%- style -%}
  #JaneHeroBanner-{{ section.id }} {
    padding-top: {{ section.settings.padding_top_mobile }}px;
    padding-bottom: {{ section.settings.padding_bottom_mobile }}px;
  }

  @media screen and (min-width: 750px) {
    #JaneHeroBanner-{{ section.id }} {
      padding-top: {{ section.settings.padding_top_desktop }}px;
      padding-bottom: {{ section.settings.padding_bottom_desktop }}px;
    }
  }
{%- endstyle -%}

<jane-hero-banner
  id="JaneHeroBanner-{{ section.id }}"
  class="jane-hero-banner jane-hero-banner--height-desktop-{{ section.settings.height_desktop }} jane-hero-banner--height-mobile-{{ section.settings.height_mobile }}{% if section.settings.enable_fade_in_desktop %} jane-hero-banner--fade-in-desktop{% endif %}{% if section.settings.enable_fade_in_mobile %} jane-hero-banner--fade-in-mobile{% endif %}{% if section.settings.enable_transparent_header %} jane-hero-banner--transparent-header{% endif %}{% if request.design_mode %} jane-hero-banner--fade-visible{% endif %}"
  role="region"
  aria-roledescription="{{ 'sections.jane_hero_banner.carousel' | t }}"
  aria-label="{{ section.settings.accessibility_label | escape }}"
  tabindex="0"
  data-autoplay="{{ autoplay_active }}"
  data-speed="{{ section.settings.autoplay_speed }}"
>
  <div class="jane-hero-banner__stage">
  {%- if show_metafield_notice -%}
    <div class="jane-hero__notice jane-hero__notice--metafield" role="status">
      {{ 'sections.jane_hero_banner.metafield_empty' | t }}
    </div>
  {%- endif -%}

  {%- if show_metaobject_notice -%}
    <div class="jane-hero__notice jane-hero__notice--metaobject" role="status">
      {{ 'sections.jane_hero_banner.metaobject_empty' | t }}
    </div>
  {%- endif -%}

  <div
    id="JaneHeroSlider-{{ section.id }}"
    class="jane-hero__slider"
    aria-live="polite"
    aria-atomic="true"
  >
    {%- assign slide_index = 0 -%}
    {%- for block in section.blocks -%}
      {%- if block.type == 'slide' -%}
        {%- assign slide_index = slide_index | plus: 1 -%}
        {% render 'jane-hero-slide',
          block: block,
          section: section,
          slide_index: slide_index,
          slide_total: slide_total
        %}
      {%- endif -%}
    {%- endfor -%}
  </div>

  {%- if slide_total >= 2 -%}
    <div class="jane-hero__controls">
      {%- assign bullet_index = 0 -%}
      {%- for block in section.blocks -%}
        {%- if block.type == 'slide' -%}
          <button
            type="button"
            class="jane-hero__bullet{% if bullet_index == 0 %} jane-hero__bullet--active{% endif %}"
            aria-label="{{ 'sections.jane_hero_banner.load_slide' | t }} {{ bullet_index | plus: 1 }} {{ 'general.slider.of' | t }} {{ slide_total }}"
            aria-controls="JaneHeroSlider-{{ section.id }}"
            aria-current="{% if bullet_index == 0 %}true{% else %}false{% endif %}"
            data-slide-index="{{ bullet_index }}"
          >
            <span class="visually-hidden">{{ bullet_index | plus: 1 }}</span>
          </button>
          {%- assign bullet_index = bullet_index | plus: 1 -%}
        {%- endif -%}
      {%- endfor -%}
    </div>
  {%- endif -%}
  </div>
</jane-hero-banner>

{%- if request.design_mode -%}
  <script src="{{ 'theme-editor.js' | asset_url }}" defer="defer"></script>
{%- endif -%}

