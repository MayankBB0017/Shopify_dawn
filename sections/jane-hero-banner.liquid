{% comment %}
  JANÉ Hero Banner — Dawn 15.4.1
  Add this section from the Theme Editor. Add up to five "Slide" blocks.
{% endcomment %}
{{ 'jane-hero-banner.css' | asset_url | stylesheet_tag }}
<script src="{{ 'jane-hero-banner.js' | asset_url }}" defer="defer"></script>

{%- liquid
  assign section_height_desktop = section.settings.height_desktop
  assign section_height_mobile = section.settings.height_mobile
-%}

<section
  id="JaneHero-{{ section.id }}"
  class="jane-hero jane-hero--{{ section.settings.layout }} jane-hero--height-d-{{ section_height_desktop | handle }} jane-hero--height-m-{{ section_height_mobile | handle }}{% if section.settings.fit_screen %} jane-hero--fit-screen{% endif %}"
  data-jane-hero
  data-autoplay="{{ section.settings.autoplay }}"
  data-autoplay-speed="{{ section.settings.autoplay_speed | times: 1000 }}"
  data-fade="{{ section.settings.fade_slides }}"
  style="
    --jhb-content-max: {{ section.settings.content_max_width }}px;
    --jhb-pad-top: {{ section.settings.padding_top }}px;
    --jhb-pad-bottom: {{ section.settings.padding_bottom }}px;
    --jhb-title-size: {{ section.settings.title_size }}px;
    --jhb-title-size-mobile: {{ section.settings.title_size_mobile }}px;
    --jhb-body-size: {{ section.settings.body_size }}px;
    --jhb-body-size-mobile: {{ section.settings.body_size_mobile }}px;
    --jhb-text-color: {{ section.settings.default_text_color }};
    --jhb-section-bg: {{ section.settings.section_background }};
  "
>
  {%- if section.blocks.size > 0 -%}
    <div class="jane-hero__slides" aria-live="polite">
      {%- for block in section.blocks -%}
        {%- liquid
          assign slide_layout = section.settings.layout
          assign desktop_image = block.settings.desktop_image
          assign mobile_image = block.settings.mobile_image
          assign desktop_video = block.settings.desktop_video
          assign mobile_video = block.settings.mobile_video
          assign has_media = false
          if desktop_image != blank or desktop_video != blank
            assign has_media = true
          endif
        -%}
        <article
          class="jane-hero__slide{% if forloop.first %} is-active{% endif %}"
          data-jane-slide
          data-slide-index="{{ forloop.index0 }}"
          {{ block.shopify_attributes }}
        >
          {%- if slide_layout == 'split' -%}
            <div class="jane-hero__split">
              {%- for pane in (1..2) -%}
                {%- liquid
                  if pane == 1
                    assign pane_image = block.settings.left_image | default: block.settings.desktop_image
                    assign pane_mobile_image = block.settings.left_mobile_image | default: block.settings.mobile_image | default: pane_image
                    assign pane_video = block.settings.left_video | default: block.settings.desktop_video
                    assign pane_mobile_video = block.settings.left_mobile_video | default: block.settings.mobile_video | default: pane_video
                    assign pane_title = block.settings.left_title
                    assign pane_description = block.settings.left_description
                    assign pane_overlay = block.settings.left_overlay
                    assign pane_gradient = block.settings.left_gradient
                    assign pane_text_color = block.settings.left_text_color
                    assign pane_position = block.settings.left_position
                    assign pane_position_mobile = block.settings.left_position_mobile
                    assign pane_alignment = block.settings.left_alignment
                    assign pane_title_size = block.settings.left_title_size
                    assign pane_title_size_mobile = block.settings.left_title_size_mobile
                    assign pane_button_1_label = block.settings.left_button_1_label
                    assign pane_button_1_link = block.settings.left_button_1_link
                    assign pane_button_1_type = block.settings.left_button_1_type
                    assign pane_button_1_bg = block.settings.left_button_1_bg
                    assign pane_button_1_color = block.settings.left_button_1_color
                    assign pane_button_1_border = block.settings.left_button_1_border
                    assign pane_button_2_label = block.settings.left_button_2_label
                    assign pane_button_2_link = block.settings.left_button_2_link
                    assign pane_button_2_type = block.settings.left_button_2_type
                    assign pane_button_2_bg = block.settings.left_button_2_bg
                    assign pane_button_2_color = block.settings.left_button_2_color
                    assign pane_button_2_border = block.settings.left_button_2_border
                  else
                    assign pane_image = block.settings.right_image | default: block.settings.desktop_image
                    assign pane_mobile_image = block.settings.right_mobile_image | default: block.settings.mobile_image | default: pane_image
                    assign pane_video = block.settings.right_video | default: block.settings.desktop_video
                    assign pane_mobile_video = block.settings.right_mobile_video | default: block.settings.mobile_video | default: pane_video
                    assign pane_title = block.settings.right_title
                    assign pane_description = block.settings.right_description
                    assign pane_overlay = block.settings.right_overlay
                    assign pane_gradient = block.settings.right_gradient
                    assign pane_text_color = block.settings.right_text_color
                    assign pane_position = block.settings.right_position
                    assign pane_position_mobile = block.settings.right_position_mobile
                    assign pane_alignment = block.settings.right_alignment
                    assign pane_title_size = block.settings.right_title_size
                    assign pane_title_size_mobile = block.settings.right_title_size_mobile
                    assign pane_button_1_label = block.settings.right_button_1_label
                    assign pane_button_1_link = block.settings.right_button_1_link
                    assign pane_button_1_type = block.settings.right_button_1_type
                    assign pane_button_1_bg = block.settings.right_button_1_bg
                    assign pane_button_1_color = block.settings.right_button_1_color
                    assign pane_button_1_border = block.settings.right_button_1_border
                    assign pane_button_2_label = block.settings.right_button_2_label
                    assign pane_button_2_link = block.settings.right_button_2_link
                    assign pane_button_2_type = block.settings.right_button_2_type
                    assign pane_button_2_bg = block.settings.right_button_2_bg
                    assign pane_button_2_color = block.settings.right_button_2_color
                    assign pane_button_2_border = block.settings.right_button_2_border
                  endif
                -%}
                <div class="jane-hero__pane jane-hero__pane--{{ pane }} jane-hero__position--{{ pane_position }} jane-hero__mobile-position--{{ pane_position_mobile }}"
                  style="--jhb-pane-overlay: {{ pane_overlay | divided_by: 100.0 }}; --jhb-pane-text: {{ pane_text_color }}; --jhb-pane-title: {{ pane_title_size }}px; --jhb-pane-title-mobile: {{ pane_title_size_mobile }}px; --jhb-pane-align: {{ pane_alignment }};"
                >
                  <div class="jane-hero__media">
                    {%- if pane_video != blank -%}
                      {{ pane_video | video_tag: image_size: '2000x', autoplay: true, loop: true, muted: true, controls: false, class: 'jane-hero__video jane-hero__video--desktop' }}
                    {%- elsif pane_image != blank -%}
                      {{ pane_image | image_url: width: 2200 | image_tag: loading: 'lazy', widths: '750, 1100, 1500, 1800, 2200', class: 'jane-hero__image jane-hero__image--desktop', alt: pane_image.alt | escape }}
                    {%- else -%}
                      {{ 'lifestyle-1' | placeholder_svg_tag: 'jane-hero__placeholder' }}
                    {%- endif -%}
                    {%- if pane_mobile_video != blank -%}
                      {{ pane_mobile_video | video_tag: image_size: '1000x', autoplay: true, loop: true, muted: true, controls: false, class: 'jane-hero__video jane-hero__video--mobile' }}
                    {%- elsif pane_mobile_image != blank -%}
                      {{ pane_mobile_image | image_url: width: 1200 | image_tag: loading: 'lazy', widths: '375, 550, 750, 1000, 1200', class: 'jane-hero__image jane-hero__image--mobile', alt: pane_mobile_image.alt | escape }}
                    {%- elsif pane_video != blank -%}
                      {{ pane_video | video_tag: image_size: '1000x', autoplay: true, loop: true, muted: true, controls: false, class: 'jane-hero__video jane-hero__video--mobile' }}
                    {%- elsif pane_image != blank -%}
                      {{ pane_image | image_url: width: 1200 | image_tag: loading: 'lazy', widths: '375, 550, 750, 1000, 1200', class: 'jane-hero__image jane-hero__image--mobile', alt: pane_image.alt | escape }}
                    {%- endif -%}
                  </div>
                  <div class="jane-hero__overlay{% if pane_gradient %} has-gradient{% endif %}"></div>
                  <div class="jane-hero__content">
                    {%- if pane_title != blank -%}<h2 class="jane-hero__title">{{ pane_title | escape }}</h2>{%- endif -%}
                    {%- if pane_description != blank -%}<div class="jane-hero__description rte">{{ pane_description }}</div>{%- endif -%}
                    <div class="jane-hero__buttons">
                      {%- for button_number in (1..2) -%}
                        {%- liquid
                          if button_number == 1
                            assign btn_label = pane_button_1_label
                            assign btn_link = pane_button_1_link
                            assign btn_type = pane_button_1_type
                            assign btn_bg = pane_button_1_bg
                            assign btn_color = pane_button_1_color
                            assign btn_border = pane_button_1_border
                          else
                            assign btn_label = pane_button_2_label
                            assign btn_link = pane_button_2_link
                            assign btn_type = pane_button_2_type
                            assign btn_bg = pane_button_2_bg
                            assign btn_color = pane_button_2_color
                            assign btn_border = pane_button_2_border
                          endif
                        -%}
                        {%- if btn_label != blank -%}
                          <a class="jane-hero__button jane-hero__button--{{ btn_type }}" href="{{ btn_link | default: '#' }}"
                            {% if btn_type == 'custom' %}style="--jhb-btn-bg: {{ btn_bg }}; --jhb-btn-color: {{ btn_color }}; --jhb-btn-border: {{ btn_border }};"{% endif %}>
                            {{ btn_label | escape }}
                          </a>
                        {%- endif -%}
                      {%- endfor -%}
                    </div>
                  </div>
                </div>
              {%- endfor -%}
            </div>
          {%- else -%}
            <div class="jane-hero__single{% if slide_layout == 'image_text' %} jane-hero__single--image-text{% endif %}">
              <div class="jane-hero__media">
                {%- if desktop_video != blank -%}
                  {{ desktop_video | video_tag: image_size: '2000x', autoplay: true, loop: true, muted: true, controls: false, class: 'jane-hero__video jane-hero__video--desktop' }}
                {%- elsif desktop_image != blank -%}
                  {{ desktop_image | image_url: width: 2400 | image_tag: loading: 'lazy', widths: '750, 1100, 1500, 1800, 2200, 2400', class: 'jane-hero__image jane-hero__image--desktop', alt: desktop_image.alt | escape }}
                {%- else -%}
                  {{ 'lifestyle-1' | placeholder_svg_tag: 'jane-hero__placeholder' }}
                {%- endif -%}
                {%- if mobile_video != blank -%}
                  {{ mobile_video | video_tag: image_size: '1200x', autoplay: true, loop: true, muted: true, controls: false, class: 'jane-hero__video jane-hero__video--mobile' }}
                {%- elsif mobile_image != blank -%}
                  {{ mobile_image | image_url: width: 1400 | image_tag: loading: 'lazy', widths: '375, 550, 750, 1000, 1200, 1400', class: 'jane-hero__image jane-hero__image--mobile', alt: mobile_image.alt | escape }}
                {%- elsif desktop_video != blank -%}
                  {{ desktop_video | video_tag: image_size: '1200x', autoplay: true, loop: true, muted: true, controls: false, class: 'jane-hero__video jane-hero__video--mobile' }}
                {%- elsif desktop_image != blank -%}
                  {{ desktop_image | image_url: width: 1400 | image_tag: loading: 'lazy', widths: '375, 550, 750, 1000, 1200, 1400', class: 'jane-hero__image jane-hero__image--mobile', alt: desktop_image.alt | escape }}
                {%- endif -%}
              </div>
              <div class="jane-hero__overlay{% if block.settings.gradient_overlay %} has-gradient{% endif %}" style="--jhb-overlay: {{ block.settings.overlay_opacity | divided_by: 100.0 }};"></div>
              <div class="jane-hero__content jane-hero__position--{{ block.settings.content_position }} jane-hero__mobile-position--{{ block.settings.content_position_mobile }}"
                style="--jhb-pane-text: {{ block.settings.text_color }}; --jhb-pane-title: {{ block.settings.slide_title_size }}px; --jhb-pane-title-mobile: {{ block.settings.slide_title_size_mobile }}px; --jhb-pane-align: {{ block.settings.text_alignment }};">
                {%- if block.settings.title != blank -%}<h2 class="jane-hero__title">{{ block.settings.title | escape }}</h2>{%- endif -%}
                {%- if block.settings.description != blank -%}<div class="jane-hero__description rte">{{ block.settings.description }}</div>{%- endif -%}
                <div class="jane-hero__buttons">
                  {%- for button_number in (1..2) -%}
                    {%- liquid
                      if button_number == 1
                        assign btn_label = block.settings.button_1_label
                        assign btn_link = block.settings.button_1_link
                        assign btn_type = block.settings.button_1_type
                        assign btn_bg = block.settings.button_1_bg
                        assign btn_color = block.settings.button_1_color
                        assign btn_border = block.settings.button_1_border
                      else
                        assign btn_label = block.settings.button_2_label
                        assign btn_link = block.settings.button_2_link
                        assign btn_type = block.settings.button_2_type
                        assign btn_bg = block.settings.button_2_bg
                        assign btn_color = block.settings.button_2_color
                        assign btn_border = block.settings.button_2_border
                      endif
                    -%}
                    {%- if btn_label != blank -%}
                      <a class="jane-hero__button jane-hero__button--{{ btn_type }}" href="{{ btn_link | default: '#' }}"
                        {% if btn_type == 'custom' %}style="--jhb-btn-bg: {{ btn_bg }}; --jhb-btn-color: {{ btn_color }}; --jhb-btn-border: {{ btn_border }};"{% endif %}>
                        {{ btn_label | escape }}
                      </a>
                    {%- endif -%}
                  {%- endfor -%}
                </div>
              </div>
            </div>
          {%- endif -%}
        </article>
      {%- endfor -%}
    </div>
    {%- if section.blocks.size > 1 -%}
      <div class="jane-hero__controls" aria-label="Slider controls">
        <button class="jane-hero__arrow jane-hero__arrow--prev" type="button" aria-label="Previous slide" data-jane-prev>‹</button>
        <div class="jane-hero__dots">
          {%- for block in section.blocks -%}
            <button class="jane-hero__dot{% if forloop.first %} is-active{% endif %}" type="button" aria-label="Go to slide {{ forloop.index }}" data-jane-dot="{{ forloop.index0 }}"></button>
          {%- endfor -%}
        </div>
        <button class="jane-hero__arrow jane-hero__arrow--next" type="button" aria-label="Next slide" data-jane-next>›</button>
      </div>
    {%- endif -%}
  {%- else -%}
    <div class="jane-hero__empty">
      <p>Add up to five Slide blocks to build your hero banner.</p>
    </div>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "JANÉ hero banner",
  "tag": "section",
  "class": "section jane-hero-section",
  "settings": [
    {
      "type": "select",
      "id": "layout",
      "label": "Slide layout",
      "options": [
        { "value": "full", "label": "Full width" },
        { "value": "split", "label": "50-50 split" },
        { "value": "image_text", "label": "Image with text" }
      ],
      "default": "split"
    },
    { "type": "checkbox", "id": "autoplay", "label": "Enable autoplay", "default": false },
    { "type": "range", "id": "autoplay_speed", "label": "Autoplay interval", "min": 3, "max": 12, "step": 1, "unit": "s", "default": 5 },
    { "type": "checkbox", "id": "fade_slides", "label": "Fade between slides", "default": true },
    { "type": "select", "id": "height_desktop", "label": "Desktop height", "options": [
      { "value": "small", "label": "Small — 400px" }, { "value": "medium", "label": "Medium — 550px" }, { "value": "large", "label": "Large — 770px" }, { "value": "original", "label": "Original image ratio" }, { "value": "fit", "label": "Fit screen" }
    ], "default": "large" },
    { "type": "select", "id": "height_mobile", "label": "Mobile height", "options": [
      { "value": "small", "label": "Small — 400px" }, { "value": "medium", "label": "Medium — 550px" }, { "value": "large", "label": "Large — 770px" }, { "value": "original", "label": "Original image ratio" }, { "value": "fit", "label": "Fit screen" }
    ], "default": "medium" },
    { "type": "checkbox", "id": "fit_screen", "label": "Scale content to fit viewport", "default": false },
    { "type": "range", "id": "content_max_width", "label": "Content max width", "min": 400, "max": 1400, "step": 50, "unit": "px", "default": 1200 },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 24 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 24 },
    { "type": "range", "id": "title_size", "label": "Default title size", "min": 24, "max": 80, "step": 2, "unit": "px", "default": 48 },
    { "type": "range", "id": "title_size_mobile", "label": "Default mobile title size", "min": 20, "max": 52, "step": 2, "unit": "px", "default": 34 },
    { "type": "range", "id": "body_size", "label": "Default description size", "min": 12, "max": 24, "step": 1, "unit": "px", "default": 16 },
    { "type": "range", "id": "body_size_mobile", "label": "Default mobile description size", "min": 12, "max": 20, "step": 1, "unit": "px", "default": 14 },
    { "type": "color", "id": "default_text_color", "label": "Default text color", "default": "#FFFFFF" },
    { "type": "color", "id": "section_background", "label": "Section background", "default": "#D8D0C3" }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "Slide",
      "settings": [
        { "type": "header", "content": "Full width / Image with text media" },
        { "type": "image_picker", "id": "desktop_image", "label": "Desktop image" },
        { "type": "video", "id": "desktop_video", "label": "Desktop video" },
        { "type": "image_picker", "id": "mobile_image", "label": "Mobile image" },
        { "type": "video", "id": "mobile_video", "label": "Mobile video" },
        { "type": "text", "id": "title", "label": "Title", "default": "Esto es vida" },
        { "type": "richtext", "id": "description", "label": "Description", "default": "<p>Seguridad, confort y diseño en cada etapa de su crecimiento</p>" },
        { "type": "select", "id": "content_position", "label": "Desktop content position", "options": [
          { "value": "top-left", "label": "Top left" }, { "value": "top-center", "label": "Top center" }, { "value": "top-right", "label": "Top right" },
          { "value": "center-left", "label": "Center left" }, { "value": "center-center", "label": "Center" }, { "value": "center-right", "label": "Center right" },
          { "value": "bottom-left", "label": "Bottom left" }, { "value": "bottom-center", "label": "Bottom center" }, { "value": "bottom-right", "label": "Bottom right" }
        ], "default": "bottom-left" },
        { "type": "select", "id": "content_position_mobile", "label": "Mobile content position", "options": [
          { "value": "top-left", "label": "Top left" }, { "value": "top-center", "label": "Top center" }, { "value": "top-right", "label": "Top right" },
          { "value": "center-left", "label": "Center left" }, { "value": "center-center", "label": "Center" }, { "value": "center-right", "label": "Center right" },
          { "value": "bottom-left", "label": "Bottom left" }, { "value": "bottom-center", "label": "Bottom center" }, { "value": "bottom-right", "label": "Bottom right" }
        ], "default": "bottom-left" },
        { "type": "select", "id": "text_alignment", "label": "Text alignment", "options": [
          { "value": "left", "label": "Left" }, { "value": "center", "label": "Center" }, { "value": "right", "label": "Right" }
        ], "default": "left" },
        { "type": "range", "id": "slide_title_size", "label": "Title size desktop", "min": 24, "max": 80, "step": 2, "unit": "px", "default": 48 },
        { "type": "range", "id": "slide_title_size_mobile", "label": "Title size mobile", "min": 20, "max": 52, "step": 2, "unit": "px", "default": 34 },
        { "type": "color", "id": "text_color", "label": "Text color", "default": "#FFFFFF" },
        { "type": "range", "id": "overlay_opacity", "label": "Overlay opacity", "min": 0, "max": 80, "step": 5, "unit": "%", "default": 20 },
        { "type": "checkbox", "id": "gradient_overlay", "label": "Enable gradient overlay", "default": true },
        { "type": "header", "content": "Button 1" },
        { "type": "text", "id": "button_1_label", "label": "Button label", "default": "COMPRAR" },
        { "type": "url", "id": "button_1_link", "label": "Button link" },
        { "type": "select", "id": "button_1_type", "label": "Button type", "options": [
          { "value": "filled-white", "label": "Filled white" }, { "value": "filled-black", "label": "Filled black" }, { "value": "stroke-white", "label": "Stroke white" },
          { "value": "stroke-black", "label": "Stroke black" }, { "value": "link-white", "label": "Link white" }, { "value": "link-black", "label": "Link black" }, { "value": "custom", "label": "Customize" }
        ], "default": "filled-white" },
        { "type": "color", "id": "button_1_bg", "label": "Button 1 custom background", "default": "#FFFFFF" },
        { "type": "color", "id": "button_1_color", "label": "Button 1 custom text", "default": "#111111" },
        { "type": "color", "id": "button_1_border", "label": "Button 1 custom border", "default": "#FFFFFF" },
        { "type": "header", "content": "Button 2" },
        { "type": "text", "id": "button_2_label", "label": "Button label", "default": "VER DETALLES" },
        { "type": "url", "id": "button_2_link", "label": "Button link" },
        { "type": "select", "id": "button_2_type", "label": "Button type", "options": [
          { "value": "filled-white", "label": "Filled white" }, { "value": "filled-black", "label": "Filled black" }, { "value": "stroke-white", "label": "Stroke white" },
          { "value": "stroke-black", "label": "Stroke black" }, { "value": "link-white", "label": "Link white" }, { "value": "link-black", "label": "Link black" }, { "value": "custom", "label": "Customize" }
        ], "default": "stroke-white" },
        { "type": "color", "id": "button_2_bg", "label": "Button 2 custom background", "default": "#FFFFFF" },
        { "type": "color", "id": "button_2_color", "label": "Button 2 custom text", "default": "#111111" },
        { "type": "color", "id": "button_2_border", "label": "Button 2 custom border", "default": "#FFFFFF" },

        { "type": "header", "content": "50-50 split — left pane" },
        { "type": "image_picker", "id": "left_image", "label": "Left desktop image" },
        { "type": "video", "id": "left_video", "label": "Left desktop video" },
        { "type": "image_picker", "id": "left_mobile_image", "label": "Left mobile image" },
        { "type": "video", "id": "left_mobile_video", "label": "Left mobile video" },
        { "type": "text", "id": "left_title", "label": "Left title", "default": "Esto es vida" },
        { "type": "richtext", "id": "left_description", "label": "Left description", "default": "<p>Seguridad, confort y diseño en cada etapa de su crecimiento</p>" },
        { "type": "select", "id": "left_position", "label": "Left desktop position", "options": [
          { "value": "top-left", "label": "Top left" }, { "value": "top-center", "label": "Top center" }, { "value": "top-right", "label": "Top right" }, { "value": "center-left", "label": "Center left" }, { "value": "center-center", "label": "Center" }, { "value": "center-right", "label": "Center right" }, { "value": "bottom-left", "label": "Bottom left" }, { "value": "bottom-center", "label": "Bottom center" }, { "value": "bottom-right", "label": "Bottom right" }
