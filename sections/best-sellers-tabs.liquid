<section class="best-sellers-tabs">
  <div class="bst-header">
    <h2 class="bst-title">{{ section.settings.title }}</h2>

    <div class="bst-tabs">
      {% for block in section.blocks %}
        <button class="bst-tab" data-tab="{{ block.id }}">{{ block.tab_name }}</button>
      {% endfor %}
    </div>
  </div>

  <div class="bst-products-wrapper">
    {% for block in section.blocks %}
      <div class="bst-products-tab" id="tab-{{ block.id }}">
        {% assign collection_handle = block.collection %}
        {% if collection_handle != blank %}
          {% assign products = collections[collection_handle].products %}
          <div class="bst-slider">
            {% for product in products limit:8 %}
              <div class="bst-product">
                <a href="{{ product.url }}">
                  <img src="{{ product.featured_image | img_url: 'medium' }}" alt="{{ product.title }}">
                  <h3>{{ product.title }}</h3>
                  <p>{{ product.price | money }}</p>
                </a>
              </div>
            {% endfor %}
          </div>
        {% endif %}
      </div>
    {% endfor %}
  </div>
</section>

<style>
.best-sellers-tabs {
  width: 100%;
  margin: 40px 0;
  font-family: sans-serif;
}
.bst-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20px;
}
.bst-title {
  font-size: 24px;
  font-weight: 600;
}
.bst-tabs {
  display: flex;
  gap: 12px;
}
.bst-tab {
  background: none;
  border: 1px solid #333;
  padding: 6px 12px;
  cursor: pointer;
}
.bst-tab.active {
  background: #333;
  color: #fff;
}

/* Products slider */
.bst-products-wrapper {
  position: relative;
}
.bst-products-tab {
  display: none;
}
.bst-products-tab.active {
  display: flex;
}
.bst-slider {
  display: flex;
  gap: 16px;
  overflow-x: auto;
  scroll-behavior: smooth;
}
.bst-product {
  min-width: 23%;
  flex: 0 0 auto;
  border: 1px solid #eee;
  padding: 10px;
  box-sizing: border-box;
}
.bst-product img {
  width: 100%;
  display: block;
  margin-bottom: 8px;
}
.bst-product h3 {
  font-size: 14px;
  margin: 0 0 4px 0;
}
.bst-product p {
  font-size: 13px;
  color: #555;
  margin: 0;
}

/* Responsive */
@media (max-width:1024px){
  .bst-product { min-width: 48%; }
}
@media (max-width:768px){
  
}
</style>

<script>
document.addEventListener('DOMContentLoaded', function(){
  const tabs = document.querySelectorAll('.bst-tab');
  const productTabs = document.querySelectorAll('.bst-products-tab');

  // Show first tab by default
  if(tabs.length){
    tabs[0].classList.add('active');
    productTabs[0].classList.add('active');
  }

  tabs.forEach(tab=>{
    tab.addEventListener('click',()=>{
      // Remove active
      tabs.forEach(t=>t.classList.remove('active'));
      productTabs.forEach(pt=>pt.classList.remove('active'));

      // Add active
      tab.classList.add('active');
      document.getElementById('tab-'+tab.dataset.tab).classList.add('active');
    });
  });
});
</script>

{% schema %}
{
  "name": "Best Sellers Tabs",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Section Title",
      "default": "Best Sellers"
    }
  ],
  "blocks": [
    {
      "type": "tab_block",
      "name": "Tab",
      "settings": [
        {
          "type": "text",
          "id": "tab_name",
          "label": "Tab Name"
        },
        {
          "type": "collection",
          "id": "collection",
          "label": "Select Collection for this Tab"
        }
      ]
    }
  ],
  "max_blocks": 3,
  "presets": [
    {
      "name": "Best Sellers Tabs",
      "category": "Products"
    }
  ]
}
{% endschema %}
