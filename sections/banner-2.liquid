<div class="editorial-grid">

  <div class="editorial-card">
    <img src="{{ section.settings.image_1 | image_url: width: 1200 }}" alt="">
    <span>BIKINIS</span>
  </div>

  <div class="editorial-card">
    <img src="{{ section.settings.image_2 | image_url: width: 1200 }}" alt="">
    <span>ROPA DE PLAYA</span>
  </div>

  <div class="editorial-card">
    <img src="{{ section.settings.image_3 | image_url: width: 1200 }}" alt="">
    <span>BAÑADORES</span>
  </div>

</div>

<style>
    .editorial-grid{
    width:100%;
    display:grid;
    grid-template-columns:repeat(3,1fr);
    gap:0;
}

.editorial-card{
    position:relative;
    overflow:hidden;
    aspect-ratio:4/6;
}

.editorial-card img{
    width:100%;
    height:100%;
    display:block;
    object-fit:cover;
    transition:.5s;
}

.editorial-card:hover img{
    transform:scale(1.05);
}

.editorial-card span{
    position:absolute;
    top:18px;
    left:18px;
    color:#fff;
    font-size:11px;
    letter-spacing:2px;
    text-transform:uppercase;
    z-index:2;
}

/* ---------- Tablet ---------- */

@media (max-width:990px){

.editorial-card{
    aspect-ratio:3/5;
}

}

/* ---------- Mobile ---------- */

@media (max-width:749px){

.editorial-grid{
    grid-template-columns:1fr;
}

.editorial-card{
    aspect-ratio:4/6;
}

.editorial-card span{
    top:14px;
    left:14px;
    font-size:10px;
}

}
</style>
{%  schema %}
{
     "name": "hero banner",
  "settings":[
    {
      "type":"image_picker",
      "id":"image_1",
      "label":"First Image"
    },
    {
      "type":"image_picker",
      "id":"image_2",
      "label":"Second Image"
    },
    {
      "type":"image_picker",
      "id":"image_3",
      "label":"Third Image"
    }
  ]
}
{% endschema %}