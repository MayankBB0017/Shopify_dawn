<section class="bs-ui">
  <div class="bs-ui__header">
    <h2>Best sellers:</h2>

    <div class="bs-ui__tabs">
      <span class="active">SWIMWEAR</span>
      <span>INTIMATES</span>
      <span>ACCESSORIES</span>
    </div>

    <div class="bs-ui__arrows">
      <button class="bs-ui__prev">&#10094;</button>
      <button class="bs-ui__next">&#10095;</button>
    </div>
  </div>

  <div class="bs-ui__wrapper">

    {% for block in section.blocks %}
      <div class="bs-ui__card" {{ block.shopify_attributes }}>

        {% if block.settings.badge != blank %}
          <span class="bs-ui__badge">{{ block.settings.badge }}</span>
        {% endif %}

        <div class="bs-ui__image">
          {% if block.settings.image != blank %}
            {{
              block.settings.image
              | image_url: width: 800
              | image_tag:
              loading: 'lazy',
              class: 'bs-ui__img'
            }}
          {% else %}
            {{ 'product-1' | placeholder_svg_tag: 'bs-ui__img' }}
          {% endif %}
        </div>

        <div class="bs-ui__content">

          <h4>{{ block.settings.title }}</h4>

          <div class="bs-ui__bottom">

            <div class="bs-ui__price">
              <span class="current">{{ block.settings.price }}</span>

              {% if block.settings.compare_price != blank %}
                <span class="old">{{ block.settings.compare_price }}</span>
              {% endif %}
            </div>

            <div class="bs-ui__icon">
              ♡
            </div>

          </div>

        </div>

      </div>
    {% endfor %}

  </div>
</section>

<style>

.bs-ui{
    width:100%;
    padding:60px 40px;
}

.bs-ui__header{
    display:flex;
    align-items:center;
    gap:30px;
    margin-bottom:35px;
}

.bs-ui__header h2{
    font-size:34px;
    font-weight:400;
}

.bs-ui__tabs{
    display:flex;
    gap:25px;
}

.bs-ui__tabs span{
    font-size:12px;
    letter-spacing:1px;
    cursor:pointer;
}

.bs-ui__tabs .active{
    border-bottom:1px solid #000;
}

.bs-ui__arrows{
    margin-left:auto;
    display:flex;
    gap:10px;
}

.bs-ui__prev,
.bs-ui__next{
    width:40px;
    height:40px;
    border:1px solid #ddd;
    background:#fff;
    cursor:pointer;
}

.bs-ui__wrapper{
    display:grid;
    grid-template-columns:repeat(5,1fr);
    gap:18px;
}

.bs-ui__card{
    position:relative;
}

.bs-ui__badge{
    position:absolute;
    top:12px;
    left:12px;
    font-size:10px;
    z-index:2;
}

.bs-ui__image{
    aspect-ratio:3/4;
    overflow:hidden;
    background:#f7f7f7;
}

.bs-ui__img{
    width:100%;
    height:100%;
    object-fit:cover;
    display:block;
    transition:.4s;
}

.bs-ui__card:hover .bs-ui__img{
    transform:scale(1.05);
}

.bs-ui__content{
    padding-top:12px;
}

.bs-ui__content h4{
    font-size:13px;
    font-weight:400;
    line-height:1.5;
    {% comment %} min-height:40px; {% endcomment %}
}

.bs-ui__bottom{
    display:flex;
    justify-content:space-between;
    align-items:center;
    margin-top:-20px;
}

.bs-ui__price{
    display:flex;
    gap:8px;
    align-items:center;
}

.current{
    font-size:14px;
}

.old{
    text-decoration:line-through;
    color:#999;
    font-size:12px;
}

.bs-ui__icon{
    font-size:18px;
    cursor:pointer;
}

@media(max-width:991px){

.bs-ui__wrapper{
    grid-template-columns:repeat(3,1fr);
}

}

@media(max-width:767px){

.bs-ui{
    padding:30px 16px;
}

.bs-ui__header{
    flex-wrap:wrap;
}

.bs-ui__wrapper{
    grid-template-columns:repeat(2,1fr);
    gap:12px;
}

.bs-ui__header h2{
    font-size:26px;
}

.bs-ui__tabs{
    gap:12px;
}

.bs-ui__tabs span{
    font-size:11px;
}

}

</style>
{% schema %}
{
  "name": "Best Sellers UI",
  "tag": "section",
  "class": "best-sellers-ui",
  "settings": [],
  "max_blocks": 10,
  "blocks": [
    {
      "type": "product",
      "name": "Product Card",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Product Image"
        },
        {
          "type": "text",
          "id": "badge",
          "label": "Badge",
          "default": "NEW"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Product Title",
          "default": "Bikini Balconette Butterfly braga clásica lazo"
        },
        {
          "type": "text",
          "id": "price",
          "label": "Price",
          "default": "17.99€"
        },
        {
          "type": "text",
          "id": "compare_price",
          "label": "Compare Price",
          "default": "21.99€"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Best Sellers UI",
      "blocks": [
        {
          "type": "product"
        },
        {
          "type": "product"
        },
        {
          "type": "product"
        },
        {
          "type": "product"
        },
        {
          "type": "product"
        }
      ]
    }
  ]
}
{% endschema %}