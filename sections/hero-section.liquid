{{ 'hero-section.css' | asset_url | stylesheet_tag }}
{% assign desktop_image_url = section.settings.desktop_image | img_url: '2048x2048' %}
{% assign mobile_image_url = section.settings.mobile_image | img_url: '1024x1024' %}

<style>
    .responsive-image-section {
    width: 100%;
    }
    .section-padding-{{section.id }} {
    padding-top: {{ section.settings.padding_top_desktop }}px;
    padding-bottom: {{ section.settings.padding_bottom_desktop }}px;
    }

    .responsive-image-section img {
    width: 100%;
    display: block;
    }

    .responsive-image-section .desktop-image {
    display: block;
    }

    .responsive-image-section .mobile-image {
    display: none;
    }

    @media screen and (max-width: 749px) {
    .section-padding-{{section.id }} {
        padding-top: {{ section.settings.padding_top_mobile }}px;
        padding-bottom: {{ section.settings.padding_bottom_mobile }}px;
    }

    {% if mobile_image_url != blank %}
        .responsive-image-section .desktop-image { display: none; }
        .responsive-image-section .mobile-image { display: block; }
    {% else %}
        .responsive-image-section .desktop-image { display: block; }
        .responsive-image-section .mobile-image { display: none; }
    {% endif %}
    }
</style>

<section class="hero_section_wrapper  section-padding-{{section.id }}">

<div class="responsive-image-section">
  {% if desktop_image_url %}
    {% comment %} <img src="{{ desktop_image_url }}" alt="Desktop Image" class="desktop-image" /> {% endcomment %}


             <div class="desktop_image_wrap desktop-image" style="padding-top: {{ 1 | divided_by: desktop_image_url.aspect_ratio | times: 100 }}%;">
                <img
                  srcset="
                    {% if desktop_image_url.width >= 350 %}{{ desktop_image_url | image_url: width: 350 }} 350w,{% endif %}
                    {% if desktop_image_url.width >= 750 %}{{ desktop_image_url | image_url: width: 750 }} 750w,{% endif %}
                    {% if desktop_image_url.width >= 1100 %}{{ desktop_image_url | image_url: width: 1100 }} 1100w,{% endif %}
                    {% if desktop_image_url.width >= 1500 %}{{ desktop_image_url | image_url: width: 1500 }} 1500w,{% endif %}
                    {% if desktop_image_url.width >= 2200 %}{{ desktop_image_url | image_url: width: 2200 }} 2200w,{% endif %}
                    {% if desktop_image_url.width >= 3000 %}{{ desktop_image_url | image_url: width: 3000 }} 3000w,{% endif %}
                    {{ desktop_image_url | image_url }} {{ desktop_image_url.width }}w
                  "
                  sizes="(min-width: {{ settings.page_width }}px) {{ settings.page_width | minus: 100 }}px, (min-width: 750px) calc(100vw - 10rem), 100vw"
                  src="{{ desktop_image_url | image_url: width: 1100 }}"
                  loading="eager"
                  fetchpriority="high"
                  width="{{ desktop_image_url.width }}"
                  height="{{ desktop_image_url.height }}"
                  alt="{{ desktop_image_url.alt | escape }}"
                >
              <div> 


  {% endif %}
  
  {% if mobile_image_url %}
    {% comment %} <img src="{{ mobile_image_url }}" alt="Mobile Image" class="mobile-image" /> {% endcomment %}

    <div class=" mobile-image  mobile_image_wrap" style="padding-top: {{ 1 | divided_by: mobile_image_url.aspect_ratio | times: 100 }}%;">
                <img
                  srcset="
                    {% if mobile_image_url.width >= 350 %}{{ mobile_image_url | image_url: width: 350 }} 350w,{% endif %}
                    {% if mobile_image_url.width >= 750 %}{{ mobile_image_url | image_url: width: 750 }} 750w,{% endif %}
                    {% if mobile_image_url.width >= 1100 %}{{ mobile_image_url | image_url: width: 1100 }} 1100w,{% endif %}
                    {% if mobile_image_url.width >= 1500 %}{{ mobile_image_url | image_url: width: 1500 }} 1500w,{% endif %}
                    {% if mobile_image_url.width >= 2200 %}{{ mobile_image_url | image_url: width: 2200 }} 2200w,{% endif %}
                    {% if mobile_image_url.width >= 3000 %}{{ mobile_image_url | image_url: width: 3000 }} 3000w,{% endif %}
                    {{ mobile_image_url | image_url }} {{ mobile_image_url.width }}w
                  "
                  sizes="(min-width: {{ settings.page_width }}px) {{ settings.page_width | minus: 100 }}px, (min-width: 750px) calc(100vw - 10rem), 100vw"
                  src="{{ mobile_image_url | image_url: width: 1100 }}"
                  loading="eager"
                  fetchpriority="high"
                  width="{{ mobile_image_url.width }}"
                  height="{{ mobile_image_url.height }}"
                  alt="{{ mobile_image_url.alt | escape }}"
                >
              <div> 

  {% endif %}
</div>


{% schema %}
{
  "name": "Hero Section",
  "settings": [
    {
      "type": "image_picker",
      "id": "desktop_image",
      "label": "Desktop Image"
    },
    {
      "type": "image_picker",
      "id": "mobile_image",
      "label": "Mobile Image "
    },
    {
      "type": "range",
      "id": "padding_top_desktop",
      "label": "Padding Top Desktop ",
      "min": 0,
      "max": 200,
      "step": 5,
      "default": 50
    },
    {
      "type": "range",
      "id": "padding_bottom_desktop",
      "label": "Padding Bottom Desktop",
      "min": 0,
      "max": 200,
      "step": 5,
      "default": 50
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "Padding Top Mobile )",
      "min": 0,
      "max": 200,
      "step": 5,
      "default": 30
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "Padding Bottom Mobile ",
      "min": 0,
      "max": 200,
      "step": 5,
      "default": 30
    }
  ],
  "presets": [
    {
      "name": "Hero Section",
      "category": "Image"
    }
  ]
}
{% endschema %}

