{{ 'hero-section.css' | asset_url | stylesheet_tag }}

<style>
    .section-padding-{{section.id }} {
    padding-top: {{ section.settings.padding_top_desktop }}px;
    padding-bottom: {{ section.settings.padding_bottom_desktop }}px;
    }

    @media screen and (max-width: 749px) {
    .section-padding-{{section.id }} {
        padding-top: {{ section.settings.padding_top_mobile }}px;
        padding-bottom: {{ section.settings.padding_bottom_mobile }}px;
    }
    }
</style>

<section class="hero_section_wrapper section-padding-{{ section.id }}">
  <div class="responsive-image-section">
    {% if section.settings.desktop_image != blank %}
     <div class="Desktop_image_wrapper {% if section.settings.mobile_image != blank %} desktop_hidden {%else %} shown_desktop {% endif %} " style="padding-top: {{ 1 | divided_by: section.settings.desktop_image.aspect_ratio | times: 100 }}%;">
        <img
            srcset="
            {% if section.settings.desktop_image.width >= 350 %}{{ section.settings.desktop_image | image_url: width: 350 }} 350w,{% endif %}
            {% if section.settings.desktop_image.width >= 750 %}{{ section.settings.desktop_image | image_url: width: 750 }} 750w,{% endif %}
            {% if section.settings.desktop_image.width >= 1100 %}{{ section.settings.desktop_image | image_url: width: 1100 }} 1100w,{% endif %}
            {% if section.settings.desktop_image.width >= 1500 %}{{ section.settings.desktop_image | image_url: width: 1500 }} 1500w,{% endif %}
            {% if section.settings.desktop_image.width >= 2200 %}{{ section.settings.desktop_image | image_url: width: 2200 }} 2200w,{% endif %}
            {% if section.settings.desktop_image.width >= 3000 %}{{ section.settings.desktop_image | image_url: width: 3000 }} 3000w,{% endif %}
            {{ section.settings.desktop_image | image_url }} {{ section.settings.desktop_image.width }}w
            "
            sizes="(min-width: {{ settings.page_width }}px) {{ settings.page_width | minus: 100 }}px, (min-width: 750px) calc(100vw - 10rem), 100vw"
            src="{{ section.settings.desktop_image | image_url: width: 1100 }}"
            loading="eager"
            fetchpriority="high"
            width="{{ section.settings.desktop_image.width }}"
            height="{{ section.settings.desktop_image.height }}"
            alt="{{ section.settings.desktop_image.alt | escape }}"
        >
            <div class="section_content_wrap">
                <div class="section_content">
                    {% if section.settings.title != blank %}
                        <h1 class="section_heading">{{section.settings.title }}</h1>
                    {% endif %}
                    {% if section.settings.text != blank %}
                     <div class="section_text">{{section.settings.text }}</div>
                    {% endif %}
                    <div class="section_btns_wrapper">
                        {% if section.settings.url1 != blank %}
                         <a href="{{ section.settings.url1 }}"> {{section.settings.url_text1 }}</a>
                        {% endif %}
                        {% if section.settings.url2 != blank %}
                         <a href="{{ section.settings.url2 }}"> {{section.settings.url_text2 }}</a>
                        {% endif %}
                    </div>
                </div>
            </div>
    </div>
    {%endif %}
     {% if section.settings.mobile_image != blank %}
     <div class="mobile_image_wrap" style="padding-top: {{ 1 | divided_by: section.settings.mobile_image.aspect_ratio | times: 100 }}%;">
        <img
            srcset="
            {% if section.settings.mobile_image.width >= 350 %}{{ section.settings.mobile_image | image_url: width: 350 }} 350w,{% endif %}
            {% if section.settings.mobile_image.width >= 750 %}{{ section.settings.mobile_image | image_url: width: 750 }} 750w,{% endif %}
            {% if section.settings.mobile_image.width >= 1100 %}{{ section.settings.mobile_image | image_url: width: 1100 }} 1100w,{% endif %}
            {% if section.settings.mobile_image.width >= 1500 %}{{ section.settings.mobile_image | image_url: width: 1500 }} 1500w,{% endif %}
            {% if section.settings.mobile_image.width >= 2200 %}{{ section.settings.mobile_image | image_url: width: 2200 }} 2200w,{% endif %}
            {% if section.settings.mobile_image.width >= 3000 %}{{ section.settings.mobile_image | image_url: width: 3000 }} 3000w,{% endif %}
            {{ section.settings.mobile_image | image_url }} {{ section.settings.mobile_image.width }}w
            "
            sizes="(min-width: {{ settings.page_width }}px) {{ settings.page_width | minus: 100 }}px, (min-width: 750px) calc(100vw - 10rem), 100vw"
            src="{{ section.settings.mobile_image | image_url: width: 1100 }}"
            loading="eager"
            fetchpriority="high"
            width="{{ section.settings.mobile_image.width }}"
            height="{{ section.settings.mobile_image.height }}"
            alt="{{ section.settings.mobile_image.alt | escape }}"
        >
            <div class="section_content_wrap">
                <div class="section_content">
                    {% if section.settings.title != blank %}
                        <h1 class="section_heading">{{section.settings.title }}</h1>
                    {% endif %}
                    {% if section.settings.text != blank %}
                     <div class="section_text">{{section.settings.text }}</div>
                    {% endif %}
                    <div class="section_btns_wrapper">
                        {% if section.settings.url1 != blank %}
                         <a href="{{ section.settings.url1 }}"> {{section.settings.url_text1 }}</a>
                        {% endif %}
                        {% if section.settings.url2 != blank %}
                         <a href="{{ section.settings.url2 }}"> {{section.settings.url_text2 }}</a>
                        {% endif %}
                    </div>
                </div>
            </div>
    </div>
    {%endif %}
  </div>
</section>

{% schema %}
{
  "name": "Hero Section",
  "settings": [
    {
      "type": "header",
      "content": "Section Media"
    },
    {
      "type": "image_picker",
      "id": "desktop_image",
      "label": "Desktop Image"
    },
    {
      "type": "image_picker",
      "id": "mobile_image",
      "label": "Mobile Image "
    },
    {
      "type": "header",
      "content": "Section Content"
    },
    {
        "type": "text",
        "id": "title",
        "label": "Heading",
        "default": "Heading"
    },
    {
        "type": "richtext",
        "id": "text",
        "label": "content"
    },
    {
      "type": "header",
      "content": "Section Buttons"
    },
    {
        "type": "text",
        "id": "url_text1",
        "label": "Button Text 1",
        "default": "Buttons"
    },
    {
        "type": "url",
        "id": "url1",
        "label": "Button link 1"
    },
    {
        "type": "text",
        "id": "url_text2",
        "label": "Button Text 2",
        "default": "Buttons"
    },
    {
        "type": "url",
        "id": "url2",
        "label": "Button link 2"
    },


    {
      "type": "header",
      "content": "Section Spacing"
    },
    {
      "type": "range",
      "id": "padding_top_desktop",
      "label": "Padding Top Desktop ",
      "min": 0,
      "max": 200,
      "step": 5,
      "default": 50
    },
    {
      "type": "range",
      "id": "padding_bottom_desktop",
      "label": "Padding Bottom Desktop",
      "min": 0,
      "max": 200,
      "step": 5,
      "default": 50
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "Padding Top Mobile )",
      "min": 0,
      "max": 200,
      "step": 5,
      "default": 30
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "Padding Bottom Mobile ",
      "min": 0,
      "max": 200,
      "step": 5,
      "default": 30
    }
  ],
  "presets": [
    {
      "name": "Hero Section",
      "category": "Image"
    }
  ]
}
{% endschema %}

