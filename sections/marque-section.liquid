{% comment %}
  Marquee Logos Section — Shopify OS 2.0 / Dawn Theme
  Infinite scrolling image logo bar with CMS controls.
  Add logos via Theme Editor → Add block → Logo → upload image.
{% endcomment %}

{%- liquid
  assign section_id            = section.id
  assign speed                 = section.settings.speed | default: 40
  assign direction             = section.settings.direction | default: 'left'
  assign animate               = section.settings.animate
  assign bg_color              = section.settings.background_color
  assign separator             = section.settings.separator
  assign padding_top           = section.settings.padding_top
  assign padding_bottom        = section.settings.padding_bottom
  assign padding_top_mobile    = section.settings.padding_top_mobile
  assign padding_bottom_mobile = section.settings.padding_bottom_mobile
-%}

<style>
  /* ─── CSS custom properties (scoped per section instance) ─── */
  #shopify-section-{{ section_id }} {
    --mq-speed:   {{ speed }}s;
    --mq-gap:     clamp(2.5rem, 6vw, 6rem);
    --mq-bg:      {{ bg_color }};
    --mq-border:  {{ section.settings.border_color }};
    --mq-pt:      {{ padding_top }}px;
    --mq-pb:      {{ padding_bottom }}px;
    --mq-logo-h:  clamp(18px, 2.8vw, 28px);
    --mq-opacity: {{ section.settings.image_opacity | divided_by: 100.0 }};
    --mq-filter:  {{ section.settings.image_filter }};
  }

  /* ─── Outer wrapper ─── */
  .mq-section-{{ section_id }} {
    background-color: var(--mq-bg);
    border-top:    1px solid var(--mq-border);
    border-bottom: 1px solid var(--mq-border);
    overflow: hidden;
    padding-top:    var(--mq-pt);
    padding-bottom: var(--mq-pb);
    position: relative;
    width: 100%;
  }

  /* ─── Scrolling track ─── */
  .mq-track-{{ section_id }} {
    display: flex;
    width: max-content;
    align-items: center;
    will-change: transform;
    {% if animate %}
      animation: mq-scroll-{{ section_id }} var(--mq-speed) linear infinite;
    {% endif %}
  }

  /* ─── Pause entire track on section hover ─── */
  {% if animate %}
    .mq-section-{{ section_id }}:hover .mq-track-{{ section_id }} {
      animation-play-state: paused;
    }
  {% endif %}

  /* ─── Keyframes — direction aware ─── */
  {% if direction == 'right' %}
    @keyframes mq-scroll-{{ section_id }} {
      from { transform: translateX(-50%); }
      to   { transform: translateX(0); }
    }
  {% else %}
    @keyframes mq-scroll-{{ section_id }} {
      from { transform: translateX(0); }
      to   { transform: translateX(-50%); }
    }
  {% endif %}

  /* ─── One set of logos (rendered ×2 for seamless loop) ─── */
  .mq-copy-{{ section_id }} {
    display: flex;
    align-items: center;
    flex-shrink: 0;
    gap: var(--mq-gap);
    padding-inline: calc(var(--mq-gap) / 2);
  }

  /* ─── Single logo item ─── */
  .mq-item-{{ section_id }} {
    display: inline-flex;
    align-items: center;
    flex-shrink: 0;
    line-height: 0;
  }

  .mq-item-{{ section_id }} img {
    display: block;
    height: var(--mq-logo-h);
    width: auto;
    max-width: 180px;
    object-fit: contain;
    object-position: center;
    opacity: var(--mq-opacity);
    filter: var(--mq-filter);
    transition: opacity 0.35s ease, filter 0.35s ease;
  }

  /* ─── Full colour + opacity on hover ─── */
  .mq-item-{{ section_id }}:hover img {
    opacity: 1;
    filter: none;
  }

  /* ─── Empty-slot placeholder (Theme Editor only) ─── */
  .mq-placeholder-{{ section_id }} {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    height: var(--mq-logo-h);
    min-width: 80px;
    padding-inline: 0.75rem;
    border: 1.5px dashed rgba(0,0,0,0.25);
    border-radius: 4px;
    font-size: 0.65rem;
    letter-spacing: 0.04em;
    color: rgba(0,0,0,0.35);
    white-space: nowrap;
    pointer-events: none;
  }

  /* ─── Separator ─── */
  .mq-sep-{{ section_id }} {
    display: inline-flex;
    align-items: center;
    flex-shrink: 0;
    color: var(--mq-border);
    font-size: 1rem;
    line-height: 1;
    pointer-events: none;
    opacity: 0.7;
  }

  /* ─── Edge fade vignette ─── */
  {% if section.settings.show_fade %}
    .mq-section-{{ section_id }}::before,
    .mq-section-{{ section_id }}::after {
      content: '';
      position: absolute;
      inset-block: 0;
      width: clamp(40px, 8vw, 120px);
      z-index: 2;
      pointer-events: none;
    }
    .mq-section-{{ section_id }}::before {
      left: 0;
      background: linear-gradient(to right, var(--mq-bg) 0%, transparent 100%);
    }
    .mq-section-{{ section_id }}::after {
      right: 0;
      background: linear-gradient(to left, var(--mq-bg) 0%, transparent 100%);
    }
  {% endif %}

  /* ─── Reduced-motion accessibility ─── */
  @media (prefers-reduced-motion: reduce) {
    .mq-track-{{ section_id }} {
      animation: none !important;
    }
  }

  /* ─── Mobile overrides ─── */
  @media screen and (max-width: 749px) {
    #shopify-section-{{ section_id }} {
      --mq-gap:    clamp(1.5rem, 8vw, 3rem);
      --mq-logo-h: clamp(14px, 4vw, 22px);
      --mq-pt:     {{ padding_top_mobile }}px;
      --mq-pb:     {{ padding_bottom_mobile }}px;
    }
  }
</style>

<div
  class="mq-section-{{ section_id }}"
  role="region"
  aria-label="{{ section.settings.aria_label | default: 'As seen in' }}"
>
  <div class="mq-track-{{ section_id }}" aria-hidden="true">

    {%- comment -%}
      Two identical copies of the logo list.
      The keyframe translates exactly −50%, so copy 2 snaps
      invisibly into copy 1's original position — seamless loop.
    {%- endcomment -%}

    {%- for copy in (1..2) -%}
      <div class="mq-copy-{{ section_id }}">

        {%- if section.blocks.size > 0 -%}

          {%- for block in section.blocks -%}
            {%- assign img = block.settings.image -%}

            <span class="mq-item-{{ section_id }}" {{ block.shopify_attributes }}>
              {%- if img != blank -%}
                {{-
                  img
                  | image_url: width: 400
                  | image_tag:
                    loading: 'lazy',
                    alt: block.settings.alt_text | default: img.alt | default: 'Logo',
                    width: img.width,
                    height: img.height
                -}}
              {%- else -%}
                <span class="mq-placeholder-{{ section_id }}">Upload logo</span>
              {%- endif -%}
            </span>

            {%- unless forloop.last -%}
              {%- if separator != 'none' -%}
                <span class="mq-sep-{{ section_id }}">
                  {%- case separator -%}
                    {%- when 'dot'    -%}&middot;
                    {%- when 'bullet' -%}&bull;
                    {%- when 'pipe'   -%}&#124;
                    {%- when 'dash'   -%}&mdash;
                    {%- when 'star'   -%}&#10022;
                  {%- endcase -%}
                </span>
              {%- endif -%}
            {%- endunless -%}

          {%- endfor -%}

        {%- else -%}
          {%- comment -%} Shown in editor before any blocks are added {%- endcomment -%}
          {%- for i in (1..6) -%}
            <span class="mq-placeholder-{{ section_id }}">Upload logo</span>
          {%- endfor -%}
        {%- endif -%}

      </div>
    {%- endfor -%}

  </div>
</div>

{% schema %}
{
  "name": "Marquee — Logo Bar",
  "tag": "section",
  "class": "marquee-logos-section",
  "limit": 2,
  "settings": [
    {
      "type": "header",
      "content": "Appearance"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Border colour",
      "default": "#E2E2E2"
    },
    {
      "type": "header",
      "content": "Spacing — Desktop"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding top",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "default": 20
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding bottom",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "default": 20
    },
    {
      "type": "header",
      "content": "Spacing — Mobile"
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "Padding top (mobile)",
      "min": 0,
      "max": 60,
      "step": 2,
      "unit": "px",
      "default": 12
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "Padding bottom (mobile)",
      "min": 0,
      "max": 60,
      "step": 2,
      "unit": "px",
      "default": 12
    },
    {
      "type": "header",
      "content": "Logo display"
    },
    {
      "type": "range",
      "id": "image_opacity",
      "label": "Logo opacity",
      "min": 20,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 55,
      "info": "Logos become fully opaque on hover."
    },
    {
      "type": "select",
      "id": "image_filter",
      "label": "Logo colour treatment",
      "options": [
        { "value": "none",                   "label": "Original colour"    },
        { "value": "grayscale(1)",           "label": "Grayscale"          },
        { "value": "invert(1)",              "label": "Inverted"           },
        { "value": "grayscale(1) invert(1)", "label": "Grayscale + Invert" }
      ],
      "default": "grayscale(1)"
    },
    {
      "type": "header",
      "content": "Separator"
    },
    {
      "type": "select",
      "id": "separator",
      "label": "Separator between logos",
      "options": [
        { "value": "none",   "label": "None"         },
        { "value": "dot",    "label": "Middle dot ·" },
        { "value": "bullet", "label": "Bullet •"     },
        { "value": "pipe",   "label": "Pipe |"       },
        { "value": "dash",   "label": "Em dash —"    },
        { "value": "star",   "label": "Star ✦"       }
      ],
      "default": "none"
    },
    {
      "type": "header",
      "content": "Animation"
    },
    {
      "type": "checkbox",
      "id": "animate",
      "label": "Enable scrolling animation",
      "default": true
    },
    {
      "type": "select",
      "id": "direction",
      "label": "Scroll direction",
      "options": [
        { "value": "left",  "label": "Left ←"  },
        { "value": "right", "label": "Right →" }
      ],
      "default": "left"
    },
    {
      "type": "range",
      "id": "speed",
      "label": "Animation duration",
      "min": 10,
      "max": 120,
      "step": 5,
      "unit": "s",
      "default": 40,
      "info": "Lower = faster scroll. Higher = slower scroll."
    },
    {
      "type": "header",
      "content": "Edge fade"
    },
    {
      "type": "checkbox",
      "id": "show_fade",
      "label": "Show edge fade",
      "default": true
    },
    {
      "type": "header",
      "content": "Accessibility"
    },
    {
      "type": "text",
      "id": "aria_label",
      "label": "Section label (screen readers)",
      "default": "As seen in",
      "info": "Read aloud by screen readers to describe this section."
    }
  ],
  "blocks": [
    {
      "type": "logo",
      "name": "Logo",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Logo image",
          "info": "SVG or transparent PNG recommended."
        },
        {
          "type": "text",
          "id": "alt_text",
          "label": "Alt text",
          "placeholder": "e.g. Vogue",
          "info": "Describes the logo to screen readers."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Marquee — Logo Bar",
      "blocks": [
        { "type": "logo" },
        { "type": "logo" },
        { "type": "logo" },
        { "type": "logo" },
        { "type": "logo" },
        { "type": "logo" }
      ]
    }
  ]
}
{% endschema %}
