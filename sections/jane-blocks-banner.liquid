
{% comment %}
  JANÉ - Blocks Banner
{% endcomment %}

{{ 'jane-blocks-banner.css' | asset_url | stylesheet_tag }}
<script src="{{ 'jane-blocks-banner.js' | asset_url }}" defer="defer"></script>

<section
  id="JaneBlocksBanner-{{ section.id }}"
  class="jane-blocks-banner jane-blocks-banner--desktop-{{ section.settings.desktop_columns }} jane-blocks-banner--mobile-{{ section.settings.mobile_columns }}"
  style="
    --jbb-gap: {{ section.settings.grid_gap }}px;
    --jbb-radius: {{ section.settings.corner_radius }}px;
    --jbb-title-desktop: {{ section.settings.title_size_desktop }}px;
    --jbb-title-mobile: {{ section.settings.title_size_mobile }}px;
    --jbb-text-color: {{ section.settings.text_color }};
    --jbb-overlay: {{ section.settings.overlay_opacity | divided_by: 100.0 }};
    --jbb-content-width: {{ section.settings.content_width }}%;
    --jbb-section-padding-top: {{ section.settings.padding_top }}px;
    --jbb-section-padding-bottom: {{ section.settings.padding_bottom }}px;
  "
  data-jane-blocks-banner
>
  {% if section.settings.section_title != blank %}
    <div class="jane-blocks-banner__intro page-width">
      <h2 class="jane-blocks-banner__section-title">
        {{ section.settings.section_title | escape }}
      </h2>

      {% if section.settings.section_description != blank %}
        <div class="jane-blocks-banner__section-description">
          {{ section.settings.section_description }}
        </div>
      {% endif %}
    </div>
  {% endif %}

  <div class="jane-blocks-banner__grid page-width">

    {% for block in section.blocks %}

      {% liquid
        assign desktop_image = block.settings.desktop_image
        assign mobile_image = block.settings.mobile_image

        if mobile_image == blank
          assign mobile_image = desktop_image
        endif

        assign image_alt = block.settings.image_alt

        if image_alt == blank and desktop_image != blank
          assign image_alt = desktop_image.alt
        endif
      %}

      <article
        class="jane-blocks-banner__item"
        {{ block.shopify_attributes }}
      >

        {% if block.settings.link != blank %}
          <a
            class="jane-blocks-banner__link"
            href="{{ block.settings.link }}"
          >
        {% else %}
          <div class="jane-blocks-banner__link">
        {% endif %}

          <div class="jane-blocks-banner__media jane-blocks-banner__media--{{ section.settings.image_ratio }}">

            {% if desktop_image != blank %}

              <picture>

                {% if mobile_image != blank %}
                  <source
                    media="(max-width: 749px)"
                    srcset="
                      {{ mobile_image | image_url: width: 375 }} 375w,
                      {{ mobile_image | image_url: width: 550 }} 550w,
                      {{ mobile_image | image_url: width: 750 }} 750w
                    "
                    sizes="(max-width: 749px) 100vw, 50vw"
                  >
                {% endif %}

                {{
                  desktop_image
                  | image_url: width: 2400
                  | image_tag:
                    class: 'jane-blocks-banner__image',
                    widths: '375, 550, 750, 990, 1200, 1500, 1800, 2200, 2400',
                    sizes: '(min-width: 750px) 50vw, 100vw',
                    loading: 'lazy',
                    alt: image_alt
                }}

              </picture>

            {% else %}

              {{ 'lifestyle-1' | placeholder_svg_tag: 'jane-blocks-banner__placeholder' }}

            {% endif %}

            {% if section.settings.content_overlay %}
              <span
                class="jane-blocks-banner__shade"
                aria-hidden="true"
              ></span>
            {% endif %}

            {% if block.settings.heading != blank or block.settings.description != blank or block.settings.button_label != blank %}

              <div class="jane-blocks-banner__content jane-blocks-banner__content--{{ block.settings.content_position }}">

                {% if block.settings.eyebrow != blank %}
                  <p class="jane-blocks-banner__eyebrow">
                    {{ block.settings.eyebrow | escape }}
                  </p>
                {% endif %}

                {% if block.settings.heading != blank %}
                  <h3 class="jane-blocks-banner__title">
                    {{ block.settings.heading | escape }}
                  </h3>
                {% endif %}

                {% if block.settings.description != blank %}
                  <div class="jane-blocks-banner__description">
                    {{ block.settings.description }}
                  </div>
                {% endif %}

                {% if block.settings.button_label != blank %}
                  <span class="jane-blocks-banner__button">
                    {{ block.settings.button_label | escape }}
                  </span>
                {% endif %}

              </div>

            {% endif %}

          </div>

        {% if block.settings.link != blank %}
          </a>
        {% else %}
          </div>
        {% endif %}

      </article>

    {% endfor %}

  </div>
</section>

{% schema %}
{
  "name": "JANÉ - Blocks Banner",
  "tag": "section",
  "class": "section-jane-blocks-banner",
  "max_blocks": 3,
  "settings": [
    {
      "type": "text",
      "id": "section_title",
      "label": "Section title"
    },
    {
      "type": "richtext",
      "id": "section_description",
      "label": "Section description"
    },
    {
      "type": "select",
      "id": "desktop_columns",
      "label": "Desktop layout",
      "options": [
        { "value": "1", "label": "1 image" },
        { "value": "2", "label": "2 images" },
        { "value": "3", "label": "3 images" }
      ],
      "default": "2"
    },
    {
      "type": "select",
      "id": "mobile_columns",
      "label": "Mobile layout",
      "options": [
        { "value": "1", "label": "1 column" },
        { "value": "2", "label": "2 columns" }
      ],
      "default": "1"
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "Image ratio",
      "options": [
        { "value": "adapt", "label": "Adapt to image" },
        { "value": "square", "label": "Square" },
        { "value": "portrait", "label": "Portrait" },
        { "value": "landscape", "label": "Landscape" }
      ],
      "default": "adapt"
    },
    {
      "type": "checkbox",
      "id": "content_overlay",
      "label": "Show text over image",
      "default": true
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "Image overlay darkness",
      "min": 0,
      "max": 80,
      "step": 5,
      "unit": "%",
      "default": 15
    },
    {
      "type": "range",
      "id": "content_width",
      "label": "Text content width",
      "min": 30,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 85
    },
    {
      "type": "select",
      "id": "text_color",
      "label": "Text color",
      "options": [
        { "value": "#ffffff", "label": "White" },
        { "value": "#171717", "label": "Black" }
      ],
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "title_size_desktop",
      "label": "Desktop title size",
      "min": 16,
      "max": 64,
      "step": 2,
      "unit": "px",
      "default": 36
    },
    {
      "type": "range",
      "id": "title_size_mobile",
      "label": "Mobile title size",
      "min": 14,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "grid_gap",
      "label": "Space between images",
      "min": 0,
      "max": 30,
      "step": 2,
      "unit": "px",
      "default": 8
    },
    {
      "type": "range",
      "id": "corner_radius",
      "label": "Image corner radius",
      "min": 0,
      "max": 24,
      "step": 2,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top spacing",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom spacing",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 0
    }
  ],
  "blocks": [
    {
      "type": "banner",
      "name": "Banner image",
      "settings": [
        {
          "type": "image_picker",
          "id": "desktop_image",
          "label": "Desktop image"
        },
        {
          "type": "image_picker",
          "id": "mobile_image",
          "label": "Mobile image (optional)"
        },
        {
          "type": "text",
          "id": "image_alt",
          "label": "Image alt text"
        },
        {
          "type": "text",
          "id": "eyebrow",
          "label": "Small heading"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Title"
        },
        {
          "type": "richtext",
          "id": "description",
          "label": "Description"
        },
        {
          "type": "text",
          "id": "button_label",
          "label": "Button label"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Banner link"
        },
        {
          "type": "select",
          "id": "content_position",
          "label": "Text position",
          "options": [
            { "value": "top-left", "label": "Top left" },
            { "value": "top-center", "label": "Top center" },
            { "value": "center-left", "label": "Center left" },
            { "value": "center", "label": "Center" },
            { "value": "bottom-left", "label": "Bottom left" },
            { "value": "bottom-center", "label": "Bottom center" }
          ],
          "default": "bottom-left"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "JANÉ - Blocks Banner",
      "blocks": [
        { "type": "banner" },
        { "type": "banner" }
      ]
    }
  ]
}
{% endschema %}