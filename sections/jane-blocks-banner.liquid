
{{ 'jane-blocks-banner.css' | asset_url | stylesheet_tag }}
<script src="{{ 'jane-blocks-banner.js' | asset_url }}" defer="defer"></script>

<section
  id="JaneBlocksBanner-{{ section.id }}"
  class="jbb jbb--desktop-{{ section.settings.desktop_layout }} jbb--mobile-{{ section.settings.mobile_layout }}"
  style="
    --jbb-gap: {{ section.settings.gap }}px;
    --jbb-radius: {{ section.settings.radius }}px;
    --jbb-overlay: {{ section.settings.overlay_opacity | divided_by: 100.0 }};
    --jbb-title-color: {{ section.settings.title_color }};
    --jbb-text-color: {{ section.settings.text_color }};
    --jbb-title-desktop: {{ section.settings.title_size_desktop }}px;
    --jbb-title-mobile: {{ section.settings.title_size_mobile }}px;
    --jbb-padding-top: {{ section.settings.padding_top }}px;
    --jbb-padding-bottom: {{ section.settings.padding_bottom }}px;
  "
  data-jbb-section
>
  <div class="jbb__container page-width">

    {% if section.settings.heading != blank %}
      <div class="jbb__header">
        <h2 class="jbb__section-heading">
          {{ section.settings.heading | escape }}
        </h2>

        {% if section.settings.description != blank %}
          <div class="jbb__description">
            {{ section.settings.description }}
          </div>
        {% endif %}
      </div>
    {% endif %}

    <div class="jbb__slider-wrapper">

      <div
        class="jbb__grid"
        data-jbb-track
        {% if section.settings.mobile_layout == 'carousel' %}
          aria-label="{{ section.settings.heading | escape }}"
        {% endif %}
      >

        {% for block in section.blocks %}

          {% liquid
            assign desktop_image = block.settings.desktop_image
            assign mobile_image = block.settings.mobile_image

            if mobile_image == blank
              assign mobile_image = desktop_image
            endif

            assign image_alt = block.settings.image_alt

            if image_alt == blank and desktop_image != blank
              assign image_alt = desktop_image.alt
            endif

            assign title_tag = block.settings.heading_tag
          %}

          <article
            class="jbb__item jbb__item--{{ forloop.index }}"
            {{ block.shopify_attributes }}
          >

            {% if block.settings.link != blank %}
              <a
                href="{{ block.settings.link }}"
                class="jbb__link"
                {% if block.settings.open_new_tab %}
                  target="_blank"
                  rel="noopener noreferrer"
                {% endif %}
              >
            {% else %}
              <div class="jbb__link">
            {% endif %}

              <div class="jbb__media jbb__media--{{ section.settings.image_ratio }}">

                {% if desktop_image != blank %}

                  <picture>

                    {% if mobile_image != blank %}
                      <source
                        media="(max-width: 749px)"
                        srcset="
                          {{ mobile_image | image_url: width: 375 }} 375w,
                          {{ mobile_image | image_url: width: 550 }} 550w,
                          {{ mobile_image | image_url: width: 750 }} 750w
                        "
                        sizes="(max-width: 749px) 100vw, 50vw"
                      >
                    {% endif %}

                    {{
                      desktop_image
                      | image_url: width: 2000
                      | image_tag:
                        class: 'jbb__image',
                        widths: '375, 550, 750, 990, 1200, 1500, 1800, 2000',
                        sizes: '(max-width: 749px) 100vw, 50vw',
                        loading: 'lazy',
                        alt: image_alt
                    }}

                  </picture>

                {% else %}

                  {{ 'lifestyle-1' | placeholder_svg_tag: 'jbb__placeholder' }}

                {% endif %}

                {% if section.settings.show_overlay %}
                  <span class="jbb__overlay"></span>
                {% endif %}

                {% if block.settings.eyebrow != blank or block.settings.title != blank or block.settings.button_label != blank or block.settings.description != blank %}

                  <div class="jbb__content jbb__content--{{ block.settings.content_position }}">

                    {% if block.settings.eyebrow != blank %}
                      <p class="jbb__eyebrow">
                        {{ block.settings.eyebrow | escape }}
                      </p>
                    {% endif %}

                    {% if block.settings.title != blank %}
                      <{{ title_tag }}
                        class="jbb__title"
                        style="
                          --jbb-block-title-desktop: {{ block.settings.title_size_desktop }}px;
                          --jbb-block-title-mobile: {{ block.settings.title_size_mobile }}px;
                        "
                      >
                        {{ block.settings.title | escape }}
                      </{{ title_tag }}>
                    {% endif %}

                    {% if block.settings.description != blank %}
                      <div class="jbb__text">
                        {{ block.settings.description }}
                      </div>
                    {% endif %}

                    {% if block.settings.button_label != blank %}
                      <span class="jbb__button">
                        {{ block.settings.button_label | escape }}
                      </span>
                    {% endif %}

                  </div>

                {% endif %}

              </div>

            {% if block.settings.link != blank %}
              </a>
            {% else %}
              </div>
            {% endif %}

          </article>

        {% endfor %}

      </div>

      {% if section.settings.mobile_layout == 'carousel' and section.settings.show_arrows %}
        <div class="jbb__controls">

          <button
            type="button"
            class="jbb__arrow jbb__arrow--prev"
            aria-label="Previous banner"
            data-jbb-prev
          >
            &#8592;
          </button>

          <button
            type="button"
            class="jbb__arrow jbb__arrow--next"
            aria-label="Next banner"
            data-jbb-next
          >
            &#8594;
          </button>

        </div>
      {% endif %}

    </div>
  </div>
</section>

{% schema %}
{
  "name": "JANÉ - Blocks Banner",
  "tag": "section",
  "class": "section-jane-blocks-banner",
  "max_blocks": 6,

  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Section heading",
      "default": "Products typology"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Section description"
    },
    {
      "type": "header",
      "content": "Desktop layout"
    },
    {
      "type": "select",
      "id": "desktop_layout",
      "label": "Desktop image layout",
      "options": [
        {
          "value": "two-plus-four",
          "label": "2 Top + 4 Bottom"
        },
        {
          "value": "two",
          "label": "2 Images - Equal"
        },
        {
          "value": "three",
          "label": "3 Images - Equal"
        },
        {
          "value": "four",
          "label": "4 Images - Equal"
        },
        {
          "value": "featured-left",
          "label": "Featured Image Left"
        },
        {
          "value": "featured-right",
          "label": "Featured Image Right"
        }
      ],
      "default": "two-plus-four"
    },
    {
      "type": "header",
      "content": "Mobile layout"
    },
    {
      "type": "select",
      "id": "mobile_layout",
      "label": "Mobile image layout",
      "options": [
        {
          "value": "stacked",
          "label": "Stacked - 1 Column"
        },
        {
          "value": "two",
          "label": "2 Columns"
        },
        {
          "value": "carousel",
          "label": "Carousel"
        }
      ],
      "default": "two"
    },
    {
      "type": "checkbox",
      "id": "show_arrows",
      "label": "Show carousel arrows",
      "default": true
    },
    {
      "type": "header",
      "content": "Image settings"
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "Image ratio",
      "options": [
        {
          "value": "adapt",
          "label": "Adapt to Image"
        },
        {
          "value": "square",
          "label": "Square 1:1"
        },
        {
          "value": "portrait",
          "label": "Portrait 4:5"
        },
        {
          "value": "landscape",
          "label": "Landscape 16:9"
        }
      ],
      "default": "adapt"
    },
    {
      "type": "range",
      "id": "gap",
      "label": "Image spacing",
      "min": 0,
      "max": 30,
      "step": 1,
      "unit": "px",
      "default": 8
    },
    {
      "type": "range",
      "id": "radius",
      "label": "Image corner radius",
      "min": 0,
      "max": 24,
      "step": 2,
      "unit": "px",
      "default": 4
    },
    {
      "type": "checkbox",
      "id": "show_overlay",
      "label": "Show image overlay",
      "default": true
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "Overlay opacity",
      "min": 0,
      "max": 80,
      "step": 5,
      "unit": "%",
      "default": 30
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "range",
      "id": "title_size_desktop",
      "label": "Default desktop title size",
      "min": 12,
      "max": 64,
      "step": 2,
      "unit": "px",
      "default": 32
    },
    {
      "type": "range",
      "id": "title_size_mobile",
      "label": "Default mobile title size",
      "min": 12,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 22
    },
    {
      "type": "color",
      "id": "title_color",
      "label": "Section title color",
      "default": "#171717"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Banner text color",
      "default": "#ffffff"
    },
    {
      "type": "header",
      "content": "Section spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 24
    }
  ],

  "blocks": [
    {
      "type": "banner",
      "name": "Banner block",
      "settings": [
        {
          "type": "image_picker",
          "id": "desktop_image",
          "label": "Desktop image"
        },
        {
          "type": "image_picker",
          "id": "mobile_image",
          "label": "Mobile image"
        },
        {
          "type": "text",
          "id": "image_alt",
          "label": "Image alt text"
        },
        {
          "type": "text",
          "id": "eyebrow",
          "label": "Small heading"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Banner title"
        },
        {
          "type": "select",
          "id": "heading_tag",
          "label": "Title HTML tag",
          "options": [
            {
              "value": "h1",
              "label": "H1"
            },
            {
              "value": "h2",
              "label": "H2"
            },
            {
              "value": "h3",
              "label": "H3"
            }
          ],
          "default": "h2"
        },
        {
          "type": "range",
          "id": "title_size_desktop",
          "label": "Desktop title size",
          "min": 12,
          "max": 64,
          "step": 2,
          "unit": "px",
          "default": 32
        },
        {
          "type": "range",
          "id": "title_size_mobile",
          "label": "Mobile title size",
          "min": 12,
          "max": 40,
          "step": 2,
          "unit": "px",
          "default": 22
        },
        {
          "type": "richtext",
          "id": "description",
          "label": "Description"
        },
        {
          "type": "text",
          "id": "button_label",
          "label": "Button label"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Banner link"
        },
        {
          "type": "checkbox",
          "id": "open_new_tab",
          "label": "Open link in new tab",
          "default": false
        },
        {
          "type": "select",
          "id": "content_position",
          "label": "Text position",
          "options": [
            {
              "value": "top-left",
              "label": "Top Left"
            },
            {
              "value": "top-center",
              "label": "Top Center"
            },
            {
              "value": "center-left",
              "label": "Center Left"
            },
            {
              "value": "center",
              "label": "Center"
            },
            {
              "value": "bottom-left",
              "label": "Bottom Left"
            },
            {
              "value": "bottom-center",
              "label": "Bottom Center"
            }
          ],
          "default": "bottom-left"
        }
      ]
    }
  ],

  "presets": [
    {
      "name": "JANÉ - Blocks Banner",
      "blocks": [
        {
          "type": "banner"
        },
        {
          "type": "banner"
        },
        {
          "type": "banner"
        },
        {
          "type": "banner"
        },
        {
          "type": "banner"
        },
        {
          "type": "banner"
        }
      ]
    }
  ]
}
{% endschema %}
