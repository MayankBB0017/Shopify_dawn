{{ 'section-jane-blocks-banner.css' | asset_url | stylesheet_tag }}
{{ 'component-slider.css' | asset_url | stylesheet_tag }}
{{ 'component-buttons.css' | asset_url | stylesheet_tag }}
<script src="{{ 'jane-blocks-banner.js' | asset_url }}" defer="defer"></script>

{%- liquid
  assign card_count = 0
  for block in section.blocks
    if block.type == 'card'
      assign card_count = card_count | plus: 1
    endif
  endfor

  assign auto_layout = 'layout-1'
  if card_count == 2
    assign auto_layout = 'layout-2'
  elsif card_count == 3
    assign auto_layout = 'layout-3'
  elsif card_count == 4
    assign auto_layout = 'layout-4'
  elsif card_count > 4
    if section.settings.extended_layout == '3_plus_3'
      assign auto_layout = 'layout-3-plus-3'
    else
      assign auto_layout = 'layout-2-plus-4'
    endif
  endif

  assign layout_variant = 'strip'
  if card_count > 4
    assign layout_variant = 'grid'
  endif

  assign enable_spacing = section.settings.enable_block_spacing
  assign show_mobile_slider = false
  if section.settings.enable_mobile_slider and card_count > 1 and card_count <= 4
    assign show_mobile_slider = true
  endif

  assign container_class = 'page-width'
  assign container_modifier = 'standard'
  if section.settings.container_width == 'full_width'
    assign container_class = ''
    assign container_modifier = 'full'
  endif

  assign block_radius = 0
  if enable_spacing
    assign block_radius = section.settings.block_border_radius
  endif

  assign overlay_rgb = '0, 0, 0'
  if section.settings.overlay_color != blank
    assign overlay_rgb = section.settings.overlay_color.red | append: ', ' | append: section.settings.overlay_color.green | append: ', ' | append: section.settings.overlay_color.blue
  endif

  assign height_desktop = '659px'
  assign height_mobile = '418px'
  if layout_variant == 'grid'
    assign height_desktop = '418px'
    assign height_mobile = '250px'
  endif

  case section.settings.card_height_desktop
    when 'large_659'
      assign height_desktop = '659px'
    when 'medium_418'
      assign height_desktop = '418px'
  endcase

  case section.settings.card_height_mobile
    when 'medium_418'
      assign height_mobile = '418px'
    when 'small_250'
      assign height_mobile = '250px'
  endcase
  assign enable_hover = true
  if section.settings.enable_hover_effect == false
    assign enable_hover = false
  endif
-%}

{%- style -%}
  #JaneBlocksBanner-{{ section.id }} {
    --jbb-padding-top-mobile: {{ section.settings.padding_top_mobile }}px;
    --jbb-padding-bottom-mobile: {{ section.settings.padding_bottom_mobile }}px;
    --jbb-padding-top-desktop: {{ section.settings.padding_top_desktop }}px;
    --jbb-padding-bottom-desktop: {{ section.settings.padding_bottom_desktop }}px;
  }
{%- endstyle -%}

<jane-blocks-banner
  id="JaneBlocksBanner-{{ section.id }}"
  class="jane-blocks-banner color-{{ section.settings.color_scheme }} gradient jane-blocks-banner--{{ auto_layout }} jane-blocks-banner--variant-{{ layout_variant }} jane-blocks-banner--container-{{ container_modifier }}{% if enable_spacing %} jane-blocks-banner--spaced{% endif %}{% unless enable_hover %} jane-blocks-banner--hover-disabled{% endunless %}{% if section.settings.enable_fade_in_desktop %} jane-blocks-banner--fade-in-desktop{% endif %}{% if section.settings.enable_fade_in_mobile %} jane-blocks-banner--fade-in-mobile{% endif %}"
  {% if section.settings.accessibility_label != blank %}
    aria-label="{{ section.settings.accessibility_label | escape }}"
  {% endif %}
  style="--jbb-card-height-desktop: {{ height_desktop }}; --jbb-card-height-mobile: {{ height_mobile }}; --jbb-card-radius: {{ block_radius }}px; --jbb-overlay-rgb: {{ overlay_rgb }};"
>
  {%- if section.settings.heading != blank -%}
    <div class="jane-blocks-banner__header {{ container_class }}">
      <h2 class="jane-blocks-banner__heading {{ section.settings.heading_size }} inline-richtext">
        {{ section.settings.heading }}
      </h2>
    </div>
  {%- endif -%}

  {%- if card_count > 0 -%}
    {%- capture grid_classes -%}
      jane-blocks-banner__grid jane-blocks-banner__grid--{{ auto_layout }}{% if show_mobile_slider %} slider slider--tablet grid--peek{% endif %}
    {%- endcapture -%}

    {%- if show_mobile_slider -%}
      <slider-component class="jane-blocks-banner__slider slider-mobile-gutter{% if section.settings.container_width == 'full_width' %} slider-component-full-width{% endif %} {{ container_class }}">
        <ul id="JaneBlocksBannerSlider-{{ section.id }}" class="{{ grid_classes | strip }}" role="list">
          {%- for block in section.blocks -%}
            {%- if block.type == 'card' -%}
              {%- liquid
                assign card_size = 'large'
                if card_count > 4 and auto_layout == 'layout-2-plus-4'
                  if forloop.index > 2
                    assign card_size = 'small'
                  endif
                endif
              -%}
              {% render 'jane-blocks-banner-card',
                block: block,
                section: section,
                layout_variant: layout_variant,
                card_size: card_size,
                block_index: forloop.index,
                show_mobile_slider: true
              %}
            {%- endif -%}
          {%- endfor -%}
        </ul>
      </slider-component>
    {%- else -%}
      <div class="jane-blocks-banner__grid-wrapper {{ container_class }}">
        <ul class="{{ grid_classes | strip }}" role="list">
          {%- for block in section.blocks -%}
            {%- if block.type == 'card' -%}
              {%- liquid
                assign card_size = 'large'
                if card_count > 4 and auto_layout == 'layout-2-plus-4'
                  if forloop.index > 2
                    assign card_size = 'small'
                  endif
                endif
              -%}
              {% render 'jane-blocks-banner-card',
                block: block,
                section: section,
                layout_variant: layout_variant,
                card_size: card_size,
                block_index: forloop.index,
                show_mobile_slider: false
              %}
            {%- endif -%}
          {%- endfor -%}
        </ul>
      </div>
    {%- endif -%}
  {%- endif -%}
</jane-blocks-banner>

