{{ 'jane-blocks-banner.css' | asset_url | stylesheet_tag }}
<script src="{{ 'jane-blocks-banner.js' | asset_url }}" defer="defer"></script>

<section
  id="JaneBlocksBanner-{{ section.id }}"
  class="jbb jbb--desktop-{{ section.settings.desktop_layout }} jbb--mobile-{{ section.settings.mobile_layout }} jbb--padding-{{ section.settings.padding_mode }} jbb--hover-{{ section.settings.hover_effect }} jbb--gradient-{{ section.settings.gradient_direction }}{% if section.settings.fade_desktop %} jbb--fade-desktop{% endif %}{% if section.settings.fade_mobile %} jbb--fade-mobile{% endif %}"
  style="
    --jbb-gap: {{ section.settings.card_gap }}px;
    --jbb-radius: {{ section.settings.corner_radius }}px;
    --jbb-overlay-opacity: {{ section.settings.overlay_opacity | divided_by: 100.0 }};
    --jbb-section-bg: {{ section.settings.section_background }};
    --jbb-section-title-color: {{ section.settings.section_title_color }};
    --jbb-section-pt: {{ section.settings.section_padding_top }}px;
    --jbb-section-pb: {{ section.settings.section_padding_bottom }}px;
    --jbb-top-ratio: {{ section.settings.top_image_ratio }};
    --jbb-bottom-ratio: {{ section.settings.bottom_image_ratio }};
  "
  data-jbb-section
>
  <div class="jbb__container{% if section.settings.content_width == 'theme' %} page-width{% endif %}">

    {% if section.settings.section_title != blank or section.settings.section_description != blank %}
      <header class="jbb__header">

        {% if section.settings.section_title != blank %}
          <h2 class="jbb__section-title jbb__section-title--desktop-{{ section.settings.section_title_size_desktop }} jbb__section-title--mobile-{{ section.settings.section_title_size_mobile }}">
            {{ section.settings.section_title | escape }}
          </h2>
        {% endif %}

        {% if section.settings.section_description != blank %}
          <div class="jbb__section-description rte">
            {{ section.settings.section_description }}
          </div>
        {% endif %}

      </header>
    {% endif %}

    <div class="jbb__grid" data-jbb-track>

      {% for block in section.blocks %}

        {% liquid
          assign desktop_media_type = block.settings.desktop_media_type
          assign mobile_media_type = block.settings.mobile_media_type

          assign desktop_image = block.settings.desktop_image
          assign mobile_image = block.settings.mobile_image

          assign desktop_video = block.settings.desktop_video
          assign mobile_video = block.settings.mobile_video

          if mobile_media_type == 'inherit'
            assign mobile_media_type = desktop_media_type
            assign mobile_image = desktop_image
            assign mobile_video = desktop_video
          elsif mobile_media_type == 'image' and mobile_image == blank
            assign mobile_image = desktop_image
          elsif mobile_media_type == 'video' and mobile_video == blank
            if desktop_video != blank
              assign mobile_video = desktop_video
            else
              assign mobile_media_type = 'image'
              assign mobile_image = desktop_image
            endif
          endif

          assign card_label = block.settings.title | default: block.settings.button_label | default: 'View details'
        %}

        <article
          class="jbb__item"
          style="
            --jbb-block-pt: {{ block.settings.padding_top }}px;
            --jbb-block-pr: {{ block.settings.padding_right }}px;
            --jbb-block-pb: {{ block.settings.padding_bottom }}px;
            --jbb-block-pl: {{ block.settings.padding_left }}px;
            --jbb-block-mpt: {{ block.settings.mobile_padding_top }}px;
            --jbb-block-mpr: {{ block.settings.mobile_padding_right }}px;
            --jbb-block-mpb: {{ block.settings.mobile_padding_bottom }}px;
            --jbb-block-mpl: {{ block.settings.mobile_padding_left }}px;
            --jbb-block-text-desktop: {{ block.settings.desktop_text_color }};
            --jbb-block-text-mobile: {{ block.settings.mobile_text_color }};
          "
          {{ block.shopify_attributes }}
        >

          <div class="jbb__card">

              <div class="jbb__media jbb__media--{{ section.settings.image_ratio }}">

                <!-- DESKTOP MEDIA -->

                <div class="jbb__media-desktop">

                  {% if desktop_media_type == 'video' and desktop_video != blank %}

                    {{
                      desktop_video
                      | video_tag:
                        class: 'jbb__video jbb__video--desktop',
                        autoplay: block.settings.video_autoplay,
                        loop: block.settings.video_loop,
                        muted: true,
                        controls: block.settings.video_controls,
                        playsinline: true,
                        preload: 'metadata'
                    }}

                  {% elsif desktop_image != blank %}

                    {{
                      desktop_image
                      | image_url: width: 2400
                      | image_tag:
                        class: 'jbb__image jbb__image--desktop',
                        widths: '375, 550, 750, 990, 1200, 1500, 1800, 2000, 2400',
                        sizes: '(min-width: 990px) 50vw, 100vw',
                        loading: 'lazy',
                        alt: desktop_image.alt
                    }}

                  {% else %}

                    {{ 'lifestyle-1' | placeholder_svg_tag: 'jbb__placeholder' }}

                  {% endif %}

                </div>

                <!-- MOBILE MEDIA -->

                <div class="jbb__media-mobile">

                  {% if mobile_media_type == 'video' and mobile_video != blank %}

                    {{
                      mobile_video
                      | video_tag:
                        class: 'jbb__video jbb__video--mobile',
                        autoplay: block.settings.video_autoplay,
                        loop: block.settings.video_loop,
                        muted: true,
                        controls: block.settings.video_controls,
                        playsinline: true,
                        preload: 'metadata'
                    }}

                  {% elsif mobile_image != blank %}

                    {{
                      mobile_image
                      | image_url: width: 1400
                      | image_tag:
                        class: 'jbb__image jbb__image--mobile',
                        widths: '375, 550, 750, 990, 1200, 1400',
                        sizes: '100vw',
                        loading: 'lazy',
                        alt: mobile_image.alt
                    }}

                  {% else %}

                    {{ 'lifestyle-1' | placeholder_svg_tag: 'jbb__placeholder' }}

                  {% endif %}

                </div>

                <!-- GRADIENT -->

                {% if section.settings.show_gradient %}
                  <span class="jbb__overlay" aria-hidden="true"></span>
                {% endif %}

                <!-- CONTENT -->

                {% if block.settings.title != blank or block.settings.description != blank or block.settings.button_label != blank %}

                  <div class="jbb__content jbb__content--desktop-{{ block.settings.desktop_position }} jbb__content--mobile-{{ block.settings.mobile_position }}">

                    {% if block.settings.title != blank %}
                      {% if block.settings.link != blank %}
                        <a
                          class="jbb__title-link"
                          href="{{ block.settings.link }}"
                          {% if block.settings.open_new_tab %}
                            target="_blank"
                            rel="noopener noreferrer"
                          {% endif %}
                        >
                          <h3 class="jbb__title jbb__title--desktop-{{ section.settings.title_size_desktop }} jbb__title--mobile-{{ section.settings.title_size_mobile }}">
                            {{ block.settings.title | escape }}
                          </h3>
                        </a>
                      {% else %}
                        <h3 class="jbb__title jbb__title--desktop-{{ section.settings.title_size_desktop }} jbb__title--mobile-{{ section.settings.title_size_mobile }}">
                          {{ block.settings.title | escape }}
                        </h3>
                      {% endif %}
                    {% endif %}

                    {% if block.settings.description != blank %}
                      <div class="jbb__description jbb__description--desktop-{{ section.settings.content_size_desktop }} jbb__description--mobile-{{ section.settings.content_size_mobile }} rte">
                        {{ block.settings.description }}
                      </div>
                    {% endif %}

                    {% if block.settings.button_label != blank and block.settings.button_position == 'inline' %}
                      <span class="jbb__button-wrap jbb__button-wrap--inline">
                        <span class="jbb__button jbb__button--{{ section.settings.button_type }}">
                          {{ block.settings.button_label | escape }}
                        </span>
                      </span>
                    {% endif %}

                  </div>

                {% endif %}

                {% if block.settings.button_label != blank and block.settings.button_position == 'bottom' %}
                  <span class="jbb__button-wrap jbb__button-wrap--bottom">
                    <span class="jbb__button jbb__button--{{ section.settings.button_type }}">
                      {{ block.settings.button_label | escape }}
                    </span>
                  </span>
                {% endif %}

              </div>

          </div>

        </article>

      {% endfor %}

    </div>

    {% if section.settings.mobile_layout == 'carousel' and section.settings.show_carousel_arrows %}
      <div class="jbb__controls">
        <button type="button" class="jbb__arrow" data-jbb-prev aria-label="Previous banner">
          &#8592;
        </button>
        <button type="button" class="jbb__arrow" data-jbb-next aria-label="Next banner">
          &#8594;
        </button>
      </div>
    {% endif %}

  </div>
</section>

{% comment %}
  Each banner card is clickable when its block Link setting is filled.
  Select a Shopify collection, product, page, or paste a URL in that setting.
{% endcomment %}

{% schema %}
{
  "name": "JANÉ - Blocks Banner",
  "tag": "section",
  "class": "section-jane-blocks-banner",
  "max_blocks": 6,
  "settings": [
    {
      "type": "text",
      "id": "section_title",
      "label": "Section title",
      "default": "Products typology"
    },
    {
      "type": "richtext",
      "id": "section_description",
      "label": "Section description"
    },
    {
      "type": "color",
      "id": "section_title_color",
      "label": "Section title color",
      "default": "#171717"
    },

    {
      "type": "header",
      "content": "Desktop and mobile layouts"
    },
    {
      "type": "select",
      "id": "desktop_layout",
      "label": "Desktop layout",
      "options": [
        { "value": "two-plus-four", "label": "2 Top + 4 Bottom" },
        { "value": "three-plus-three", "label": "3 + 3 Combination" },
        { "value": "two", "label": "2 Columns" },
        { "value": "three", "label": "3 Columns" },
        { "value": "four", "label": "4 Columns" }
      ],
      "default": "two-plus-four"
    },
    {
      "type": "select",
      "id": "mobile_layout",
      "label": "Mobile layout",
      "options": [
        { "value": "one", "label": "1 Column" },
        { "value": "two", "label": "2 Columns" },
        { "value": "carousel", "label": "Carousel" }
      ],
      "default": "two"
    },
    {
      "type": "checkbox",
      "id": "show_carousel_arrows",
      "label": "Show carousel arrows",
      "default": true
    },

    {
      "type": "header",
      "content": "Image ratios"
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "Standard block image ratio",
      "options": [
        { "value": "portrait", "label": "4:5" },
        { "value": "square", "label": "1:1" },
        { "value": "landscape", "label": "3:2" }
      ],
      "default": "portrait"
    },
    {
      "type": "select",
      "id": "top_image_ratio",
      "label": "Top image ratio",
      "options": [
        { "value": "1.5", "label": "3:2" },
        { "value": "1.7777778", "label": "16:9" },
        { "value": "1", "label": "1:1" }
      ],
      "default": "1.5"
    },
    {
      "type": "select",
      "id": "bottom_image_ratio",
      "label": "Bottom image ratio",
      "options": [
        { "value": "0.8", "label": "4:5" },
        { "value": "1", "label": "1:1" },
        { "value": "1.5", "label": "3:2" }
      ],
      "default": "0.8"
    },

    {
      "type": "header",
      "content": "Section width and spacing"
    },
    {
      "type": "select",
      "id": "padding_mode",
      "label": "Section / card spacing",
      "options": [
        { "value": "with", "label": "With Paddings" },
        { "value": "without", "label": "Without Paddings / Full Width" },
        { "value": "side", "label": "Only Side Paddings" }
      ],
      "default": "with"
    },
    {
      "type": "select",
      "id": "content_width",
      "label": "Content max width",
      "options": [
        { "value": "theme", "label": "Use Theme Layout Width" },
        { "value": "full", "label": "Full Width" }
      ],
      "default": "theme"
    },
    {
      "type": "range",
      "id": "card_gap",
      "label": "Space between cards",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 8
    },
    {
      "type": "range",
      "id": "corner_radius",
      "label": "Card corner radius",
      "min": 0,
      "max": 24,
      "step": 2,
      "unit": "px",
      "default": 4
    },
    {
      "type": "color",
      "id": "section_background",
      "label": "Section background color",
      "default": "#FFFFFF"
    },

    {
      "type": "header",
      "content": "Overlay and text"
    },
    {
      "type": "checkbox",
      "id": "show_gradient",
      "label": "Enable gradient overlay",
      "default": true
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "Overlay opacity",
      "min": 0,
      "max": 90,
      "step": 5,
      "unit": "%",
      "default": 30
    },
    {
      "type": "select",
      "id": "gradient_direction",
      "label": "Gradient direction",
      "options": [
        { "value": "bottom", "label": "Bottom to Top" },
        { "value": "top", "label": "Top to Bottom" },
        { "value": "all", "label": "Full Overlay" }
      ],
      "default": "bottom"
    },

    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "select",
      "id": "section_title_size_desktop",
      "label": "Section heading size (desktop)",
      "options": [
        { "value": "h1", "label": "H1" },
        { "value": "h2", "label": "H2" },
        { "value": "h3", "label": "H3" },
        { "value": "h4", "label": "H4" },
        { "value": "h5", "label": "H5" }
      ],
      "default": "h2"
    },
    {
      "type": "select",
      "id": "section_title_size_mobile",
      "label": "Section heading size (mobile)",
      "options": [
        { "value": "h1", "label": "H1" },
        { "value": "h2", "label": "H2" },
        { "value": "h3", "label": "H3" },
        { "value": "h4", "label": "H4" },
        { "value": "h5", "label": "H5" }
      ],
      "default": "h3"
    },
    {
      "type": "select",
      "id": "title_size_desktop",
      "label": "Font Size Title (Desktop)",
      "options": [
        { "value": "h1", "label": "H1" },
        { "value": "h2", "label": "H2" },
        { "value": "h3", "label": "H3" },
        { "value": "h4", "label": "H4" },
        { "value": "h5", "label": "H5" }
      ],
      "default": "h3"
    },
    {
      "type": "select",
      "id": "title_size_mobile",
      "label": "Font Size Title (Mobile)",
      "options": [
        { "value": "h1", "label": "H1" },
        { "value": "h2", "label": "H2" },
        { "value": "h3", "label": "H3" },
        { "value": "h4", "label": "H4" },
        { "value": "h5", "label": "H5" }
      ],
      "default": "h4"
    },
    {
      "type": "select",
      "id": "content_size_desktop",
      "label": "Font Size Content (Desktop)",
      "options": [
        { "value": "big", "label": "Body Big" },
        { "value": "regular", "label": "Body Regular" },
        { "value": "small", "label": "Body Small" }
      ],
      "default": "regular"
    },
    {
      "type": "select",
      "id": "content_size_mobile",
      "label": "Font Size Content (Mobile)",
      "options": [
        { "value": "big", "label": "Body Big" },
        { "value": "regular", "label": "Body Regular" },
        { "value": "small", "label": "Body Small" }
      ],
      "default": "small"
    },

    {
      "type": "header",
      "content": "Buttons and hover"
    },
    {
      "type": "select",
      "id": "button_type",
      "label": "Button type",
      "options": [
        { "value": "filled", "label": "Filled" },
        { "value": "stroke", "label": "Stroke" },
        { "value": "link", "label": "Link" }
      ],
      "default": "filled"
    },
    {
      "type": "select",
      "id": "hover_effect",
      "label": "Desktop card hover",
      "options": [
        { "value": "none", "label": "None" },
        { "value": "zoom", "label": "Zoom In" },
        { "value": "blur", "label": "Blur Layer" }
      ],
      "default": "zoom"
    },
    {
      "type": "checkbox",
      "id": "fade_desktop",
      "label": "Enable fade-in on desktop",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "fade_mobile",
      "label": "Enable fade-in on mobile",
      "default": false
    },

    {
      "type": "header",
      "content": "Section padding"
    },
    {
      "type": "range",
      "id": "section_padding_top",
      "label": "Section top padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "section_padding_bottom",
      "label": "Section bottom padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 24
    }
  ],

  "blocks": [
    {
      "type": "banner",
      "name": "Banner block",
      "settings": [
        {
          "type": "header",
          "content": "Desktop media"
        },
        {
          "type": "select",
          "id": "desktop_media_type",
          "label": "Desktop media type",
          "options": [
            { "value": "image", "label": "Image" },
            { "value": "video", "label": "Video" }
          ],
          "default": "image"
        },
        {
          "type": "image_picker",
          "id": "desktop_image",
          "label": "Desktop image"
        },
        {
          "type": "video",
          "id": "desktop_video",
          "label": "Desktop video"
        },

        {
          "type": "header",
          "content": "Mobile media"
        },
        {
          "type": "select",
          "id": "mobile_media_type",
          "label": "Mobile media type",
          "options": [
            { "value": "inherit", "label": "Same as Desktop" },
            { "value": "image", "label": "Mobile Image" },
            { "value": "video", "label": "Mobile Video" }
          ],
          "default": "inherit"
        },
        {
          "type": "image_picker",
          "id": "mobile_image",
          "label": "Mobile image"
        },
        {
          "type": "video",
          "id": "mobile_video",
          "label": "Mobile video"
        },

        {
          "type": "header",
          "content": "Video settings"
        },
        {
          "type": "checkbox",
          "id": "video_autoplay",
          "label": "Autoplay video (muted)",
          "default": true
        },
        {
          "type": "checkbox",
          "id": "video_loop",
          "label": "Loop video",
          "default": true
        },
        {
          "type": "checkbox",
          "id": "video_controls",
          "label": "Show video controls",
          "default": false
        },

        {
          "type": "header",
          "content": "Content"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title"
        },
        {
          "type": "richtext",
          "id": "description",
          "label": "Description"
        },
        {
          "type": "color",
          "id": "desktop_text_color",
          "label": "Desktop text color",
          "default": "#FFFFFF"
        },
        {
          "type": "color",
          "id": "mobile_text_color",
          "label": "Mobile text color",
          "default": "#FFFFFF"
        },

        {
          "type": "select",
          "id": "desktop_position",
          "label": "Content position (desktop)",
          "options": [
            { "value": "top-left", "label": "Top Left" },
            { "value": "top-center", "label": "Top Center" },
            { "value": "top-right", "label": "Top Right" },
            { "value": "center-left", "label": "Center Left" },
            { "value": "center", "label": "Center" },
            { "value": "center-right", "label": "Center Right" },
            { "value": "bottom-left", "label": "Bottom Left" },
            { "value": "bottom-center", "label": "Bottom Center" },
            { "value": "bottom-right", "label": "Bottom Right" }
          ],
          "default": "bottom-left"
        },
        {
          "type": "select",
          "id": "mobile_position",
          "label": "Content position (mobile)",
          "options": [
            { "value": "top-left", "label": "Top Left" },
            { "value": "top-center", "label": "Top Center" },
            { "value": "top-right", "label": "Top Right" },
            { "value": "center-left", "label": "Center Left" },
            { "value": "center", "label": "Center" },
            { "value": "center-right", "label": "Center Right" },
            { "value": "bottom-left", "label": "Bottom Left" },
            { "value": "bottom-center", "label": "Bottom Center" },
            { "value": "bottom-right", "label": "Bottom Right" }
          ],
          "default": "bottom-left"
        },

        {
          "type": "header",
          "content": "Button and link"
        },
        {
          "type": "text",
          "id": "button_label",
          "label": "Button label"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Card / button link"
        },
        {
          "type": "checkbox",
          "id": "open_new_tab",
          "label": "Open link in new tab",
          "default": false
        },
        {
          "type": "select",
          "id": "button_position",
          "label": "Button position",
          "options": [
            { "value": "inline", "label": "Below Text" },
            { "value": "bottom", "label": "At Bottom of Card" }
          ],
          "default": "inline"
        },

        {
          "type": "header",
          "content": "Desktop block padding"
        },
        {
          "type": "range",
          "id": "padding_top",
          "label": "Top",
          "min": 0,
          "max": 60,
          "step": 2,
          "unit": "px",
          "default": 0
        },
        {
          "type": "range",
          "id": "padding_right",
          "label": "Right",
          "min": 0,
          "max": 60,
          "step": 2,
          "unit": "px",
          "default": 0
        },
        {
          "type": "range",
          "id": "padding_bottom",
          "label": "Bottom",
          "min": 0,
          "max": 60,
          "step": 2,
          "unit": "px",
          "default": 0
        },
        {
          "type": "range",
          "id": "padding_left",
          "label": "Left",
          "min": 0,
          "max": 60,
          "step": 2,
          "unit": "px",
          "default": 0
        },

        {
          "type": "header",
          "content": "Mobile block padding"
        },
        {
          "type": "range",
          "id": "mobile_padding_top",
          "label": "Top",
          "min": 0,
          "max": 60,
          "step": 2,
          "unit": "px",
          "default": 0
        },
        {
          "type": "range",
          "id": "mobile_padding_right",
          "label": "Right",
          "min": 0,
          "max": 60,
          "step": 2,
          "unit": "px",
          "default": 0
        },
        {
          "type": "range",
          "id": "mobile_padding_bottom",
          "label": "Bottom",
          "min": 0,
          "max": 60,
          "step": 2,
          "unit": "px",
          "default": 0
        },
        {
