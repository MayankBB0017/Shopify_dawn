
{% stylesheet %}
.collection-list-2 {
  display: flex;
  /* justify-content: center; */
  flex-wrap: wrap;
  margin: 40px 0;
}

.collection-list-2__item {
  flex: 1 ;
  /* max-width: 30%; */
  cursor: pointer;
  position: relative;
  overflow: hidden;
  transition: transform 0.3s ease;
}


.collection-list-2__image-wrapper {
  position: relative;
  width: 100%;
  padding-top: 140%; /* aspect ratio */
  overflow: hidden;
}

.collection-list-2__image-wrapper img {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.collection-list-2__title {
  position: absolute;   
  /* top: 20px; */
  left: 20px;
  color: white;
  z-index: 2;
  margin: 0;
    font-weight: 400;
    font-size: 18px;
    line-height: 28px;
    letter-spacing: 0%;
    text-align: center;
    text-transform: uppercase;
}

{% endstylesheet %}

<section class="collection-list-2">
  {% for block in section.blocks %}
    {% assign collection = block.settings.collection %}
    {% if collection %}
      {% comment %}
        Image Priority:
        1. collection metafield image (example metafield namespace/key: 'custom.image')
        2. collection image (collection.image)
        3. CMS image from block.settings.cms_image
      {% endcomment %}

      {% assign metafield_image = collection.metafields.custom.image %}
      {% assign collection_image = collection.image %}
      {% assign cms_image = block.settings.cms_image %}

      {% if metafield_image != blank %}
        {% assign img_src = metafield_image | img_url: 'master' %}
      {% elsif collection_image != blank %}
        {% assign img_src = collection_image | img_url: 'master' %}
      {% elsif cms_image != blank %}
        {% assign img_src = cms_image | img_url: 'master' %}
      {% else %}
        {% assign img_src = '' %}
      {% endif %}

      {% assign title_pos = block.settings.title_position | default: 'bottom-center' %}
      {% assign title_class = 'title-' | append: title_pos %}

      <a href="{{ collection.url }}" class="collection-list-2__item" aria-label="{{ collection.title }}">
        <div class="collection-list-2__image-wrapper">
          {% if img_src != blank %}
            <img src="{{ img_src }}" alt="{{ collection.title | escape }}">
          {% else %}
            <div style="background: #ccc; width:100%; height:100%;"></div>
          {% endif %}
          <h3 class="collection-list-2__title {{ title_class }}">{{ collection.title }}</h3>
        </div>
      </a>
    {% endif %}
  {% endfor %}
</section>
{% schema %}
{
  "name": "Collection List 2",
  "tag": "section",
  "settings": [
    {
          "type": "select",
          "id": "title_position",
          "label": "Title position",
          "default": "bottom-center",
          "options": [
            { "value": "top-left", "label": "Top Left" },
            { "value": "top-center", "label": "Top Center" },
            { "value": "top-right", "label": "Top Right" },
            { "value": "center-left", "label": "Center Left" },
            { "value": "center-center", "label": "Center Center" },
            { "value": "center-right", "label": "Center Right" },
            { "value": "bottom-left", "label": "Bottom Left" },
            { "value": "bottom-center", "label": "Bottom Center" },
            { "value": "bottom-right", "label": "Bottom Right" }
          ]
    }
  ],
  "blocks": [
    {
      "type": "collection",
      "name": "Collection",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "Select collection"
        },
        {
          "type": "image_picker",
          "id": "cms_image",
          "label": "CMS fallback image (optional)"
        }
      ]
    }
  ],
  "max_blocks": 12,
  "presets": [
    {
      "name": "Collection List 2",
      "category": "Collections",
      "blocks": [
        {
          "type": "collection"
        },
        {
          "type": "collection"
        },
        {
          "type": "collection"
        }
      ]
    }
  ]
}
{% endschema %}
