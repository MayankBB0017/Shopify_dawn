<section class="three-image-banner">
  <div class="three-image-wrapper">
    {% for block in section.blocks %}
      <div class="banner-image">
        {% if block.settings.image != blank %}
          <a href="{{ block.settings.link }}">
            <img src="{{ block.settings.image | image_url: width: 2000 }}" alt="{{ block.settings.alt_text }}">
            {% if block.settings.label_text != blank %}
              <span class="image-label">{{ block.settings.label_text }}</span>
            {% endif %}
          </a>
        {% endif %}
      </div>
    {% endfor %}
  </div>
</section>


{% schema %}
{
  "name": "Three Image Banner",
  "settings": [],
  "blocks": [
    {
      "type": "image_block",
      "name": "Image",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link URL"
        },
        {
          "type": "text",
          "id": "alt_text",
          "label": "Alt text"
        },
        {
          "type": "text",
          "id": "label_text",
          "label": "Top-left small text"
        }
      ]
    }
  ],
  "max_blocks": 3,
  "presets": [
    {
      "name": "Three Image Banner with Labels",
      "category": "Banner"
    }
  ]
}
{% endschema %}
