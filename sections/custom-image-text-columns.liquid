{{ 'component-image-with-text.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  .custom-columns-wrapper {
    display: flex;
    flex-direction: column;
    gap: 80px;
  }

  .custom-columns-header {
    max-width: 80rem;
  }

  .custom-columns-title {
    margin-top: 0;
    margin-bottom: 16px;
    font-family: Jost;
    font-weight: 400;
    font-style: Regular;
    font-size: 18px;
    line-height: 28px;
    letter-spacing: 0;`

  }

  .custom-columns-text {
    margin-bottom: 16px;
    font-family: Jost;
    font-weight: 400;
    font-size: 14px;
    line-height: 20px;
    letter-spacing: 0;
  }

  .custom-columns-links {
    display: flex;
    gap: 2rem;
    flex-wrap: wrap;
  }

  .custom-columns-links a {
    text-decoration: underline;
    text-underline-offset: 4px;
    font-size: 1.2rem;
    text-transform: uppercase;
    letter-spacing: 1px;
    color: rgb(var(--color-foreground));
    font-family: Jost;
    font-weight: 400;
    font-style: Regular;
    font-size: 14px;
    line-height: 18px;
    letter-spacing: 0;

  }

  .custom-columns-grid {
    display: grid;
    grid-template-columns: 1fr;
  }

  @media screen and (min-width: 750px) {
    .custom-columns-grid {
      grid-template-columns: repeat({{ section.blocks.size }}, 1fr);
    }
  }

  .custom-column-item {
    position: relative;
    display: flex;
  }

  .custom-column-item img, .custom-column-item svg {
    width: 100%;
    height: auto;
    aspect-ratio: 3/4;
    object-fit: cover;
    display: block;
  }

  .custom-column-item svg {
    background-color: #f3f3f3;
  }

  .custom-column-text {
    position: absolute;
    top: 2rem;
    left: 2rem;
    color: #fff;
    font-size: 1.4rem;
    letter-spacing: 1px;
    text-transform: uppercase;
    margin: 0;
    font-weight: 500;
  }

  .custom-column-link-wrapper {
    display: block;
    width: 100%;
    height: 100%;
    text-decoration: none;
  }
{%- endstyle -%}

<div class="color-{{ section.settings.color_scheme }} gradient">
  <div class="page-width section-{{ section.id }}-padding">
    <div class="custom-columns-wrapper">
      
      {%- if section.settings.title != blank or section.settings.text != blank or section.settings.link_1_label != blank or section.settings.link_2_label != blank -%}
        <div class="custom-columns-header">
          {%- if section.settings.title != blank -%}
            <h2 class="custom-columns-title">{{ section.settings.title | escape }}</h2>
          {%- endif -%}
          
          {%- if section.settings.text != blank -%}
            <div class="custom-columns-text rte">{{ section.settings.text }}</div>
          {%- endif -%}

          <div class="custom-columns-links">
            {%- if section.settings.link_1_label != blank -%}
              <a href="{{ section.settings.link_1_url | default: '#' }}">{{ section.settings.link_1_label | escape }}</a>
            {%- endif -%}
            {%- if section.settings.link_2_label != blank -%}
              <a href="{{ section.settings.link_2_url | default: '#' }}">{{ section.settings.link_2_label | escape }}</a>
            {%- endif -%}
          </div>
        </div>
      {%- endif -%}

      <div class="custom-columns-grid">
        {%- for block in section.blocks -%}
          <div class="custom-column-item" {{ block.shopify_attributes }}>
            {%- if block.settings.link != blank -%}
              <a href="{{ block.settings.link }}" aria-label="{{ block.settings.title | escape }}" class="custom-column-link-wrapper">
            {%- endif -%}
            
            {%- if block.settings.image != blank -%}
              {{ block.settings.image | image_url: width: 800 | image_tag: loading: 'lazy' }}
            {%- else -%}
              {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
            {%- endif -%}

            {%- if block.settings.title != blank -%}
              <h3 class="custom-column-text">{{ block.settings.title | escape }}</h3>
            {%- endif -%}

            {%- if block.settings.link != blank -%}
              </a>
            {%- endif -%}
          </div>
        {%- endfor -%}
      </div>

    </div>
  </div>
</div>

{% schema %}
{
  "name": "Custom image columns",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "El verano nunca acaba con Robin."
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Description",
      "default": "<p>Encuentra en nuestra tienda online oficial tus bikinis y bañadores para tus escapadas a la playa, tus momentos en la piscina, y cualquier plan que imagines. ¡Estampados únicos y formas para todos los cuerpos! Encuentra tu bikini ideal: balconette, triángulo, bandeau, de talle alto, tiras o lazo... Compra tu bikini y disfrútalo.</p>"
    },
    {
      "type": "text",
      "id": "link_1_label",
      "label": "Link 1 label",
      "default": "OPTIONAL LINK"
    },
    {
      "type": "url",
      "id": "link_1_url",
      "label": "Link 1 URL"
    },
    {
      "type": "text",
      "id": "link_2_label",
      "label": "Link 2 label",
      "default": "OPTIONAL LINK"
    },
    {
      "type": "url",
      "id": "link_2_url",
      "label": "Link 2 URL"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 36
    }
  ],
  "blocks": [
    {
      "type": "column",
      "name": "Column",
      "limit": 4,
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Category"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Custom image columns",
      "blocks": [
        {
          "type": "column",
          "settings": {
            "title": "BIKINIS"
          }
        },
        {
          "type": "column",
          "settings": {
            "title": "ROPA DE PLAYA"
          }
        },
        {
          "type": "column",
          "settings": {
            "title": "BAÑADORES"
          }
        }
      ]
    }
  ]
}
{% endschema %}
