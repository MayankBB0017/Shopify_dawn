{{ 'component-buttons.css' | asset_url | stylesheet_tag }}
{{ 'section-highlighted-product.css' | asset_url | stylesheet_tag }}
<script src="{{ 'section-highlighted-product.js' | asset_url }}" defer="defer"></script>

{%- liquid
  assign featured_product = section.settings.product
  assign subheading_display = section.settings.subheading

  if subheading_display == blank and featured_product != blank
    assign subheading_display = featured_product.title
  endif

  assign cta_url = section.settings.button_link
  if cta_url == blank and featured_product != blank
    assign cta_url = featured_product.url
  endif

  assign cta_label = section.settings.button_label
  if cta_label == blank
    assign cta_label = 'sections.highlighted_product.descubrir' | t
  endif

  assign hotspot_blocks = section.blocks | where: 'type', 'hotspot'
  assign hotspot_count = hotspot_blocks.size

  assign desktop_image = section.settings.image
  if desktop_image == blank and featured_product != blank
    assign desktop_image = featured_product.featured_image
  endif

  assign mobile_image = section.settings.image_mobile
  if mobile_image == blank
    assign mobile_image = desktop_image
  endif

  assign image_alt = section.settings.heading | strip_html
  if image_alt == blank and featured_product != blank
    assign image_alt = featured_product.title
  endif
  if image_alt == blank
    assign image_alt = 'sections.highlighted_product.accessibility' | t
  endif

  assign section_label = section.settings.accessibility_label
  if section_label == blank
    assign section_label = 'sections.highlighted_product.accessibility' | t
  endif

  assign heading_size_desktop = section.settings.heading_size_desktop
  assign heading_size_mobile = section.settings.heading_size_mobile
  assign body_size_desktop = section.settings.body_size_desktop
  assign body_size_mobile = section.settings.body_size_mobile

  assign has_header = false
  if section.settings.heading != blank or section.settings.subheading != blank
    assign has_header = true
  endif

  assign show_header = false
  if section.settings.heading != blank or subheading_display != blank
    assign show_header = true
  endif

  assign hero_image = desktop_image
  if hero_image == blank
    assign hero_image = mobile_image
  endif

  assign button_style = section.settings.button_style | default: 'stroke_black'
  assign link_size = section.settings.link_size | default: '14'

  case button_style
    when 'filled_white'
      assign cta_button_class = 'button button--filled-white'
    when 'filled_black'
      assign cta_button_class = 'button button--filled-black'
    when 'stroke_white'
      assign cta_button_class = 'button button--stroke-white'
    when 'stroke_black'
      assign cta_button_class = 'button button--stroke-black'
    when 'link_white'
      assign cta_button_class = 'link-button--' | append: link_size | append: ' highlighted-product__cta-link highlighted-product__cta-link--white'
    when 'link_black'
      assign cta_button_class = 'link-button--' | append: link_size | append: ' highlighted-product__cta-link highlighted-product__cta-link--black'
    else
      assign cta_button_class = 'button button--stroke-black'
  endcase

  assign show_cta = false
  if cta_label != blank
    assign show_cta = true
    if cta_url == blank
      assign cta_url = '#'
    endif
  endif

  assign cta_is_link = false
  if button_style == 'link_white' or button_style == 'link_black'
    assign cta_is_link = true
  endif

  assign container_class = ''
  assign container_modifier = 'full'
  if section.settings.container_width == 'standard'
    assign container_class = 'page-width'
    assign container_modifier = 'standard'
  endif

  assign cta_horizontal_desktop = section.settings.cta_horizontal_desktop | default: 'left'
  assign cta_horizontal_mobile = section.settings.cta_horizontal_mobile | default: 'left'
  assign cta_bottom_desktop = section.settings.cta_bottom_desktop | default: 11
  assign cta_bottom_mobile = section.settings.cta_bottom_mobile | default: 9
  assign hotspot_color_default = section.settings.hotspot_color_default | default: '#1A1919'
  assign hotspot_color_active = section.settings.hotspot_color_active | default: '#FFFFFF'

  assign height_desktop = section.settings.height_desktop | default: 'large'
  assign height_mobile = section.settings.height_mobile | default: 'medium'
-%}

{%- comment -%} Legacy capture removed — classes assigned above {%- endcomment -%}

{%- style -%}
  #HighlightedProduct-{{ section.id }} {
    --hp-padding-top-mobile: {{ section.settings.padding_top_mobile }}px;
    --hp-padding-bottom-mobile: {{ section.settings.padding_bottom_mobile }}px;
    --hp-padding-top-desktop: {{ section.settings.padding_top }}px;
    --hp-padding-bottom-desktop: {{ section.settings.padding_bottom }}px;
    --hp-cta-bottom-mobile: {{ cta_bottom_mobile }}%;
    --hp-cta-bottom-desktop: {{ cta_bottom_desktop }}%;
    --hp-cta-inset-x-mobile: 1.6rem;
    --hp-cta-inset-x-desktop: 6.4rem;
    --hp-hotspot-color-default: {{ hotspot_color_default }};
    --hp-hotspot-color-active: {{ hotspot_color_active }};
    --hp-container-radius: {{ section.settings.container_border_radius | default: 8 }}px;
  }
{%- endstyle -%}

<highlighted-product-section
  id="HighlightedProduct-{{ section.id }}"
  class="highlighted-product highlighted-product--container-{{ container_modifier }} highlighted-product--height-desktop-{{ height_desktop }} highlighted-product--height-mobile-{{ height_mobile }} highlighted-product--cta-mobile-{{ cta_horizontal_mobile }} highlighted-product--cta-desktop-{{ cta_horizontal_desktop }} color-{{ section.settings.color_scheme }} gradient{% if section.settings.enable_fade_in_desktop != false %} highlighted-product--fade-in-desktop{% endif %}{% if section.settings.enable_fade_in_mobile != false %} highlighted-product--fade-in-mobile{% endif %}{% if request.design_mode %} highlighted-product--fade-visible{% endif %}"
  data-section-id="{{ section.id }}"
  data-open-mode="{{ section.settings.open_hotspot_on }}"
  data-default-hotspot="{{ section.settings.default_hotspot }}"
  {% if section_label != blank %}
    aria-label="{{ section_label | escape }}"
  {% endif %}
>
  <div class="highlighted-product__stage">
    <div class="highlighted-product__shell{% if container_class != blank %} {{ container_class }}{% endif %}">
    <div class="highlighted-product__inner{% unless has_header %} highlighted-product__inner--image-only{% endunless %}">
      {%- if show_header -%}
        <div class="highlighted-product__text highlighted-product__text--mobile highlighted-product__animate">
          <div class="highlighted-product__animate-inner">
            {%- if section.settings.heading != blank -%}
              <h2 class="highlighted-product__heading {{ heading_size_desktop }} highlighted-product__heading--mobile-{{ heading_size_mobile }} inline-richtext">
                {{ section.settings.heading }}
              </h2>
            {%- endif -%}
            {%- if subheading_display != blank -%}
              <p class="highlighted-product__subheading {{ body_size_desktop }} highlighted-product__subheading--mobile-{{ body_size_mobile }}">
                {{ subheading_display | escape }}
              </p>
            {%- endif -%}
          </div>
        </div>
      {%- endif -%}

      <div class="highlighted-product__media">
        {%- if show_header -%}
          <div class="highlighted-product__text highlighted-product__text--desktop highlighted-product__animate">
            <div class="highlighted-product__animate-inner">
              {%- if section.settings.heading != blank -%}
                <h2 class="highlighted-product__heading {{ heading_size_desktop }} highlighted-product__heading--mobile-{{ heading_size_mobile }} inline-richtext">
                  {{ section.settings.heading }}
                </h2>
              {%- endif -%}
              {%- if subheading_display != blank -%}
                <p class="highlighted-product__subheading {{ body_size_desktop }} highlighted-product__subheading--mobile-{{ body_size_mobile }}">
                  {{ subheading_display | escape }}
                </p>
              {%- endif -%}
            </div>
          </div>
        {%- endif -%}

        <div class="highlighted-product__image-wrap highlighted-product__animate">
          <div class="highlighted-product__animate-inner">
            {%- if hero_image != blank -%}
              <picture>
                {%- if mobile_image != blank and desktop_image != blank and mobile_image != desktop_image -%}
                  <source
                    media="(max-width: 749px)"
                    srcset="
                      {{ mobile_image | image_url: width: 750 }} 750w,
                      {{ mobile_image | image_url: width: 1100 }} 1100w
                    "
                    sizes="100%"
                  >
                {%- elsif mobile_image != blank and desktop_image == blank -%}
                  <source
                    media="(max-width: 749px)"
                    srcset="
                      {{ mobile_image | image_url: width: 750 }} 750w,
                      {{ mobile_image | image_url: width: 1100 }} 1100w
                    "
                    sizes="100%"
                  >
                {%- endif -%}
                {{
                  hero_image
                  | image_url: width: 2000
                  | image_tag:
                    class: 'highlighted-product__image',
                    widths: '375, 750, 1100, 1500, 2000',
                    sizes: '100%',
                    loading: 'lazy',
                    alt: image_alt
                }}
              </picture>
            {%- else -%}
              <div class="highlighted-product__placeholder">
                {{ 'product-apparel-2' | placeholder_svg_tag: 'placeholder-svg' }}
              </div>
            {%- endif -%}
          </div>
        </div>

        {%- if hotspot_count > 0 -%}
          <div class="highlighted-product__hotspots" role="group" aria-label="{{ section_label | escape }}">
            {%- for block in hotspot_blocks -%}
              {% render 'highlighted-product-hotspot',
                block: block,
                section: section,
                hotspot_index: forloop.index
              %}
            {%- endfor -%}
          </div>

          <div class="highlighted-product__tooltip-wrap highlighted-product__animate">
            <div
              id="HighlightedProductTooltip-{{ section.id }}"
              class="highlighted-product__tooltip highlighted-product__tooltip--mobile"
              role="region"
              hidden
            >
              <div class="highlighted-product__tooltip-inner"></div>
            </div>
          </div>

          <script type="application/json" data-hotspot-data>
            [
              {%- for block in hotspot_blocks -%}
                {%- liquid
                  assign feature_image = blank
                  if block.settings.image != blank
                    assign feature_image = block.settings.image | image_url: width: 160
                  elsif featured_product != blank and featured_product.featured_image != blank
                    assign feature_image = featured_product.featured_image | image_url: width: 160
                  endif
                -%}
                {
                  "id": {{ block.id | json }},
                  "title": {{ block.settings.title | default: '' | json }},
                  "description": {{ block.settings.description | default: '' | json }},
                  "image": {{ feature_image | json }},
                  "imageAlt": {{ block.settings.title | default: '' | json }},
                  "link": {{ block.settings.link | json }},
                  "tooltipPosition": {{ block.settings.tooltip_position | default: 'auto' | json }},
                  "tooltipSpacing": {{ block.settings.tooltip_spacing | default: 24 }},
                  "tooltipOffsetX": {{ block.settings.tooltip_offset_x | default: 0 }},
                  "tooltipOffsetY": {{ block.settings.tooltip_offset_y | default: 0 }}
                }{%- unless forloop.last -%},{%- endunless -%}
              {%- endfor -%}
            ]
          </script>
        {%- endif -%}

        {%- if show_cta -%}
          <a
            href="{{ cta_url }}"
            class="highlighted-product__cta highlighted-product__animate{% if cta_is_link %} highlighted-product__cta--link{% else %} highlighted-product__cta--button{% endif %} {{ cta_button_class | strip }}"
            {% if cta_url == '#' %}
              role="link" aria-disabled="true"
            {% endif %}
          >
            {%- if cta_is_link -%}
              {{ cta_label | escape }}
            {%- else -%}
              <span class="button-label">{{ cta_label | escape }}</span>
            {%- endif -%}
          </a>
        {%- endif -%}
      </div>
    </div>
    </div>
  </div>

  <noscript>
    <div class="highlighted-product__noscript">
      <ul class="highlighted-product__noscript-list">
        {%- for block in hotspot_blocks -%}
          <li class="highlighted-product__noscript-item" id="feature-{{ block.id }}">
            <h3>{{ block.settings.title | escape }}</h3>
            <p>{{ block.settings.description | escape }}</p>
          </li>
        {%- endfor -%}
      </ul>
    </div>
  </noscript>
</highlighted-product-section>

{% schema %}
{
  "name": "t:sections.highlighted_product.name",
  "tag": "section",
  "class": "section section-highlighted-product",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "header",
      "content": "t:sections.highlighted_product.settings.header_content.content"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "t:sections.highlighted_product.settings.heading.label",
      "default": "Nuevo lanzamiento"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "t:sections.highlighted_product.settings.subheading.label",
      "info": "t:sections.highlighted_product.settings.subheading.info",
      "default": "Carrito Muum"
    },
    {
      "type": "product",
      "id": "product",
      "label": "t:sections.highlighted_product.settings.product.label"
    },
    {
      "type": "header",
      "content": "t:sections.highlighted_product.settings.header_hero_image.content"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:sections.highlighted_product.settings.image.label",
      "info": "t:sections.highlighted_product.settings.image.info"
    },
    {
      "type": "image_picker",
      "id": "image_mobile",
      "label": "t:sections.highlighted_product.settings.image_mobile.label",
      "info": "t:sections.highlighted_product.settings.image_mobile.info"
    },
    {
      "type": "select",
      "id": "height_desktop",
      "label": "t:sections.highlighted_product.settings.height_desktop.label",
      "options": [
        { "value": "adapt", "label": "t:sections.highlighted_product.settings.height.options__adapt.label" },
        { "value": "fit_screen", "label": "t:sections.highlighted_product.settings.height.options__fit_screen.label" },
        { "value": "large", "label": "t:sections.highlighted_product.settings.height.options__large.label" },
        { "value": "medium", "label": "t:sections.highlighted_product.settings.height.options__medium.label" },
        { "value": "small", "label": "t:sections.highlighted_product.settings.height.options__small.label" }
      ],
      "default": "large"
    },
    {
      "type": "select",
      "id": "height_mobile",
      "label": "t:sections.highlighted_product.settings.height_mobile.label",
      "options": [
        { "value": "adapt", "label": "t:sections.highlighted_product.settings.height.options__adapt.label" },
        { "value": "fit_screen", "label": "t:sections.highlighted_product.settings.height.options__fit_screen.label" },
        { "value": "large", "label": "t:sections.highlighted_product.settings.height.options__large.label" },
        { "value": "medium", "label": "t:sections.highlighted_product.settings.height.options__medium.label" },
        { "value": "small", "label": "t:sections.highlighted_product.settings.height.options__small.label" }
      ],
      "default": "medium"
    },
    {
      "type": "header",
      "content": "t:sections.highlighted_product.settings.header_button.content"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "t:sections.highlighted_product.settings.button_label.label",
      "default": "Descubrir"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "t:sections.highlighted_product.settings.button_link.label",
      "info": "t:sections.highlighted_product.settings.button_link.info"
    },
    {
      "type": "select",
      "id": "button_style",
      "label": "t:sections.highlighted_product.settings.button_style.label",
      "options": [
        { "value": "stroke_black", "label": "t:sections.highlighted_product.settings.button_style.options__stroke_black.label" },
        { "value": "stroke_white", "label": "t:sections.highlighted_product.settings.button_style.options__stroke_white.label" },
        { "value": "filled_black", "label": "t:sections.highlighted_product.settings.button_style.options__filled_black.label" },
        { "value": "filled_white", "label": "t:sections.highlighted_product.settings.button_style.options__filled_white.label" },
        { "value": "link_black", "label": "t:sections.highlighted_product.settings.button_style.options__link_black.label" },
        { "value": "link_white", "label": "t:sections.highlighted_product.settings.button_style.options__link_white.label" }
      ],
      "default": "stroke_black"
    },
    {
      "type": "select",
      "id": "link_size",
      "label": "t:sections.highlighted_product.settings.link_size.label",
      "options": [
        { "value": "14", "label": "t:sections.highlighted_product.settings.link_size.options__14.label" },
        { "value": "16", "label": "t:sections.highlighted_product.settings.link_size.options__16.label" }
      ],
      "default": "14",
      "visible_if": "{{ section.settings.button_style == 'link_black' or section.settings.button_style == 'link_white' }}"
    },
    {
      "type": "header",
      "content": "t:sections.highlighted_product.settings.header_button_placement.content"
    },
    {
      "type": "select",
      "id": "cta_horizontal_desktop",
      "label": "t:sections.highlighted_product.settings.cta_horizontal_desktop.label",
      "options": [
        { "value": "left", "label": "t:sections.highlighted_product.settings.cta_horizontal.options__left.label" },
        { "value": "right", "label": "t:sections.highlighted_product.settings.cta_horizontal.options__right.label" }
      ],
      "default": "left"
    },
    {
      "type": "range",
      "id": "cta_bottom_desktop",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "%",
      "label": "t:sections.highlighted_product.settings.cta_bottom_desktop.label",
      "info": "t:sections.highlighted_product.settings.cta_bottom.info",
      "default": 11
    },
    {
      "type": "select",
      "id": "cta_horizontal_mobile",
      "label": "t:sections.highlighted_product.settings.cta_horizontal_mobile.label",
      "options": [
        { "value": "left", "label": "t:sections.highlighted_product.settings.cta_horizontal.options__left.label" },
        { "value": "right", "label": "t:sections.highlighted_product.settings.cta_horizontal.options__right.label" }
      ],
      "default": "left"
    },
    {
      "type": "range",
      "id": "cta_bottom_mobile",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "%",
      "label": "t:sections.highlighted_product.settings.cta_bottom_mobile.label",
      "info": "t:sections.highlighted_product.settings.cta_bottom.info",
      "default": 9
    },
    {
      "type": "header",
      "content": "t:sections.highlighted_product.settings.header_typography.content"
    },
    {
      "type": "select",
      "id": "heading_size_desktop",
      "label": "t:sections.highlighted_product.settings.heading_size_desktop.label",
      "options": [
        { "value": "h1", "label": "t:sections.highlighted_product.settings.heading_size.options__h1.label" },
        { "value": "h2", "label": "t:sections.highlighted_product.settings.heading_size.options__h2.label" },
        { "value": "h3", "label": "t:sections.highlighted_product.settings.heading_size.options__h3.label" },
        { "value": "h4", "label": "t:sections.highlighted_product.settings.heading_size.options__h4.label" },
        { "value": "h5", "label": "t:sections.highlighted_product.settings.heading_size.options__h5.label" }
      ],
      "default": "h2"
    },
    {
      "type": "select",
      "id": "heading_size_mobile",
      "label": "t:sections.highlighted_product.settings.heading_size_mobile.label",
      "options": [
        { "value": "h1", "label": "t:sections.highlighted_product.settings.heading_size.options__h1.label" },
        { "value": "h2", "label": "t:sections.highlighted_product.settings.heading_size.options__h2.label" },
        { "value": "h3", "label": "t:sections.highlighted_product.settings.heading_size.options__h3.label" },
        { "value": "h4", "label": "t:sections.highlighted_product.settings.heading_size.options__h4.label" },
        { "value": "h5", "label": "t:sections.highlighted_product.settings.heading_size.options__h5.label" }
      ],
      "default": "h2"
    },
    {
      "type": "select",
      "id": "body_size_desktop",
      "label": "t:sections.highlighted_product.settings.body_size_desktop.label",
      "options": [
        { "value": "text-body", "label": "t:sections.highlighted_product.settings.body_size.options__body_big.label" },
        { "value": "caption-large", "label": "t:sections.highlighted_product.settings.body_size.options__regular.label" },
        { "value": "caption", "label": "t:sections.highlighted_product.settings.body_size.options__small.label" }
      ],
      "default": "text-body"
    },
    {
      "type": "select",
      "id": "body_size_mobile",
      "label": "t:sections.highlighted_product.settings.body_size_mobile.label",
      "options": [
        { "value": "text-body", "label": "t:sections.highlighted_product.settings.body_size.options__body_big.label" },
        { "value": "caption-large", "label": "t:sections.highlighted_product.settings.body_size.options__regular.label" },
        { "value": "caption", "label": "t:sections.highlighted_product.settings.body_size.options__small.label" }
      ],
      "default": "text-body"
    },
    {
      "type": "header",
      "content": "t:sections.highlighted_product.settings.header_hotspots.content"
    },
    {
      "type": "select",
      "id": "default_hotspot",
      "label": "t:sections.highlighted_product.settings.default_hotspot.label",
      "options": [
        { "value": "first", "label": "t:sections.highlighted_product.settings.default_hotspot.options__first.label" },
        { "value": "none", "label": "t:sections.highlighted_product.settings.default_hotspot.options__none.label" }
      ],
      "default": "first"
    },
    {
      "type": "select",
      "id": "open_hotspot_on",
      "label": "t:sections.highlighted_product.settings.open_hotspot_on.label",
      "options": [
        { "value": "hover_and_click", "label": "t:sections.highlighted_product.settings.open_hotspot_on.options__hover_and_click.label" },
        { "value": "hover", "label": "t:sections.highlighted_product.settings.open_hotspot_on.options__hover.label" },
        { "value": "click", "label": "t:sections.highlighted_product.settings.open_hotspot_on.options__click.label" }
      ],
      "default": "hover_and_click"
    },
    {
      "type": "color",
      "id": "hotspot_color_default",
      "label": "t:sections.highlighted_product.settings.hotspot_color_default.label",
      "info": "t:sections.highlighted_product.settings.hotspot_color_default.info",
      "default": "#1A1919"
    },
    {
      "type": "color",
      "id": "hotspot_color_active",
      "label": "t:sections.highlighted_product.settings.hotspot_color_active.label",
      "info": "t:sections.highlighted_product.settings.hotspot_color_active.info",
      "default": "#FFFFFF"
    },
    {
      "type": "header",
      "content": "t:sections.highlighted_product.settings.header_animation.content"
    },
    {
      "type": "checkbox",
      "id": "enable_fade_in_desktop",
      "label": "t:sections.highlighted_product.settings.enable_fade_in_desktop.label",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "enable_fade_in_mobile",
      "label": "t:sections.highlighted_product.settings.enable_fade_in_mobile.label",
      "default": true
    },
    {
      "type": "header",
      "content": "t:sections.highlighted_product.settings.header_layout.content"
    },
    {
      "type": "select",
      "id": "container_width",
      "label": "t:sections.highlighted_product.settings.container_width.label",
      "info": "t:sections.highlighted_product.settings.container_width.info",
      "options": [
        {
          "value": "full_width",
          "label": "t:sections.highlighted_product.settings.container_width.options__full_width.label"
        },
