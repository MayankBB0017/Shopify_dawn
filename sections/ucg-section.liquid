
{{ 'ucg-section.css' | asset_url | stylesheet_tag }}
<style>
  .section-padding-{{section.id }} {
    padding-top: {{ section.settings.padding_top_desktop }}px;
    padding-bottom: {{ section.settings.padding_bottom_desktop }}px;
  }

  @media screen and (max-width: 749px) {
    .section-padding-{{section.id }} {
      padding-top: {{ section.settings.padding_top_mobile }}px;
      padding-bottom: {{ section.settings.padding_bottom_mobile }}px;
    }
  }
</style>

<section class="ucs_section section-padding-{{section.id }} ">
    <div class="section_head_wrapper page-width">
        {% for block in section.blocks %}
            <p class="head_text">{{ block.settings.head_text }}</p>
        {% endfor %}
    </div>
    <div class="section_media_wrapper">
        <div class="left_col_wrap col_wrap">
            <div class="block_mage_wrapper">
                <img
                    srcset="
                    {% if section.settings.img1.width >= 350 %}{{ section.settings.img1 | image_url: width: 350 }} 350w,{% endif %}
                    {% if section.settings.img1.width >= 750 %}{{ section.settings.img1 | image_url: width: 750 }} 750w,{% endif %}
                    {% if section.settings.img1.width >= 1100 %}{{ section.settings.img1 | image_url: width: 1100 }} 1100w,{% endif %}
                    {% if section.settings.img1.width >= 1500 %}{{ section.settings.img1 | image_url: width: 1500 }} 1500w,{% endif %}
                    {{ section.settings.img1 | image_url }} {{ section.settings.img1.width }}w
                    "
                    sizes="(min-width: {{ settings.page_width }}px) {{ settings.page_width | minus: 100 }}px, (min-width: 750px) calc(100vw - 10rem), 100vw"
                    src="{{ section.settings.img1 | image_url: width: 1100 }}"
                    loading="eager"
                    fetchpriority="high"
                    width="{{ section.settings.img1.width }}"
                    height="{{ section.settings.img1.height }}"
                    alt="{{ section.settings.img1.alt | escape }}"
                >
            </div>
             <div class="block_mage_wrapper">
                <img
                    srcset="
                    {% if section.settings.img2.width >= 350 %}{{ section.settings.img2 | image_url: width: 350 }} 350w,{% endif %}
                    {% if section.settings.img2.width >= 750 %}{{ section.settings.img2 | image_url: width: 750 }} 750w,{% endif %}
                    {% if section.settings.img2.width >= 1100 %}{{ section.settings.img2 | image_url: width: 1100 }} 1100w,{% endif %}
                    {% if section.settings.img2.width >= 1500 %}{{ section.settings.img2 | image_url: width: 1500 }} 1500w,{% endif %}
                    {{ section.settings.img2 | image_url }} {{ section.settings.img2.width }}w
                    "
                    sizes="(min-width: {{ settings.page_width }}px) {{ settings.page_width | minus: 100 }}px, (min-width: 750px) calc(100vw - 10rem), 100vw"
                    src="{{ section.settings.img2 | image_url: width: 1100 }}"
                    loading="eager"
                    fetchpriority="high"
                    width="{{ section.settings.img2.width }}"
                    height="{{ section.settings.img2.height }}"
                    alt="{{ section.settings.img2.alt | escape }}"
                >
            </div>
             <div class="block_mage_wrapper">
                <img
                    srcset="
                    {% if section.settings.img3.width >= 350 %}{{ section.settings.img3 | image_url: width: 350 }} 350w,{% endif %}
                    {% if section.settings.img3.width >= 750 %}{{ section.settings.img3 | image_url: width: 750 }} 750w,{% endif %}
                    {% if section.settings.img3.width >= 1100 %}{{ section.settings.img3 | image_url: width: 1100 }} 1100w,{% endif %}
                    {% if section.settings.img3.width >= 1500 %}{{ section.settings.img3 | image_url: width: 1500 }} 1500w,{% endif %}
                    {{ section.settings.img3 | image_url }} {{ section.settings.img3.width }}w
                    "
                    sizes="(min-width: {{ settings.page_width }}px) {{ settings.page_width | minus: 100 }}px, (min-width: 750px) calc(100vw - 10rem), 100vw"
                    src="{{ section.settings.img3 | image_url: width: 1100 }}"
                    loading="eager"
                    fetchpriority="high"
                    width="{{ section.settings.img3.width }}"
                    height="{{ section.settings.img3.height }}"
                    alt="{{ section.settings.img3.alt | escape }}"
                >
            </div>
             <div class="block_mage_wrapper">
                <img
                    srcset="
                    {% if section.settings.img4.width >= 350 %}{{ section.settings.img4 | image_url: width: 350 }} 350w,{% endif %}
                    {% if section.settings.img4.width >= 750 %}{{ section.settings.img4 | image_url: width: 750 }} 750w,{% endif %}
                    {% if section.settings.img4.width >= 1100 %}{{ section.settings.img4 | image_url: width: 1100 }} 1100w,{% endif %}
                    {% if section.settings.img4.width >= 1500 %}{{ section.settings.img4 | image_url: width: 1500 }} 1500w,{% endif %}
                    {{ section.settings.img4 | image_url }} {{ section.settings.img4.width }}w
                    "
                    sizes="(min-width: {{ settings.page_width }}px) {{ settings.page_width | minus: 100 }}px, (min-width: 750px) calc(100vw - 10rem), 100vw"
                    src="{{ section.settings.img4 | image_url: width: 1100 }}"
                    loading="eager"
                    fetchpriority="high"
                    width="{{ section.settings.img4.width }}"
                    height="{{ section.settings.img4.height }}"
                    alt="{{ section.settings.img4.alt | escape }}"
                >
            </div>
        </div>
        <div class="right_col_wrap col_wrap">
             <div class="block_mage_wrapper">
                <img
                    srcset="
                    {% if section.settings.img5.width >= 350 %}{{ section.settings.img5 | image_url: width: 350 }} 350w,{% endif %}
                    {% if section.settings.img5.width >= 750 %}{{ section.settings.img5 | image_url: width: 750 }} 750w,{% endif %}
                    {% if section.settings.img5.width >= 1100 %}{{ section.settings.img5 | image_url: width: 1100 }} 1100w,{% endif %}
                    {% if section.settings.img5.width >= 1500 %}{{ section.settings.img5 | image_url: width: 1500 }} 1500w,{% endif %}
                    {{ section.settings.img5 | image_url }} {{ section.settings.img5.width }}w
                    "
                    sizes="(min-width: {{ settings.page_width }}px) {{ settings.page_width | minus: 100 }}px, (min-width: 750px) calc(100vw - 10rem), 100vw"
                    src="{{ section.settings.img5 | image_url: width: 1100 }}"
                    loading="eager"
                    fetchpriority="high"
                    width="{{ section.settings.img5.width }}"
                    height="{{ section.settings.img5.height }}"
                    alt="{{ section.settings.img5.alt | escape }}"
                >
            </div>
        </div>
    </div>
    <div class="section_footer_wrapper">
        <div class="page-width text_block_wrap">
            {% for block in section.blocks %}
                <p class="footer_text">{{ block.settings.footer_text }}</p> <span>|</span>
            {% endfor %}
        </div>
    </div>
</section>

{% schema %}
{
  "name": "Collections Section",
  "settings": [
    {
      "type": "header",
      "content": "Section Media Left Column"
    },
    {
        "type": "image_picker",
        "id": "img1",
        "label": "Image 1"
    },
    {
        "type": "image_picker",
        "id": "img2",
        "label": "Image 2"
    },
    {
        "type": "image_picker",
        "id": "img3",
        "label": "Image 3"
    },
    {
        "type": "image_picker",
        "id": "img4",
        "label": "Image 4"
    },
    {
      "type": "header",
      "content": "Section Media Right Column"
    },
    {
        "type": "image_picker",
        "id": "img5",
        "label": "Right Col Image"
    },
    {
      "type": "header",
      "content": "Section Spacing"
    },
    {
      "type": "range",
      "id": "padding_top_desktop",
      "label": "Padding Top Desktop",
      "min": 0,
      "max": 200,
      "step": 5,
      "default": 50
    },
    {
      "type": "range",
      "id": "padding_bottom_desktop",
      "label": "Padding Bottom Desktop",
      "min": 0,
      "max": 200,
      "step": 5,
      "default": 50
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "Padding Top Mobile",
      "min": 0,
      "max": 200,
      "step": 5,
      "default": 30
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "Padding Bottom Mobile",
      "min": 0,
      "max": 200,
      "step": 5,
      "default": 30
    }
  ],
   "blocks": [
    {
      "type": "head_text",
      "name": "Head Text",
      "settings": [
        {
          "type": "text",
          "id": "head_text",
          "label": "Text"
        }
      ]
    },
    {
      "type": "footer_text",
      "name": "Footer Text",
      "settings": [
        {
          "type": "text",
          "id": "footer_text",
          "label": "Text"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "UCG Section"
    }
  ]
}
{% endschema %}