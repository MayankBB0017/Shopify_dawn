{{ 'collections-blocks.css' | asset_url | stylesheet_tag }}

<style>
    .section-padding-{{section.id }} {
    padding-top: {{ section.settings.padding_top_desktop }}px;
    padding-bottom: {{ section.settings.padding_bottom_desktop }}px;
    }

    @media screen and (max-width: 749px) {
    .section-padding-{{section.id }} {
        padding-top: {{ section.settings.padding_top_mobile }}px;
        padding-bottom: {{ section.settings.padding_bottom_mobile }}px;
    }
    }
</style>

<section class="collection_blocks_section section-padding-{{section.id }} "> 
    <div class="collections_blocks_wrap">
    {% for block in section.blocks %} 
        <div class="collection_image_wrap">
            <img
                srcset="
                {% if section.settings.mobile_image.width >= 350 %}{{ section.settings.mobile_image | image_url: width: 350 }} 350w,{% endif %}
                {% if section.settings.mobile_image.width >= 750 %}{{ section.settings.mobile_image | image_url: width: 750 }} 750w,{% endif %}
                {% if section.settings.mobile_image.width >= 1100 %}{{ section.settings.mobile_image | image_url: width: 1100 }} 1100w,{% endif %}
                {% if section.settings.mobile_image.width >= 1500 %}{{ section.settings.mobile_image | image_url: width: 1500 }} 1500w,{% endif %}
                {% if section.settings.mobile_image.width >= 2200 %}{{ section.settings.mobile_image | image_url: width: 2200 }} 2200w,{% endif %}
                {% if section.settings.mobile_image.width >= 3000 %}{{ section.settings.mobile_image | image_url: width: 3000 }} 3000w,{% endif %}
                {{ section.settings.mobile_image | image_url }} {{ section.settings.mobile_image.width }}w
                "
                sizes="(min-width: {{ settings.page_width }}px) {{ settings.page_width | minus: 100 }}px, (min-width: 750px) calc(100vw - 10rem), 100vw"
                src="{{ section.settings.mobile_image | image_url: width: 1100 }}"
                loading="eager"
                fetchpriority="high"
                width="{{ section.settings.mobile_image.width }}"
                height="{{ section.settings.mobile_image.height }}"
                alt="{{ section.settings.mobile_image.alt | escape }}"
            >
        </div>
    {%endfor %}
    </div>
</section>


{% schema %}
{
  "name": "Hero Section",
  "settings": [
    {
      "type": "header",
      "content": "Section Spacing"
    },
    {
      "type": "range",
      "id": "padding_top_desktop",
      "label": "Padding Top Desktop ",
      "min": 0,
      "max": 200,
      "step": 5,
      "default": 50
    },
    {
      "type": "range",
      "id": "padding_bottom_desktop",
      "label": "Padding Bottom Desktop",
      "min": 0,
      "max": 200,
      "step": 5,
      "default": 50
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "Padding Top Mobile )",
      "min": 0,
      "max": 200,
      "step": 5,
      "default": 30
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "Padding Bottom Mobile ",
      "min": 0,
      "max": 200,
      "step": 5,
      "default": 30
    }
  ],
   "blocks": [
    {
      "type": "collection_blocks",
      "name": "Collection Block",
      "settings": [

      ]
    }
  ],
  "presets": [
    {
      "name": "Collections Blocks",
      "category": "Collections"
    }
  ]
}
{% endschema %}
