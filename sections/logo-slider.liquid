<div class="logo-slider-section">
  <div class="container">
    {% if section.settings.section_title != blank %}
      <h2 class="logo-slider-title">{{ section.settings.section_title }}</h2>
    {% endif %}
    <div class="logo-slider">
      {% for block in section.blocks %}
        {% if block.settings.logo_image != blank %}
          <div class="logo-slide">
            {% if block.settings.logo_link != blank %}
              <a href="{{ block.settings.logo_link }}">
                <img src="{{ block.settings.logo_image | img_url: '300x' }}" alt="Logo" />
              </a>
            {% else %}
              <img src="{{ block.settings.logo_image | img_url: '300x' }}" alt="Logo" />
            {% endif %}
          </div>
        {% endif %}
      {% endfor %}
    </div>
  </div>
</div>


<!-- Slick slider JS initialization -->
<script type="text/javascript">
  document.addEventListener("DOMContentLoaded", function() {
    if (typeof jQuery !== 'undefined' && jQuery('.logo-slider').length) {
      jQuery('.logo-slider').slick({
        slidesToShow: 6,
        slidesToScroll: 1,
        autoplay: true,
        autoplaySpeed: 2000,
        arrows: false,
        dots: false,
        responsive: [
          { breakpoint: 1200, settings: { slidesToShow: 5 } },
          { breakpoint: 992, settings: { slidesToShow: 4 } },
          { breakpoint: 768, settings: { slidesToShow: 3 } },
          { breakpoint: 480, settings: { slidesToShow: 2 } }
        ]
      });
    }
  });
</script>

{% schema %}
{
  "name": "Logo Slider",
  "settings": [
    {
      "type": "text",
      "id": "section_title",
      "label": "Section Title",
      "default": "Our Partners"
    }
  ],
  "blocks": [
    {
      "type": "logo",
      "name": "Logo",
      "settings": [
        {
          "type": "image_picker",
          "id": "logo_image",
          "label": "Logo Image"
        },
        {
          "type": "url",
          "id": "logo_link",
          "label": "Logo Link"
        }
      ]
    }
  ],
  "max_blocks": 12,
  "presets": [
    {
      "name": "Logo Slider",
      "category": "Custom"
    }
  ]
}
{% endschema %}




