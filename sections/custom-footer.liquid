      "default": "España (€)"
    },
    {
      "type": "url",
      "id": "locale_country_url",
      "label": "Country URL"
    },
    {
      "type": "text",
      "id": "locale_lang_label",
      "label": "Language label",
      "default": "Spanish"
    },
    {
      "type": "url",
