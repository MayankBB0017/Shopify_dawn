      "label": "Condiciones Generales URL"
    },
    {
      "type": "url",
      "id": "link_privacidad",
      "label": "Política de Privacidad URL"
    },
    {
      "type": "url",
      "id": "link_aviso",
      "label": "Aviso Legal URL"
    },
    {
      "type": "url",
      "id": "link_cookies",
      "label": "Cookies URL"
    },
    {
      "type": "text",
      "id": "copyright_name",
      "label": "Copyright brand name",
      "default": "ROBIN"
    }
  ],
  "blocks": [
    {
      "type": "col1_link",
      "name": "Robin link",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Link label",
          "default": "Sobre nosotros"
        },
        {
          "type": "url",
          "id": "url",
          "label": "Link URL"
        }
      ]
    },
    {
      "type": "col2_link",
      "name": "Ayuda link",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Link label",
          "default": "FAQS"
        },
        {
          "type": "url",
          "id": "url",
          "label": "Link URL"
        }
      ]
