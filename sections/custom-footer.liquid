      "id": "newsletter_subtext",
      "label": "Subtext",
      "default": "Sé el primero en enterarte de las novedades y ofertas exclusivas de Robin"
    },
    {
      "type": "text",
      "id": "name_placeholder",
      "label": "Name field placeholder",
      "default": "Name"
    },
    {
      "type": "text",
      "id": "email_placeholder",
      "label": "Email field placeholder",
      "default": "Email Adress"
    },
    {
      "type": "header",
      "content": "Column 1 — Robin"
    },
    {
      "type": "text",
      "id": "col1_heading",
      "label": "Column 1 heading",
      "default": "Robin"
    },
    {
      "type": "header",
      "content": "Column 2 — Ayuda"
    },
    {
      "type": "text",
      "id": "col2_heading",
      "label": "Column 2 heading",
      "default": "Ayuda"
    },
    {
      "type": "header",
      "content": "Column 3 — Contacto"
    },
    {
      "type": "text",
      "id": "col3_heading",
      "label": "Column 3 heading",
      "default": "Contacto"
    },
    {
      "type": "text",
      "id": "contact_hours",
      "label": "Office hours text",
      "default": "Lunes a Viernes 10-17h"
    },
    {
      "type": "url",
      "id": "whatsapp_url",
