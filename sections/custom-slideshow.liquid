{%- comment -%}
  sections/custom-slideshow.liquid
  Custom slideshow for Dawn. Three layouts:
    full     = one full-width slide, content over the media
    two_col  = two slides side by side (stacked on mobile), content over the media
    split    = text column (left) + image column (right), content NOT over the image
{%- endcomment -%}

{{ 'custom-slideshow.css' | asset_url | stylesheet_tag }}
<script src="{{ 'custom-slideshow.js' | asset_url }}" defer="defer"></script>

{%- comment -%} Instrument Sans (used for the description) {%- endcomment -%}
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Instrument+Sans:wght@400;500;600&display=swap">

{%- liquid
  assign layout = section.settings.layout
  assign slide_count = section.blocks.size

  # How many slides are visible at once (only Layout 2 shows two)
  assign per_view = 1
  if layout == 'two_col' and slide_count > 1
    assign per_view = 2
  endif

  assign pair_mode = false
  if per_view == 2 and section.settings.two_col_advance == 'pair'
    assign pair_mode = true
  endif

  # "Pages" = number of navigation dots
  assign page_count = slide_count
  if per_view == 2
    if slide_count < 3
      assign page_count = 1
    elsif pair_mode
      assign page_count = slide_count | divided_by: 2.0 | ceil
    endif
  endif

  assign autoplay_on = false
  if section.settings.autoplay and page_count > 1
    assign autoplay_on = true
  endif

  # "Original" size uses the first slide's own image ratio
  assign first_block = section.blocks.first
  assign ratio_d = '16 / 9'
  assign ratio_m = '16 / 9'
  if first_block.settings.media_type != 'video' or layout == 'split'
    if first_block.settings.image != blank
      assign ratio_d = first_block.settings.image.aspect_ratio
      assign ratio_m = ratio_d
    endif
    if first_block.settings.image_mobile != blank
      assign ratio_m = first_block.settings.image_mobile.aspect_ratio
    endif
  endif

  # Media size: "original" = height follows the ratio, others = fixed height
  assign height_d = 'auto'
  assign aspect_d = ratio_d
  case section.settings.size_desktop
    when 'large'
      assign height_d = '770px'
      assign aspect_d = 'auto'
    when 'medium'
      assign height_d = '550px'
      assign aspect_d = 'auto'
    when 'small'
      assign height_d = '400px'
      assign aspect_d = 'auto'
  endcase

  assign height_m = 'auto'
  assign aspect_m = ratio_m
  case section.settings.size_mobile
    when 'large'
      assign height_m = '770px'
      assign aspect_m = 'auto'
    when 'medium'
      assign height_m = '550px'
      assign aspect_m = 'auto'
    when 'small'
      assign height_m = '400px'
      assign aspect_m = 'auto'
  endcase

  # Maximum height (0 = no limit). Ignored when "Fit to screen" is on.
  assign max_h_d = 'none'
  assign max_h_m = 'none'
  unless section.settings.fit_screen
    if section.settings.max_height_desktop > 0
      assign max_h_d = section.settings.max_height_desktop | append: section.settings.max_height_unit
    endif
    if section.settings.max_height_mobile > 0
      assign max_h_m = section.settings.max_height_mobile | append: section.settings.max_height_unit
    endif
  endunless

  # Fit to screen: on mobile, stacked slides share the screen
  assign fit_m = '100svh'
  if per_view == 2 or layout == 'split'
    assign fit_m = '50svh'
  endif

  # Overlay (not used in the split layout)
  assign show_overlay = false
  if layout != 'split' and section.settings.overlay_type != 'none'
    assign show_overlay = true
  endif

  # Split layout column widths
  assign split_image_w = section.settings.split_image_width
  assign split_text_w = 100 | minus: split_image_w

  # Image "sizes" attribute
  assign img_sizes = '100vw'
  if layout == 'two_col'
    assign img_sizes = '(min-width: 750px) 50vw, 100vw'
  elsif layout == 'split'
    assign img_sizes = '(min-width: 750px) ' | append: split_image_w | append: 'vw, 100vw'
  endif
-%}

{%- capture overlay_bg -%}
  {%- if section.settings.overlay_type == 'gradient' -%}
    linear-gradient({{ section.settings.gradient_direction | default: 'to top' }}, {{ section.settings.gradient_start | default: '#000000' }}, {{ section.settings.gradient_end | default: '#ffffff' }})
  {%- else -%}
    {{ section.settings.overlay_color | default: '#000000' }}
  {%- endif -%}
{%- endcapture -%}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  #CustomSlideshow-{{ section.id }} {
    --cs-h: {{ height_m }};
    --cs-ratio: {{ aspect_m }};
    --cs-max-h: {{ max_h_m }};
    --cs-fit-h: {{ fit_m }};
    --cs-cols: {{ per_view }};
    --cs-dot: {{ section.settings.dot_color }};
    --cs-dot-active: {{ section.settings.dot_active_color }};
    --cs-split-bg: {{ section.settings.split_text_bg }};
    --cs-split-cols: {{ split_text_w }}fr {{ split_image_w }}fr;
  }

  {%- if show_overlay -%}
    #CustomSlideshow-{{ section.id }} .cs-overlay {
      background: {{ overlay_bg | strip }};
      opacity: {{ section.settings.overlay_opacity | divided_by: 100.0 }};
    }
  {%- endif -%}

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }

    #CustomSlideshow-{{ section.id }} {
      --cs-h: {{ height_d }};
      --cs-ratio: {{ aspect_d }};
      --cs-max-h: {{ max_h_d }};
      --cs-fit-h: 100svh;
    }
  }

  {%- for block in section.blocks -%}
    {%- liquid
      assign sel = '#CustomSlide-' | append: block.id

      # Layouts 1-2 use the white colors, Layout 3 has its own colors (light background)
      assign title_color = block.settings.title_color
      assign text_color = block.settings.text_color
      if layout == 'split'
        assign title_color = block.settings.title_color_split
        assign text_color = block.settings.text_color_split
      endif
    -%}
    {{ sel }} .cs-title { color: {{ title_color }}; }
    {{ sel }} .cs-text { color: {{ text_color }}; }
    {{ sel }} .cs-inner { gap: {{ block.settings.gap }}px; }
    {{ sel }} .cs-content {
      padding: {{ block.settings.padding_top_mobile }}px {{ block.settings.padding_right_mobile }}px {{ block.settings.padding_bottom_mobile }}px {{ block.settings.padding_left_mobile }}px;
    }
    @media screen and (min-width: 750px) {
      {{ sel }} .cs-content {
        padding: {{ block.settings.padding_top_desktop }}px {{ block.settings.padding_right_desktop }}px {{ block.settings.padding_bottom_desktop }}px {{ block.settings.padding_left_desktop }}px;
      }
    }
  {%- endfor -%}
{%- endstyle -%}

<div class="section-{{ section.id }}-padding">
  {%- if section.blocks.size == 0 -%}
    {%- if request.design_mode -%}
      <div class="cs-empty">Add slides to this section to get started.</div>
    {%- endif -%}
  {%- else -%}
    <custom-slideshow
      id="CustomSlideshow-{{ section.id }}"
      class="cs-slideshow cs-slideshow--{{ layout }}{% if section.settings.enable_fade %} cs-slideshow--fade{% endif %}{% if section.settings.fit_screen %} cs-slideshow--fit{% endif %}"
      role="region"
      aria-roledescription="carousel"
      aria-label="{{ section.settings.a11y_label | escape }}"
      data-per-view="{{ per_view }}"
      data-pair="{{ pair_mode }}"
      data-pages="{{ page_count }}"
      data-autoplay="{{ autoplay_on }}"
      data-speed="{{ section.settings.autoplay_speed }}"
      data-mobile-order="{{ section.settings.split_mobile_order }}"
    >
      <div class="cs-track" data-cs-track aria-live="{% if autoplay_on %}off{% else %}polite{% endif %}">
        {%- for block in section.blocks -%}
          {%- liquid
            assign is_first_view = false
            if forloop.index0 < per_view
              assign is_first_view = true
            endif

            assign loading = 'lazy'
            assign fetch_priority = 'auto'
            if is_first_view
              assign loading = 'eager'
              assign fetch_priority = 'high'
            endif

            assign image_d = block.settings.image
            assign image_m = block.settings.image_mobile
            assign video_d = block.settings.video
            assign video_m = block.settings.video_mobile

            # One media type per slide. Layout 3 is image-only.
            assign use_video = false
            if layout != 'split' and block.settings.media_type == 'video'
              assign use_video = true
            endif

            # Alignment: "auto" = center (Layouts 1-2) or left (Layout 3)
            assign auto_h = 'center'
            if layout == 'split'
              assign auto_h = 'left'
            endif
            assign h_d = block.settings.h_align_desktop
            if h_d == 'auto' or h_d == blank
              assign h_d = auto_h
            endif
            assign h_m = block.settings.h_align_mobile
            if h_m == 'auto' or h_m == blank
              assign h_m = auto_h
            endif
            assign v_d = block.settings.v_align_desktop | default: 'bottom'
            assign v_m = block.settings.v_align_mobile | default: 'bottom'

            assign placeholder_n = forloop.index0 | modulo: 2 | plus: 1
            assign placeholder_name = 'hero-apparel-' | append: placeholder_n
          -%}

          {%- capture media_html -%}
            <div class="cs-slide__media">
              {%- if use_video -%}
                {%- if video_d != blank and video_m != blank -%}
                  {{ video_d | video_tag: image_size: '1920x', loop: true, muted: true, controls: false, playsinline: true, preload: 'metadata', class: 'cs-video cs-desktop-only' }}
                  {{ video_m | video_tag: image_size: '1080x', loop: true, muted: true, controls: false, playsinline: true, preload: 'metadata', class: 'cs-video cs-mobile-only' }}
                {%- elsif video_d != blank or video_m != blank -%}
                  {%- assign video_single = video_d | default: video_m -%}
                  {{ video_single | video_tag: image_size: '1920x', loop: true, muted: true, controls: false, playsinline: true, preload: 'metadata', class: 'cs-video' }}
                {%- else -%}
                  {{ placeholder_name | placeholder_svg_tag: 'cs-img placeholder-svg' }}
                {%- endif -%}
              {%- elsif image_d != blank or image_m != blank -%}
                {%- assign img_main = image_d | default: image_m -%}
                <picture>
                  {%- if image_d != blank and image_m != blank -%}
                    <source
                      media="(max-width: 749px)"
                      srcset="{{ image_m | image_url: width: 750 }} 750w, {{ image_m | image_url: width: 1100 }} 1100w, {{ image_m | image_url: width: 1500 }} 1500w"
                      sizes="100vw"
                    >
                  {%- endif -%}
                  {{
                    img_main
                    | image_url: width: 3000
                    | image_tag:
                      loading: loading,
                      fetchpriority: fetch_priority,
                      widths: '750, 1100, 1500, 1780, 2000, 3000',
                      sizes: img_sizes,
                      class: 'cs-img'
                  }}
                </picture>
              {%- else -%}
                {{ placeholder_name | placeholder_svg_tag: 'cs-img placeholder-svg' }}
              {%- endif -%}

              {%- if show_overlay -%}
                <div class="cs-overlay" aria-hidden="true"></div>
              {%- endif -%}
            </div>
          {%- endcapture -%}

          {%- capture content_html -%}
            <div
              class="cs-slide__content cs-content"
              data-h-d="{{ h_d }}"
              data-v-d="{{ v_d }}"
              data-h-m="{{ h_m }}"
              data-v-m="{{ v_m }}"
            >
              <div class="cs-inner">
                {%- if block.settings.heading != blank -%}
                  <h2
                    class="cs-title"
                    data-size-d="{{ block.settings.title_size_desktop }}"
                    data-size-m="{{ block.settings.title_size_mobile }}"
                  >
                    {{- block.settings.heading -}}
                  </h2>
                {%- endif -%}

                {%- if block.settings.text != blank -%}
                  <div
                    class="cs-text rte"
                    data-size-d="{{ block.settings.text_size_desktop }}"
                    data-size-m="{{ block.settings.text_size_mobile }}"
                  >
                    {{- block.settings.text -}}
                  </div>
                {%- endif -%}

                {%- capture buttons_html -%}
                  {%- render 'custom-slideshow-button', block: block, index: 1, layout: layout -%}
                  {%- render 'custom-slideshow-button', block: block, index: 2, layout: layout -%}
                {%- endcapture -%}
                {%- if buttons_html != blank -%}
                  <div class="cs-buttons">{{ buttons_html }}</div>
                {%- endif -%}
              </div>
            </div>
          {%- endcapture -%}

          <div
            id="CustomSlide-{{ block.id }}"
            class="cs-slide{% if is_first_view %} is-active{% endif %}"
            role="group"
            aria-roledescription="slide"
            aria-label="{{ forloop.index }} of {{ forloop.length }}"
            aria-hidden="{% if is_first_view %}false{% else %}true{% endif %}"
            data-cs-slide
            {{ block.shopify_attributes }}
          >
            {%- if layout == 'split' -%}
              {{ content_html }}
              {{ media_html }}
            {%- else -%}
              {{ media_html }}
              {{ content_html }}
            {%- endif -%}
          </div>
        {%- endfor -%}
      </div>

      {%- if page_count > 1 -%}
        <div class="cs-dots" role="group" aria-label="Choose slide to display" data-cs-dots>
          {%- for i in (1..page_count) -%}
            {%- if pair_mode -%}
              {%- assign dot_label = 'Go to slide group ' | append: i | append: ' of ' | append: page_count -%}
            {%- else -%}
              {%- assign dot_label = 'Go to slide ' | append: i | append: ' of ' | append: page_count -%}
            {%- endif -%}
            <button
              type="button"
              class="cs-dot{% if forloop.first %} is-active{% endif %}"
              aria-label="{{ dot_label }}"
              {% if forloop.first %}aria-current="true"{% endif %}
              data-cs-dot
              data-page="{{ forloop.index0 }}"
            ></button>
          {%- endfor -%}
        </div>
      {%- endif -%}
    </custom-slideshow>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "Custom slideshow",
  "tag": "section",
  "class": "custom-slideshow-section",
  "max_blocks": 10,
  "settings": [
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Layout",
      "options": [
        {
          "value": "full",
          "label": "Layout 1 - Full-width slide"
        },
        {
          "value": "two_col",
          "label": "Layout 2 - Two-column slides"
        },
        {
          "value": "split",
          "label": "Layout 3 - Text left, image right"
        }
      ],
      "default": "full",
      "info": "Layouts 2 and 3 have a minimum slide height of 810px on desktop."
    },
    {
      "type": "select",
      "id": "two_col_advance",
      "label": "Slides move",
      "options": [
        {
          "value": "pair",
          "label": "Two slides at a time"
        },
        {
          "value": "single",
          "label": "One slide at a time"
        }
      ],
      "default": "pair",
      "visible_if": "{{ section.settings.layout == 'two_col' }}",
      "info": "Layout 2 stacks the two columns on mobile. Each slide is at least 810px tall on desktop."
    },
    {
      "type": "range",
      "id": "split_image_width",
      "label": "Image width",
      "min": 30,
      "max": 70,
      "step": 5,
      "unit": "%",
      "default": 50,
      "visible_if": "{{ section.settings.layout == 'split' }}",
      "info": "The text column takes the remaining width."
    },
    {
      "type": "select",
      "id": "split_mobile_order",
      "label": "Mobile order",
      "options": [
        {
          "value": "text",
          "label": "Text first"
        },
        {
          "value": "image",
          "label": "Image first"
        }
      ],
      "default": "image",
      "visible_if": "{{ section.settings.layout == 'split' }}"
    },
    {
      "type": "color",
      "id": "split_text_bg",
      "label": "Text column background",
      "default": "#ffffff",
      "visible_if": "{{ section.settings.layout == 'split' }}",
      "info": "Text sits on this color, not on the image."
    },
    {
      "type": "header",
      "content": "Media size"
    },
    {
      "type": "select",
      "id": "size_desktop",
      "label": "Media size (desktop)",
      "options": [
        {
          "value": "original",
          "label": "Original image ratio"
        },
        {
          "value": "large",
          "label": "Large (770px height)"
        },
        {
          "value": "medium",
          "label": "Medium (550px height)"
        },
        {
          "value": "small",
          "label": "Small (400px height)"
        }
      ],
      "default": "original",
      "info": "Original keeps the first image's ratio. Media always fills the slide (cropped, never stretched)."
    },
    {
      "type": "select",
      "id": "size_mobile",
      "label": "Media size (mobile)",
      "options": [
        {
          "value": "original",
          "label": "Original image ratio"
        },
        {
          "value": "large",
          "label": "Large (770px height)"
        },
        {
          "value": "medium",
          "label": "Medium (550px height)"
        },
        {
          "value": "small",
          "label": "Small (400px height)"
        }
      ],
      "default": "original"
    },
    {
      "type": "checkbox",
      "id": "fit_screen",
      "label": "Fit to screen",
      "default": false,
      "info": "Slide height matches the screen height. Overrides media size and maximum height. In Layouts 2 and 3 on mobile, each stacked item takes half the screen."
    },
    {
      "type": "select",
      "id": "max_height_unit",
      "label": "Maximum height unit",
      "options": [
        {
          "value": "px",
          "label": "Pixels (px)"
        },
        {
          "value": "vh",
          "label": "Screen height (vh)"
        }
      ],
      "default": "px"
    },
    {
      "type": "range",
      "id": "max_height_desktop",
      "label": "Maximum height (desktop)",
      "min": 0,
      "max": 1200,
      "step": 20,
      "default": 0,
      "info": "0 = no limit. If the unit is vh, use values from 20 to 100. Ignored when Fit to screen is on."
    },
    {
      "type": "range",
      "id": "max_height_mobile",
      "label": "Maximum height (mobile)",
      "min": 0,
      "max": 1200,
      "step": 20,
      "default": 0,
      "info": "0 = no limit."
    },
    {
      "type": "header",
      "content": "Overlay (Layouts 1 and 2)"
    },
    {
      "type": "select",
      "id": "overlay_type",
      "label": "Overlay type",
      "options": [
        {
          "value": "none",
          "label": "None"
        },
        {
          "value": "color",
          "label": "Solid color"
        },
        {
          "value": "gradient",
          "label": "Gradient"
        }
      ],
      "default": "color"
    },
    {
      "type": "color",
      "id": "overlay_color",
      "label": "Overlay color",
      "default": "#000000",
      "visible_if": "{{ section.settings.overlay_type == 'color' }}"
    },
    {
      "type": "color",
      "id": "gradient_start",
      "label": "Gradient start color",
      "default": "#000000",
      "visible_if": "{{ section.settings.overlay_type == 'gradient' }}"
    },
    {
      "type": "color",
      "id": "gradient_end",
      "label": "Gradient end color",
      "default": "#ffffff",
      "visible_if": "{{ section.settings.overlay_type == 'gradient' }}"
    },
    {
      "type": "select",
      "id": "gradient_direction",
      "label": "Gradient direction",
      "options": [
        {
          "value": "to top",
          "label": "Bottom to top"
        },
        {
          "value": "to bottom",
          "label": "Top to bottom"
        },
        {
          "value": "to left",
          "label": "Right to left"
        },
        {
          "value": "to right",
          "label": "Left to right"
        }
      ],
      "default": "to top",
      "visible_if": "{{ section.settings.overlay_type == 'gradient' }}"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "Overlay opacity",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 40,
      "visible_if": "{{ section.settings.overlay_type != 'none' }}"
    },
    {
      "type": "header",
      "content": "Animation"
    },
    {
      "type": "checkbox",
      "id": "enable_fade",
      "label": "Fade animation",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "autoplay",
      "label": "Autoplay slides",
      "default": true,
      "info": "Pauses on hover and keyboard focus. Turned off for visitors who prefer reduced motion."
    },
    {
      "type": "range",
      "id": "autoplay_speed",
      "label": "Change slides every",
      "min": 3,
      "max": 10,
      "step": 1,
      "unit": "s",
      "default": 5,
      "visible_if": "{{ section.settings.autoplay }}"
    },
    {
      "type": "header",
      "content": "Navigation dots"
    },
    {
      "type": "paragraph",
      "content": "Dots only appear when there is more than one slide to navigate."
    },
    {
      "type": "color",
      "id": "dot_color",
      "label": "Dot color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "dot_active_color",
      "label": "Active dot color",
      "default": "#000000"
    },
    {
      "type": "header",
      "content": "Accessibility"
    },
    {
      "type": "text",
      "id": "a11y_label",
      "label": "Slideshow label",
      "default": "Slideshow",
      "info": "Read aloud by screen readers."
    },
    {
      "type": "header",
      "content": "Section spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 0
    }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "Slide",
      "settings": [
        {
          "type": "header",
          "content": "Media"
        },
        {
          "type": "select",
          "id": "media_type",
          "label": "Media type",
          "options": [
            {
              "value": "image",
              "label": "Image"
            },
            {
              "value": "video",
              "label": "Video"
            }
          ],
          "default": "image",
          "info": "Only the fields of the selected type are shown. Layout 3 supports Image only, so set the slide to Image there."
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image (desktop)",
          "visible_if": "{{ block.settings.media_type == 'image' }}"
        },
        {
          "type": "image_picker",
          "id": "image_mobile",
          "label": "Image (mobile)",
          "info": "Optional. Desktop image is used if empty.",
