<style>
  .section-padding-{{section.id }} {
    padding-top: {{ section.settings.padding_top_desktop }}px;
    padding-bottom: {{ section.settings.padding_bottom_desktop }}px;
  }

  @media screen and (max-width: 749px) {
    .section-padding-{{section.id }} {
      padding-top: {{ section.settings.padding_top_mobile }}px;
      padding-bottom: {{ section.settings.padding_bottom_mobile }}px;
    }
  }

  .section-padding-{{section.id}} .collections_blocks_wrap {
    grid-template-columns: repeat({{section.settings.block_column }}, minmax(0, 1fr));
  }

</style>


{% schema %}
{
  "name": "Logo Marquee Section",
  "settings": [
    {
      "type": "header",
      "content": "Section Spacing"
    },
    {
        "type": "range",
        "id": "block_column",
        "min": 2,
        "max": 5,
        "step": 1,
        "label": "Column Layout",
        "default": 3
    },
    {
    "type": "select",
    "id": "title_alignment",
    "label": "Title alignment",
    "options": [
        {
        "value": "top",
        "label": "Top Left"
        },
        {
        "value": "middle",
        "label": "Middle Bottom"
        }
    ],
    "default": "middle"
    },
    {
      "type": "range",
      "id": "padding_top_desktop",
      "label": "Padding Top Desktop",
      "min": 0,
      "max": 200,
      "step": 5,
      "default": 50
    },
    {
      "type": "range",
      "id": "padding_bottom_desktop",
      "label": "Padding Bottom Desktop",
      "min": 0,
      "max": 200,
      "step": 5,
      "default": 50
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "Padding Top Mobile",
      "min": 0,
      "max": 200,
      "step": 5,
      "default": 30
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "Padding Bottom Mobile",
      "min": 0,
      "max": 200,
      "step": 5,
      "default": 30
    }
  ],
  "blocks": [
    {
      "type": "collection_block",
      "name": "Collection Block",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "Select Collection"
        },
        {
          "type": "image_picker",
          "id": "custom_image",
          "label": "Custom Image (Fallback)"
        },
        {
          "type": "text",
          "id": "custom_title",
          "label": "Custom Title"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Logo Marquee Section",
      "category": "Media"
    }
  ]
}
{% endschema %}