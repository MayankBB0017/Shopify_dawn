<style>
  .section-padding-{{ section.id }} {
    padding-top: {{ section.settings.padding_top_desktop }}px;
    padding-bottom: {{ section.settings.padding_bottom_desktop }}px;
  }

  @media screen and (max-width: 749px) {
    .section-padding-{{ section.id }} {
      padding-top: {{ section.settings.padding_top_mobile }}px;
      padding-bottom: {{ section.settings.padding_bottom_mobile }}px;
    }
  }

  .logo_marquee_section .marquee {
    overflow: hidden;
    position: relative;
  }

  .logo_marquee_section .marquee-track {
    display: flex;
    width: max-content;
    animation: marquee-scroll-{{ section.id }} {{ section.settings.marquee_speed }}s {{ section.settings.marquee_animation_style }} infinite;
    {% if section.settings.marquee_direction == 'rtl' %}
      animation-direction: reverse;
    {% endif %}
  }

  {% if section.settings.pause_on_hover %}
  .logo_marquee_section .marquee-track:hover {
    animation-play-state: paused;
  }
  {% endif %}

  @keyframes marquee-scroll-{{ section.id }} {
    0% {
      transform: translateX(0);
    }
    100% {
      transform: translateX(-50%);
    }
  }

  .logo_marquee_section .icon_wrapper {
    flex: 0 0 auto;
    margin-right: 7.5rem;
  }

  .logo_marquee_section img {
    display: block;
    height: auto;
    max-width: 100%;
    min-height: 40px;
    max-height: 40px;
  }

  @media screen and (max-width: 749px) {
    .logo_marquee_section .icon_wrapper {
      margin-right: 2.5rem;
    }
  }
</style>

<section class="logo_marquee_section section-padding-{{ section.id }}">
  <div class="marquee">
    <div class="marquee-track">
      {% for block in section.blocks %}
        <div class="icon_wrapper">
          <img
            srcset="
              {% if block.settings.logo.width >= 350 %}{{ block.settings.logo | image_url: width: 350 }} 350w,{% endif %}
              {% if block.settings.logo.width >= 750 %}{{ block.settings.logo | image_url: width: 750 }} 750w,{% endif %}
              {% if block.settings.logo.width >= 1100 %}{{ block.settings.logo | image_url: width: 1100 }} 1100w,{% endif %}
              {% if block.settings.logo.width >= 1500 %}{{ block.settings.logo | image_url: width: 1500 }} 1500w,{% endif %}
              {{ block.settings.logo | image_url }} {{ block.settings.logo.width }}w
            "
            sizes="(min-width: {{ settings.page_width }}px) {{ settings.page_width | minus: 100 }}px, (min-width: 750px) calc(100vw - 10rem), 100vw"
            src="{{ block.settings.logo | image_url: width: 1100 }}"
            loading="eager"
            fetchpriority="high"
            width="{{ block.settings.logo.width }}"
            height="{{ block.settings.logo.height }}"
            alt="{{ block.settings.logo.alt | escape }}"
          >
        </div>
      {% endfor %}
      
      {% for block in section.blocks %}
        <div class="icon_wrapper">
          <img
            srcset="
              {% if block.settings.logo.width >= 350 %}{{ block.settings.logo | image_url: width: 350 }} 350w,{% endif %}
              {% if block.settings.logo.width >= 750 %}{{ block.settings.logo | image_url: width: 750 }} 750w,{% endif %}
              {% if block.settings.logo.width >= 1100 %}{{ block.settings.logo | image_url: width: 1100 }} 1100w,{% endif %}
              {% if block.settings.logo.width >= 1500 %}{{ block.settings.logo | image_url: width: 1500 }} 1500w,{% endif %}
              {{ block.settings.logo | image_url }} {{ block.settings.logo.width }}w
            "
            sizes="(min-width: {{ settings.page_width }}px) {{ settings.page_width | minus: 100 }}px, (min-width: 750px) calc(100vw - 10rem), 100vw"
            src="{{ block.settings.logo | image_url: width: 1100 }}"
            loading="eager"
            fetchpriority="high"
            width="{{ block.settings.logo.width }}"
            height="{{ block.settings.logo.height }}"
            alt="{{ block.settings.logo.alt | escape }}"
          >
        </div>
      {% endfor %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Logo Marquee Section",
  "settings": [
    {
      "type": "header",
      "content": "Section Spacing"
    },
    {
      "type": "range",
      "id": "padding_top_desktop",
      "label": "Padding Top Desktop",
      "min": 0,
      "max": 200,
      "step": 5,
      "default": 50
    },
    {
      "type": "range",
      "id": "padding_bottom_desktop",
      "label": "Padding Bottom Desktop",
      "min": 0,
      "max": 200,
      "step": 5,
      "default": 50
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "Padding Top Mobile",
      "min": 0,
      "max": 200,
      "step": 5,
      "default": 30
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "Padding Bottom Mobile",
      "min": 0,
      "max": 200,
      "step": 5,
      "default": 30
    },
    {
      "type": "range",
      "id": "marquee_speed",
      "label": "Marquee Speed (seconds)",
      "min": 10,
      "max": 110,
      "step": 1,
      "default": 60
    },
    {
      "type": "select",
      "id": "marquee_direction",
      "label": "Direction",
      "default": "ltr",
      "options": [
        { "value": "ltr", "label": "Left to Right" },
        { "value": "rtl", "label": "Right to Left" }
      ]
    },
    {
      "type": "select",
      "id": "marquee_animation_style",
      "label": "Animation Style",
      "default": "linear",
      "options": [
        { "value": "linear", "label": "Linear" },
        { "value": "ease", "label": "Ease" },
        { "value": "ease-in", "label": "Ease-In" },
        { "value": "ease-out", "label": "Ease-Out" },
        { "value": "ease-in-out", "label": "Ease-In-Out" }
      ]
    },
    {
      "type": "checkbox",
      "id": "pause_on_hover",
      "label": "Pause on Hover",
      "default": true
    }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Item",
      "settings": [
        {
          "type": "image_picker",
          "id": "logo",
          "label": "Logo"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Logo Marquee Section",
      "category": "Media"
    }
  ]
}
{% endschema %}