{{ 'section-instagram-grid.css' | asset_url | stylesheet_tag }}
<script src="{{ 'instagram-grid.js' | asset_url }}" defer="defer"></script>

{%- liquid
  assign content_source = section.settings.content_source
  if content_source != 'app'
    assign content_source = 'manual'
  endif

  assign profile_url = section.settings.profile_link
  if profile_url == blank
    assign profile_url = settings.social_instagram_link
  endif

  assign cta_url = section.settings.cta_link
  if cta_url == blank
    assign cta_url = profile_url
  endif

  assign cta_label = section.settings.cta_label
  if cta_label == blank
    assign cta_label = 'sections.instagram_grid.view_more' | t
  endif

  assign post_blocks = section.blocks | where: 'type', 'post'
  assign post_count = post_blocks.size

  assign visibility_class = ''
  unless section.settings.show_on_desktop
    assign visibility_class = visibility_class | append: ' instagram-grid--hide-desktop'
  endunless
  unless section.settings.show_on_mobile
    assign visibility_class = visibility_class | append: ' instagram-grid--hide-mobile'
  endunless

  assign container_class = ''
  assign container_modifier = 'full'
  if section.settings.container_width == 'standard'
    assign container_class = 'page-width'
    assign container_modifier = 'standard'
  elsif section.settings.container_width == 'full_width'
    assign container_class = ''
    assign container_modifier = 'full'
  endif
-%}

{%- style -%}
  #InstagramGrid-{{ section.id }} {
    --ig-padding-top-mobile: {{ section.settings.padding_top_mobile }}px;
    --ig-padding-bottom-mobile: {{ section.settings.padding_bottom_mobile }}px;
    --ig-padding-top-desktop: {{ section.settings.padding_top_desktop }}px;
    --ig-padding-bottom-desktop: {{ section.settings.padding_bottom_desktop }}px;
  }
{%- endstyle -%}

<instagram-grid
  id="InstagramGrid-{{ section.id }}"
  class="instagram-grid instagram-grid--layout-5 instagram-grid--container-{{ container_modifier }} instagram-grid--source-{{ content_source }} color-{{ section.settings.color_scheme }} gradient{{ visibility_class }}{% if section.settings.enable_fade_in_desktop != false %} instagram-grid--fade-in-desktop{% endif %}{% if section.settings.enable_fade_in_mobile != false %} instagram-grid--fade-in-mobile{% endif %}{% if request.design_mode %} instagram-grid--fade-visible{% endif %}"
>
  <div class="instagram-grid__stage">
  <div class="instagram-grid__shell{% if container_class != blank %} {{ container_class }}{% endif %}">
    {%- if section.settings.heading != blank -%}
      <header class="instagram-grid__header instagram-grid__animate">
        <div class="instagram-grid__animate-inner">
        {%- if profile_url != blank -%}
          <a href="{{ profile_url }}" class="instagram-grid__heading-link" target="_blank" rel="noopener noreferrer">
        {%- endif -%}
        <h2 class="instagram-grid__heading {{ section.settings.heading_size }}">
          {{ section.settings.heading | escape }}
        </h2>
        {%- if profile_url != blank -%}
          </a>
        {%- endif -%}
        </div>
      </header>
    {%- endif -%}

    {%- if content_source == 'manual' -%}
      {%- if post_count > 0 -%}
        <div class="instagram-grid__grid">
          {% render 'instagram-grid-masonry',
            section: section,
            layout_variant: 'five_columns',
            post_blocks: post_blocks
          %}

          {% render 'instagram-grid-masonry',
            section: section,
            layout_variant: 'mobile',
            post_blocks: post_blocks
          %}
        </div>
      {%- elsif request.design_mode -%}
        <p class="instagram-grid__empty caption">{{ 'sections.instagram_grid.empty_manual' | t }}</p>
      {%- endif -%}
    {%- else -%}
      <div class="instagram-grid__app">
        {%- for block in section.blocks -%}
          {%- if block.type == '@app' -%}
            <div class="instagram-grid__app-block" {{ block.shopify_attributes }}>
              {% render block %}
            </div>
          {%- endif -%}
        {%- endfor -%}
        {%- if request.design_mode -%}
          {%- assign has_app_block = false -%}
          {%- for block in section.blocks -%}
            {%- if block.type == '@app' -%}
              {%- assign has_app_block = true -%}
            {%- endif -%}
          {%- endfor -%}
          {%- unless has_app_block -%}
            <p class="instagram-grid__empty caption">{{ 'sections.instagram_grid.empty_app' | t }}</p>
          {%- endunless -%}
        {%- endif -%}
      </div>
    {%- endif -%}

    {%- if cta_url != blank -%}
      <footer class="instagram-grid__footer instagram-grid__animate instagram-grid__animate--footer">
        <div class="instagram-grid__animate-inner">
        <a
          href="{{ cta_url }}"
          class="instagram-grid__cta link underlined-link"
          target="_blank"
          rel="noopener noreferrer"
        >
          {{ cta_label | escape }}
        </a>
        </div>
      </footer>
    {%- endif -%}
  </div>
  </div>
</instagram-grid>

{% schema %}
{
  "name": "t:sections.instagram_grid.name",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "header",
      "content": "t:sections.instagram_grid.settings.header_content.content"
    },
    {
      "type": "select",
      "id": "content_source",
      "label": "t:sections.instagram_grid.settings.content_source.label",
      "info": "t:sections.instagram_grid.settings.content_source.info",
      "options": [
        {
          "value": "manual",
          "label": "t:sections.instagram_grid.settings.content_source.options__manual.label"
        },
        {
          "value": "app",
          "label": "t:sections.instagram_grid.settings.content_source.options__app.label"
        }
      ],
      "default": "manual"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:sections.instagram_grid.settings.heading.label",
      "default": "@Janeproducts"
    },
    {
      "type": "url",
      "id": "profile_link",
      "label": "t:sections.instagram_grid.settings.profile_link.label",
      "info": "t:sections.instagram_grid.settings.profile_link.info"
    },
    {
      "type": "select",
      "id": "heading_size",
      "label": "t:sections.instagram_grid.settings.heading_size.label",
      "options": [
        {
          "value": "h2",
          "label": "t:sections.all.heading_size.options__1.label"
        },
        {
          "value": "h1",
          "label": "t:sections.all.heading_size.options__2.label"
        }
      ],
      "default": "h2"
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "t:sections.instagram_grid.settings.cta_label.label",
      "info": "t:sections.instagram_grid.settings.cta_label.info"
    },
    {
      "type": "url",
      "id": "cta_link",
      "label": "t:sections.instagram_grid.settings.cta_link.label",
      "info": "t:sections.instagram_grid.settings.cta_link.info"
    },
    {
      "type": "header",
      "content": "t:sections.instagram_grid.settings.header_layout.content"
    },
    {
      "type": "select",
      "id": "container_width",
      "label": "t:sections.instagram_grid.settings.container_width.label",
      "info": "t:sections.instagram_grid.settings.container_width.info",
      "options": [
        {
          "value": "standard",
          "label": "t:sections.instagram_grid.settings.container_width.options__standard.label"
        },
        {
          "value": "full_width",
          "label": "t:sections.instagram_grid.settings.container_width.options__full_width.label"
        }
      ],
      "default": "full_width"
    },
    {
      "type": "checkbox",
      "id": "show_on_desktop",
      "label": "t:sections.instagram_grid.settings.show_on_desktop.label",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_on_mobile",
      "label": "t:sections.instagram_grid.settings.show_on_mobile.label",
      "default": true
    },
    {
      "type": "header",
      "content": "t:sections.instagram_grid.settings.header_animation.content"
    },
    {
      "type": "checkbox",
      "id": "enable_fade_in_desktop",
      "label": "t:sections.instagram_grid.settings.enable_fade_in_desktop.label",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "enable_fade_in_mobile",
      "label": "t:sections.instagram_grid.settings.enable_fade_in_mobile.label",
      "default": true
    },
    {
      "type": "header",
      "content": "t:sections.instagram_grid.settings.header_padding.content"
    },
    {
      "type": "range",
      "id": "padding_top_desktop",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.instagram_grid.settings.padding_top_desktop.label",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom_desktop",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.instagram_grid.settings.padding_bottom_desktop.label",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.instagram_grid.settings.padding_top_mobile.label",
      "default": 32
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.instagram_grid.settings.padding_bottom_mobile.label",
      "default": 32
    },
    {
      "type": "header",
      "content": "t:sections.all.colors.label"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    },
    {
      "type": "paragraph",
      "content": "t:sections.instagram_grid.settings.app_embed_info.content",
      "visible_if": "{{ section.settings.content_source == 'app' }}"
    }
  ],
  "blocks": [
    {
      "type": "post",
      "name": "t:sections.instagram_grid.blocks.post.name",
      "limit": 8,
      "settings": [
        {
          "type": "select",
          "id": "media_type",
          "label": "t:sections.instagram_grid.blocks.post.settings.media_type.label",
          "options": [
            {
              "value": "image",
              "label": "t:sections.instagram_grid.blocks.post.settings.media_type.options__image.label"
            },
            {
              "value": "video",
              "label": "t:sections.instagram_grid.blocks.post.settings.media_type.options__video.label"
            }
          ],
          "default": "image"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "t:sections.instagram_grid.blocks.post.settings.image.label",
          "visible_if": "{{ block.settings.media_type == 'image' }}"
        },
        {
          "type": "video",
          "id": "video",
          "label": "t:sections.instagram_grid.blocks.post.settings.video.label",
          "visible_if": "{{ block.settings.media_type == 'video' }}"
        },
        {
          "type": "image_picker",
          "id": "video_poster",
          "label": "t:sections.instagram_grid.blocks.post.settings.video_poster.label",
          "info": "t:sections.instagram_grid.blocks.post.settings.video_poster.info",
          "visible_if": "{{ block.settings.media_type == 'video' }}"
        },
        {
          "type": "url",
          "id": "link",
          "label": "t:sections.instagram_grid.blocks.post.settings.link.label"
        },
        {
          "type": "text",
          "id": "alt_text",
          "label": "t:sections.instagram_grid.blocks.post.settings.alt_text.label",
          "info": "t:sections.instagram_grid.blocks.post.settings.alt_text.info"
        },
        {
          "type": "select",
          "id": "tile_size",
          "label": "t:sections.instagram_grid.blocks.post.settings.tile_size.label",
          "info": "t:sections.instagram_grid.blocks.post.settings.tile_size.info",
          "options": [
            {
              "value": "auto",
              "label": "t:sections.instagram_grid.blocks.post.settings.tile_size.options__auto.label"
            },
            {
              "value": "square",
              "label": "t:sections.instagram_grid.blocks.post.settings.tile_size.options__square.label"
            },
            {
              "value": "tall",
              "label": "t:sections.instagram_grid.blocks.post.settings.tile_size.options__tall.label"
            }
          ],
          "default": "auto"
        }
      ]
    },
    {
      "type": "@app"
    }
  ],
  "presets": [
    {
      "name": "t:sections.instagram_grid.presets.name",
      "category": "t:sections.all.jane_custom_sections.category",
      "blocks": [
        {
          "type": "post",
          "settings": {
            "media_type": "image"
          }
        },
        {
