            "media_type": "image"
          }
        },
        {
          "type": "post",
          "settings": {
            "media_type": "image"
          }
        },
        {
          "type": "post",
          "settings": {
            "media_type": "video"
          }
        },
        {
          "type": "post",
          "settings": {
            "media_type": "image"
          }
        },
        {
          "type": "post",
          "settings": {
            "media_type": "image"
          }
        }
