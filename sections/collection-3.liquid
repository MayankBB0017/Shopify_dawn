<div class="editorial-grid">

  {% for block in section.blocks %}
    <div class="editorial-card">

      {% if block.settings.image != blank %}
        {{
          block.settings.image
          | image_url: width: 1200
          | image_tag:
          loading: 'lazy',
          class: 'editorial-image'
        }}
      {% endif %}

      <div class="editorial-title">
        {{ block.settings.title }}
      </div>

    </div>
  {% endfor %}

</div>

<style>
    .editorial-grid{
    display:grid;
    grid-template-columns:repeat(4,1fr);
    gap:0;
    width:100%;
}

.editorial-card{
    position:relative;
    overflow:hidden;
    aspect-ratio:3/5;
    background:#f5f5f5;
}

.editorial-image{
    width:100%;
    height:100%;
    object-fit:cover;
    display:block;
    transition:transform .4s ease;
}

.editorial-card:hover .editorial-image{
    transform:scale(1.05);
}

.editorial-title{
    position:absolute;
    bottom:20px;
    left:50%;
    transform:translateX(-50%);
    width:100%;
    text-align:center;

    color:#fff;
    font-size:11px;
    font-weight:500;
    letter-spacing:1.5px;
    text-transform:uppercase;
}

/* Tablet */

@media (max-width:990px){

.editorial-grid{
    grid-template-columns:repeat(2,1fr);
}

.editorial-card{
    aspect-ratio:3/5;
}

}

/* Mobile */

@media (max-width:749px){

.editorial-grid{
    grid-template-columns:repeat(2,1fr);
}

.editorial-card{
    aspect-ratio:3/5;
}

.editorial-title{
    font-size:10px;
    bottom:12px;
}

}
</style>


{% schema %}
{
  "name": "Editorial Grid",
  "max_blocks": 8,
  "blocks": [
    {
      "type": "item",
      "name": "Card",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "BIKINIS TOP TRIÁNGULO"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Editorial Grid",
      "blocks": [
        {
          "type": "item"
        },
        {
          "type": "item"
        },
        {
          "type": "item"
        },
        {
          "type": "item"
        }
      ]
    }
  ]
}
{% endschema %}