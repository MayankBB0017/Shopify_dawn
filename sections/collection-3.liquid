<div class="editorial-grid-4">

  {% for block in section.blocks %}
    <div class="editorial-grid-4__card">

      {% if block.settings.image != blank %}
        {{
          block.settings.image
          | image_url: width: 1200
          | image_tag:
          loading: 'lazy',
          class: 'editorial-grid-4__image'
        }}
      {% endif %}

      <div class="editorial-grid-4__title">
        {{ block.settings.title }}
      </div>

    </div>
  {% endfor %}

</div>
<style>
    .editorial-grid-4{
    display:grid;
    grid-template-columns:repeat(4,1fr);
    gap:18px;
    width:100%;
}

.editorial-grid-4__card{
    position:relative;
    overflow:hidden;
    aspect-ratio:3/5;
    background:#f5f5f5;
}

.editorial-grid-4__image{
    width:100%;
    height:100%;
    object-fit:cover;
    display:block;
    transition:transform .4s ease;
}

.editorial-grid-4__card:hover .editorial-grid-4__image{
    transform:scale(1.05);
}

.editorial-grid-4__title{
    position:absolute;
    bottom:20px;
    left:50%;
    transform:translateX(-50%);
    width:100%;
    text-align:center;
    color:#fff;
    font-size:11px;
    font-weight:500;
    letter-spacing:1.5px;
    text-transform:uppercase;
}

/* Tablet */

@media (max-width:990px){

.editorial-grid-4{
    grid-template-columns:repeat(2,1fr);
}

.editorial-grid-4__card{
    aspect-ratio:3/5;
}

}

/* Mobile */

/* Mobile */

@media (max-width:749px){

.editorial-grid-4{
    display:flex;
    overflow-x:auto;
    overflow-y:hidden;
    gap:8px;

    scroll-snap-type:x mandatory;
    -webkit-overflow-scrolling:touch;

    scrollbar-width:none;
    padding:0 12px;
}

.editorial-grid-4::-webkit-scrollbar{
    display:none;
}

.editorial-grid-4__card{
    flex:0 0 82%;
    aspect-ratio:3/5;
    scroll-snap-align:center;
}

.editorial-grid-4__image{
    width:100%;
    height:100%;
    object-fit:cover;
}

.editorial-grid-4__title{
    bottom:18px;
    left:50%;
    transform:translateX(-50%);
    width:100%;
    text-align:center;
    font-size:11px;
    letter-spacing:1px;
}

}
</style>


{% schema %}
{
  "name": "Editorial Grid",
  "max_blocks": 8,
  "blocks": [
    {
      "type": "item",
      "name": "Card",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "BIKINIS TOP TRIÁNGULO"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Editorial Grid",
      "blocks": [
        {
          "type": "item"
        },
        {
          "type": "item"
        },
        {
          "type": "item"
        },
        {
          "type": "item"
        }
      ]
    }
  ]
}
{% endschema %}