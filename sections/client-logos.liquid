<div class="logo-marquee {% unless section.settings.enable_animation %}no-animation{% endunless %}">
  <div
    class="logo-track"
    style="--speed: {{ section.settings.animation_speed }}s;"
  >
    {% for i in (1..2) %}
      {% for block in section.blocks %}
        {% if block.settings.image != blank %}
          <div class="logo-item" {{ block.shopify_attributes }}>
            {% if block.settings.link != blank %}
              <a href="{{ block.settings.link }}">
            {% endif %}

           {{
              block.settings.image
              | image_url: width: 384
              | image_tag: widths: '192,384'
            }}

            {% if block.settings.link != blank %}
              </a>
            {% endif %}
          </div>
        {% endif %}
      {% endfor %}
    {% endfor %}
  </div>
</div>

<style>
      .logo-marquee {
    overflow: hidden;
    width: 100%;
    position: relative;
  }

  .logo-track {
    display: flex;
    align-items: center;
    gap: 70px;
    width: max-content;
    animation: marquee var(--speed) linear infinite;
  }

  .logo-marquee:hover .logo-track {
    animation-play-state: paused;
  }

  .no-animation .logo-track {
    animation: none;
  }

  .logo-item {
    flex: 0 0 auto;
  }

  .logo-item img {
    display: block;
    max-width: 100%;
    height: auto;
    object-fit: contain;
  }

  @keyframes marquee {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(-50%);
    }
  }

  /* Responsive */

  @media (max-width: 991px) {
    .logo-track {
      gap: 50px;
    }
  }

  @media (max-width: 767px) {
    .logo-track {
      gap: 35px;
    }

    .logo-item img {
      max-height: 30px;
    }
  }

  @media (max-width: 480px) {
    .logo-track {
      gap: 24px;
    }

    .logo-item img {
      max-height: 24px;
    }
  }
</style>

{% schema %}
    {
  "name": "Logo Marquee",
  "settings": [
    {
      "type": "checkbox",
      "id": "enable_animation",
      "label": "Enable Animation",
      "default": true
    },
    {
      "type": "range",
      "id": "animation_speed",
      "label": "Animation Speed (seconds)",
      "min": 10,
      "max": 80,
      "step": 2,
      "default": 30
    }
  ],
  "blocks": [
    {
      "type": "logo",
      "name": "Logo",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Logo Image"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Logo Link"
        },
        {
          "type": "range",
          "id": "width",
          "label": "Logo Width",
          "min": 60,
          "max": 220,
          "step": 10,
          "default": 120,
          "unit": "px"
        }
      ]
    }
  ],
  "max_blocks": 20,
  "presets": [
    {
      "name": "Logo Marquee"
    }
  ]
}
{% endschema %}
