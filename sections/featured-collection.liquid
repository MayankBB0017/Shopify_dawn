{{ 'component-card.css' | asset_url | stylesheet_tag }}
{{ 'component-price.css' | asset_url | stylesheet_tag }}

{{ 'component-slider.css' | asset_url | stylesheet_tag }}
{{ 'template-collection.css' | asset_url | stylesheet_tag }}

{% if section.settings.image_shape == 'blob' %}
  {{ 'mask-blobs.css' | asset_url | stylesheet_tag }}
{%- endif -%}

{%- unless section.settings.quick_add == 'none' -%}
  {{ 'quick-add.css' | asset_url | stylesheet_tag }}
  <script src="{{ 'product-form.js' | asset_url }}" defer="defer"></script>
{%- endunless -%}

{%- if section.settings.quick_add == 'standard' -%}
  <script src="{{ 'quick-add.js' | asset_url }}" defer="defer"></script>
{%- endif -%}

{%- if section.settings.quick_add == 'bulk' -%}
  <script src="{{ 'quick-add-bulk.js' | asset_url }}" defer="defer"></script>
  <script src="{{ 'quantity-popover.js' | asset_url }}" defer="defer"></script>
  <script src="{{ 'price-per-item.js' | asset_url }}" defer="defer"></script>
  <script src="{{ 'quick-order-list.js' | asset_url }}" defer="defer"></script>
{%- endif -%}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

    /* ADD — Tab buttons */
  .fct-tabs-{{ section.id }} {
    display: flex;
    align-items: center;
    list-style: none;
    margin: 0;
    padding: 0;
    flex-wrap: wrap;
  }

  .fct-tab-btn-{{ section.id }} {
    background: none;
    border: none;
    cursor: pointer;
    font-family: inherit;
    font-size: 1.3rem;
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: rgba(var(--color-foreground), 0.45);
    padding: 0.6rem 1.6rem;
    position: relative;
    transition: color 0.2s ease;
    white-space: nowrap;
  }

  .fct-tab-btn-{{ section.id }}:first-child { padding-left: 0; }

  .fct-tab-btn-{{ section.id }}:hover {
    color: rgb(var(--color-foreground));
  }

  .fct-tab-btn-{{ section.id }}[aria-selected="true"] {
    color: rgb(var(--color-foreground));
    font-weight: 600;
  }

  .fct-tab-btn-{{ section.id }}[aria-selected="true"]::after {
    content: '';
    position: absolute;
    bottom: -2px;
    left: 0;
    right: 0;
    height: 2px;
    background: rgb(var(--color-foreground));
    border-radius: 2px;
  }

  /* ADD — Tab panels */
  .fct-panel-{{ section.id }} { display: none; }
  .fct-panel-{{ section.id }}.is-active { display: block; }

  /* ADD — Empty state */
  .fct-empty-{{ section.id }} {
    padding: 4rem 0;
    text-align: center;
    color: rgba(var(--color-foreground), 0.5);
    font-size: 1.4rem;
  }

  fct-header-{{ section.id }} {
    display:flex;
    
  }
{%- endstyle -%}



{%- liquid
  assign products_to_show = section.settings.products_to_show
  assign columns_desktop = section.settings.columns_desktop
  assign columns_mobile_int = section.settings.columns_mobile | plus: 0
-%}

<div class="color-{{ section.settings.color_scheme }} isolate gradient">
  <div class="collection section-{{ section.id }}-padding" id="fct-section-{{ section.id }}">
    <div class="page-width">

      <!-- HEADING + TAB BUTTONS in one flex row -->
      <div class="fct-header-{{ section.id }}">

        {%- if section.settings.title != blank -%}
          <h2 class="title {{ section.settings.heading_size }}">
            {{ section.settings.title }}
          </h2>
        {%- endif -%}

        <ul class="fct-tabs-{{ section.id }}" role="tablist">
          {%- for block in section.blocks -%}
            {%- liquid
              assign tab_label = block.settings.tab_title
              if tab_label == blank
                assign tab_label = block.settings.collection.title
              endif
              if tab_label == blank
                assign tab_label = 'Tab ' | append: forloop.index
              endif
            -%}
            <li role="presentation">
              <button
                class="fct-tab-btn-{{ section.id }}"
                role="tab"
                id="fct-tab-{{ section.id }}-{{ forloop.index }}"
                aria-controls="fct-panel-{{ section.id }}-{{ forloop.index }}"
                aria-selected="{% if forloop.first %}true{% else %}false{% endif %}"
                data-tab-index="{{ forloop.index }}"
                {{ block.shopify_attributes }}
              >
                {{ tab_label }}
              </button>
            </li>
          {%- endfor -%}
        </ul>

      </div>
      <!-- END HEADING + TABS -->

      <!-- TAB PANELS — one per block -->
      {%- for block in section.blocks -%}
        {%- liquid
          assign bc = block.settings.collection

          assign products_to_display = bc.all_products_count
          assign more_in_collection = false
          if bc.all_products_count > products_to_show
            assign products_to_display = products_to_show
            assign more_in_collection = true
          endif

          assign show_desktop_slider = false
          if section.settings.enable_desktop_slider and products_to_display > columns_desktop
            assign show_desktop_slider = true
          endif

          assign show_mobile_slider = false
          if section.settings.swipe_on_mobile and products_to_display > columns_mobile_int
            assign show_mobile_slider = true
          endif

          assign max_columns_to_show = columns_mobile_int
          if columns_desktop > columns_mobile_int
            assign max_columns_to_show = columns_desktop
          endif
        -%}

        <div
          id="fct-panel-{{ section.id }}-{{ forloop.index }}"
          class="fct-panel-{{ section.id }}{% if forloop.first %} is-active{% endif %}"
          role="tabpanel"
          aria-labelledby="fct-tab-{{ section.id }}-{{ forloop.index }}"
        >

          {%- if bc.products.size > 0 -%}

            <!-- KEEP slider-component structure — same as original -->
            <slider-component class="slider-mobile-gutter{% if show_mobile_slider == false %} page-width{% endif %}{% if show_desktop_slider == false and section.settings.full_width == false %} page-width-desktop{% endif %}{% if show_desktop_slider %} slider-component-desktop{% endif %}">

              <ul
                id="Slider-{{ section.id }}-{{ forloop.index }}"
                class="grid product-grid contains-card contains-card--product{% if settings.card_style == 'standard' %} contains-card--standard{% endif %} grid--{{ columns_desktop }}-col-desktop grid--{{ section.settings.columns_mobile }}-col-tablet-down{% if show_mobile_slider or show_desktop_slider %} slider{% if show_desktop_slider %} slider--desktop{% endif %}{% if show_mobile_slider %} slider--tablet grid--peek{% endif %}{% endif %}"
                role="list"
              >
                {%- assign skip_card_product_styles = false -%}
                {%- assign lazy_load = false -%}

                {%- for product in bc.products limit: products_to_show -%}
                  {%- if forloop.index > max_columns_to_show -%}
                    {%- assign lazy_load = true -%}
                  {%- endif -%}
                  <li
                    id="Slide-{{ section.id }}-{{ forloop.parentloop.index }}-{{ forloop.index }}"
                    class="grid__item{% if show_mobile_slider or show_desktop_slider %} slider__slide{% endif %}{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
                    {% if settings.animations_reveal_on_scroll %}
                      data-cascade
                      style="--animation-order: {{ forloop.index }};"
                    {% endif %}
                  >
                    <!-- KEEP card-product render — identical to original -->
                    {% render 'card-product',
                      card_product: product,
                      media_aspect_ratio: section.settings.image_ratio,
                      image_shape: section.settings.image_shape,
                      lazy_load: lazy_load,
                      show_secondary_image: section.settings.show_secondary_image,
                      show_vendor: section.settings.show_vendor,
                      show_rating: section.settings.show_rating,
                      skip_styles: skip_card_product_styles,
                      section_id: section.id,
                      quick_add: section.settings.quick_add
                    %}
                  </li>
                  {%- assign skip_card_product_styles = true -%}
                {%- endfor -%}

              </ul>

              <!-- KEEP slider buttons — identical to original -->
              {%- if show_mobile_slider or show_desktop_slider -%}
                <div class="slider-buttons">
                  <button type="button" class="slider-button slider-button--prev" name="previous"
                    aria-label="{{ 'general.slider.previous_slide' | t }}"
                    aria-controls="Slider-{{ section.id }}-{{ forloop.index }}">
                    <span class="svg-wrapper">{{- 'icon-caret.svg' | inline_asset_content -}}</span>
                  </button>
                  <div class="slider-counter caption">
                    <span class="slider-counter--current">1</span>
                    <span aria-hidden="true"> / </span>
                    <span class="visually-hidden">{{ 'general.slider.of' | t }}</span>
                    <span class="slider-counter--total">{{ products_to_display }}</span>
                  </div>
                  <button type="button" class="slider-button slider-button--next" name="next"
                    aria-label="{{ 'general.slider.next_slide' | t }}"
                    aria-controls="Slider-{{ section.id }}-{{ forloop.index }}">
                    <span class="svg-wrapper">{{- 'icon-caret.svg' | inline_asset_content -}}</span>
                  </button>
                </div>
              {%- endif -%}

            </slider-component>

            {%- if section.settings.show_view_all and more_in_collection -%}
              <div class="center collection__view-all" style="margin-top:2.4rem;">
                <a href="{{ bc.url }}"
                  class="{% if section.settings.view_all_style == 'link' %}link underlined-link{% elsif section.settings.view_all_style == 'solid' %}button{% else %}button button--secondary{% endif %}"
                  aria-label="{{ 'sections.featured_collection.view_all_label' | t: collection_name: bc.title | escape }}">
                  {{ 'sections.featured_collection.view_all' | t }}
                </a>
              </div>
            {%- endif -%}

          {%- else -%}
            <p class="fct-empty-{{ section.id }}">
              {%- if bc == blank -%}No collection selected.{%- else -%}No products in {{ bc.title }}.{%- endif -%}
            </p>
          {%- endif -%}

        </div>
        <!-- END panel -->

        <!-- KEEP arch mask — same as original -->
        {%- if section.settings.image_shape == 'arch' -%}
          {{ 'mask-arch.svg' | inline_asset_content }}
        {%- endif -%}

      {%- endfor -%}

    </div>
  </div>
</div>


<script>
(function () {
  var sid = {{ section.id | json }};
  var root = document.getElementById('fct-section-' + sid);
  if (!root) return;

  var btns   = root.querySelectorAll('.fct-tab-btn-' + sid);
  var panels = root.querySelectorAll('.fct-panel-' + sid);

  function activate(index) {
    btns.forEach(function(b) {
      b.setAttribute('aria-selected', b.dataset.tabIndex == index ? 'true' : 'false');
    });
    panels.forEach(function(p) { p.classList.remove('is-active'); });
    var panel = root.querySelector('#fct-panel-' + sid + '-' + index);
    if (panel) {
      panel.classList.add('is-active');
      window.dispatchEvent(new Event('resize')); // re-init Dawn slider
    }
  }

  btns.forEach(function(btn) {
    btn.addEventListener('click', function() { activate(btn.dataset.tabIndex); });
    btn.addEventListener('keydown', function(e) {
      var i = parseInt(btn.dataset.tabIndex, 10);
      if (e.key === 'ArrowRight') { var n = root.querySelector('[data-tab-index="'+(i+1)+'"]'); if(n){n.focus();activate(i+1);} }
      if (e.key === 'ArrowLeft')  { var p = root.querySelector('[data-tab-index="'+(i-1)+'"]'); if(p){p.focus();activate(i-1);} }
    });
  });
})();
</script>

